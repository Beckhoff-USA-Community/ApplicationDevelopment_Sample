<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="SyncedSquareWaves" Id="{35f66174-c5b3-49ca-9765-0f46a12be9be}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK SyncedSquareWaves EXTENDS CyclicComponent IMPLEMENTS I_Initializable
VAR
	_Initialized  : BOOL;
	PLC_CycleTime : UDINT;
	CycleTime_ms  : LREAL;

	//
	{attribute 'hide'}
	_Wave_500Hz : BOOL;
	{attribute 'hide'}
	_Wave_100Hz : BOOL;
	{attribute 'hide'}
	_Wave_50Hz : BOOL;
	{attribute 'hide'}
	_Wave_5Hz : BOOL;
	{attribute 'hide'}
	_Wave_2Hz : BOOL;
	{attribute 'hide'}
	_Wave_1Hz : BOOL;
	{attribute 'hide'}
	_Wave_0_5Hz : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Initializable" Id="{d2affa53-c5ae-459e-a173-712d2ffbc097}" />
    <Method Name="CyclicLogic" Id="{5e3838da-f4d8-4716-ac0d-b7b9f9f0dadb}">
      <Declaration><![CDATA[//! @summary This method serves as the entry point for all underlying FB logic
METHOD PUBLIC CyclicLogic
VAR
	Counter		   : LREAL;
	CountsRequired : LREAL;
	CycleCount	   : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _Initialized THEN
	Initialize();
	RETURN;
END_IF

CycleCount := TwinCAT_SystemInfoVarList._TaskInfo[GETCURTASKINDEXEX()].CycleCount;
IF (CycleTime_ms <= 1) AND (FRAC(1 / CycleTime_ms) = 0) THEN
	CountsRequired := 1 / CycleTime_ms;
	Counter		   := LMOD(CycleCount, CountsRequired);
	IF (Counter + 1) = CountsRequired THEN
		_Wave_500Hz := NOT _Wave_500Hz;
	END_IF
END_IF

IF (CycleTime_ms <= 5) AND (FRAC(5 / CycleTime_ms) = 0) THEN
	CountsRequired := 5 / CycleTime_ms;
	Counter		   := LMOD(CycleCount, CountsRequired);
	IF (Counter + 1) = CountsRequired THEN
		_Wave_100Hz := NOT _Wave_100Hz;
	END_IF
END_IF

IF (CycleTime_ms <= 10) AND (FRAC(10 / CycleTime_ms) = 0) THEN
	CountsRequired := 10 / CycleTime_ms;
	Counter		   := LMOD(CycleCount, CountsRequired);
	IF (Counter + 1) = CountsRequired THEN
		_Wave_50Hz := NOT _Wave_50Hz;
	END_IF
END_IF

IF (CycleTime_ms <= 100) AND (FRAC(100 / CycleTime_ms) = 0) THEN
	CountsRequired := 100 / CycleTime_ms;
	Counter		   := LMOD(CycleCount, CountsRequired);
	IF (Counter + 1) = CountsRequired THEN
		_Wave_5Hz := NOT _Wave_5Hz;
	END_IF
END_IF

IF (CycleTime_ms <= 250) AND (FRAC(250 / CycleTime_ms) = 0) THEN
	CountsRequired := 250 / CycleTime_ms;
	Counter		   := LMOD(CycleCount, CountsRequired);
	IF (Counter + 1) = CountsRequired THEN
		_Wave_2Hz := NOT _Wave_2Hz;
	END_IF
END_IF

IF (CycleTime_ms <= 500) AND (FRAC(500 / CycleTime_ms) = 0) THEN
	CountsRequired := 500 / CycleTime_ms;
	Counter		   := LMOD(CycleCount, CountsRequired);
	IF (Counter + 1) = CountsRequired THEN
		_Wave_1Hz := NOT _Wave_1Hz;
	END_IF
END_IF

IF (CycleTime_ms <= 1000) AND (FRAC(1000 / CycleTime_ms) = 0) THEN
	CountsRequired := 1000 / CycleTime_ms;
	Counter		   := LMOD(CycleCount, CountsRequired);
	IF (Counter + 1) = CountsRequired THEN
		_Wave_0_5Hz := NOT _Wave_0_5Hz;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initialize" Id="{b0d4565e-7f87-4a88-8840-de4c795a7bf2}" FolderPath="Initializable\">
      <Declaration><![CDATA[METHOD Initialize]]></Declaration>
      <Implementation>
        <ST><![CDATA[//PLC Scan Info
PLC_CycleTime := TwinCAT_SystemInfoVarList._TaskInfo[GETCURTASKINDEXEX()].CycleTime;
CycleTime_ms  := TO_LREAL(PLC_CycleTime) / 10000.0;

//
_Wave_500Hz	 := TRUE;
_Wave_100Hz	 := TRUE;
_Wave_50Hz	 := TRUE;
_Wave_5Hz	 := TRUE;
_Wave_2Hz	 := TRUE;
_Wave_1Hz	 := TRUE;
_Wave_0_5Hz	 := TRUE;
_Initialized := TRUE;]]></ST>
      </Implementation>
    </Method>
