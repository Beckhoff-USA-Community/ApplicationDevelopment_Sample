    <Method Name="IsHotConnectMember" Id="{1346fea0-0c2c-405a-915d-3220ee7700b6}" FolderPath="Diagnostic\">
      <Declaration><![CDATA[// I_EcSlaveRegistry: TRUE if the configured slave at Index belongs to a hot connect group
// (topology status bits 4 or 5, read once in Initialize). FALSE if Index is out of range.
METHOD IsHotConnectMember : BOOL
VAR_INPUT
	Index : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Index < SlaveCountUsed THEN
	IsHotConnectMember := SlaveTopologyInfo[Index].nStatusBits.4 OR SlaveTopologyInfo[Index].nStatusBits.5;
END_IF]]></ST>
      </Implementation>
    </Method>
