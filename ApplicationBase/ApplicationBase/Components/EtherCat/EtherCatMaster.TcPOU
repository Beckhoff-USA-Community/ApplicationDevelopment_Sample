        </Implementation>
      </Get>
    </Property>
    <Method Name="LookupMasterState" Id="{77909b3a-0ac2-4bf6-a988-7eb95f542820}" FolderPath="_Internal\">
      <Declaration><![CDATA[METHOD PROTECTED LookupMasterState : STRING
VAR_INPUT
	State : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF State.0 THEN
	LookupMasterState := 'Link error';
ELSIF State.1 THEN
	LookupMasterState := 'I/O locked after link error (I/O reset required)';
ELSIF State.2 THEN
	LookupMasterState := 'Link error (redundancy adapter)';
ELSIF State.3 THEN
	LookupMasterState := 'Missing one frame (redundancy mode)';
ELSIF State.4 THEN
	LookupMasterState := 'Out of send resources (I/O reset required)';
ELSIF State.5 THEN
	LookupMasterState := 'Watchdog triggered';
ELSIF State.6 THEN
	LookupMasterState := 'Ethernet driver (miniport) NOT found';
ELSIF State.7 THEN
	LookupMasterState := 'I/O reset active';
ELSIF State.8 THEN
	LookupMasterState := 'At least one device in INIT state';
ELSIF State.9 THEN
	LookupMasterState := 'At least one device in PRE-OP state';
ELSIF State.10 THEN
	LookupMasterState := 'At least one device in SAFE-OP state';
ELSIF State.11 THEN
	LookupMasterState := 'At least one device indicates an error state';
ELSIF State.12 THEN
	LookupMasterState := 'DC not in sync';
ELSE
	LookupMasterState := 'State not found';
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="LookupSlaveState" Id="{2b979181-e45f-4339-bf02-a4112dadec98}" FolderPath="_Internal\">
      <Declaration><![CDATA[METHOD PROTECTED LookupSlaveState : STRING
VAR_INPUT
	Slave : UINT;
END_VAR

VAR_INST
	DiagByte	: BYTE;
	BitMaskDiag : BYTE := 16#0F;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* State *)
BitMaskDiag := 16#0F;
DiagByte	:= SlavesState[Slave].deviceState AND BitMaskDiag;
CASE DiagByte OF
	EC_DEVICE_STATE_INIT:
		LookupSlaveState := 'Init';

	EC_DEVICE_STATE_PREOP:
		LookupSlaveState := 'Pre-op';

	EC_DEVICE_STATE_BOOTSTRAP:
		LookupSlaveState := 'Boot';

	EC_DEVICE_STATE_SAFEOP:
		LookupSlaveState := 'Safe-op';

	EC_DEVICE_STATE_OP:
		LookupSlaveState := 'OP';

ELSE
	LookupSlaveState := '';
END_CASE

(* Additional State Bits *)
IF SlavesState[Slave].deviceState.4 THEN // EC_DEVICE_STATE_ERROR
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'State machine error in the EtherCAT slave');
END_IF

IF SlavesState[Slave].deviceState.5 THEN // EC_DEVICE_STATE_INVALID_VPRS
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'Invalid vendor ID');
END_IF

IF SlavesState[Slave].deviceState.6 THEN // EC_DEVICE_STATE_INITCMD_ERROR
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'Error during sending of initialization commands');
END_IF

IF SlavesState[Slave].deviceState.7 THEN // EC_DEVICE_STATE_DISABLED
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'Slave is disabled');
END_IF

//_____________________________________________________________________________________________________

(* Link States *)
IF SlavesState[Slave].linkState.0 THEN // EC_LINK_STATE_NOT_PRESENT
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'No EtherCAT communication with the EtherCAT slave');
END_IF

IF SlavesState[Slave].linkState.1 THEN // EC_LINK_STATE_LINK_WITHOUT_COMM
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'Error AT port X');
END_IF

IF SlavesState[Slave].linkState.2 THEN // EC_LINK_STATE_MISSING_LINK
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'Missing link AT port X');
END_IF

IF SlavesState[Slave].linkState.3 THEN // EC_LINK_STATE_ADDITIONAL_LINK
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'Additional link AT port X');
END_IF

(* Additional State Bits *)
IF SlavesState[Slave].linkState.4 THEN // EC_LINK_STATE_PORT_A
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'Port 0');
END_IF

IF SlavesState[Slave].linkState.5 THEN // EC_LINK_STATE_PORT_B
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'Port 1');
END_IF

IF SlavesState[Slave].linkState.6 THEN // EC_LINK_STATE_PORT_C
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'Port 2');
END_IF

IF SlavesState[Slave].linkState.7 THEN // EC_LINK_STATE_PORT_D
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'Port 3');
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="MapSlaveAddress" Id="{375c31cd-934d-4614-b398-2e47ba3ae9b0}" FolderPath="_Internal\">
      <Declaration><![CDATA[// Enters the configured slave Index into the address map if its address lies in the dense range.
METHOD PROTECTED MapSlaveAddress
VAR_INPUT
	Index : UINT;
END_VAR

VAR
	Addr : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Addr := ConfiguredSlaveInfo[Index].nAddr;
IF (Addr >= FIRST_SLAVE_ADDR) AND_THEN ((Addr - FIRST_SLAVE_ADDR) <= MAX_EC_SLAVES) THEN
	AddrToIndex[Addr - FIRST_SLAVE_ADDR] := Index + 1;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="MasterAmsNetId" Id="{e8191ac3-4bf6-4260-9bd6-73f87a18d477}" FolderPath="Diagnostic\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY MasterAmsNetId : T_AmsNetId]]></Declaration>
      <Get Name="Get" Id="{cd0137ef-9d12-42f0-957e-c261bf7bfde0}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[MasterAmsNetId := _MasterAmsNetId;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="MasterState" Id="{9cab473b-cce9-4d54-aadc-9cb8f27d7c22}" FolderPath="_Internal\">
      <Declaration><![CDATA[// Raises one MasterError event per DevState change while slaves are missing. TRUE when an error was latched.
METHOD PROTECTED MasterState : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF LastMasterState = EcMaster.DevState THEN
	RETURN;
END_IF

LastMasterState := EcMaster.DevState;

IF (EcMaster.DevState <> 0) AND (EcMaster.SlaveCount < EcMaster.CfgSlaveCount) THEN
	IF EventProvider <> 0 THEN
		EventProvider.RaiseEtherCatDiagnosticEvent(E_EtherCatMaster.MasterError, LookupMasterState(EcMaster.DevState));
	END_IF

	SetError(E_EcErrorSource.Master, EcMaster.DevState);
	MasterState := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Register" Id="{af1bba30-9816-4532-9ef4-ab7b63e9c3b6}" FolderPath="CoE\">
      <Declaration><![CDATA[// I_CoeTransferScheduler: adds a CoE transfer to the set serviced by CyclicLogic (idempotent).
METHOD Register : BOOL
VAR_INPUT
	Transfer : I_CoeTransfer;
END_VAR

VAR
	i : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Transfer = 0 THEN
	RETURN;
END_IF

i := 0;
WHILE i < ActiveCoeCount DO
	IF ActiveCoe[i] = Transfer THEN
		Register := TRUE;
		RETURN;
	END_IF
	i := i + 1;
END_WHILE

IF ActiveCoeCount > MAX_EC_SLAVES THEN
	RETURN; // full
END_IF

ActiveCoe[ActiveCoeCount] := Transfer;
ActiveCoeCount			  := ActiveCoeCount + 1;
Register				  := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RegisterEventProvider" Id="{3c83d169-3fdc-4962-9915-fa3129e33709}" FolderPath="Diagnostic\">
      <Declaration><![CDATA[METHOD RegisterEventProvider
VAR_INPUT
	EventProvider : I_EtherCatDiagnosticEventProvider;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.EventProvider := EventProvider;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{ee94ff59-f1a9-498f-aa45-98618a0c1c63}" FolderPath="Resettable\">
      <Declaration><![CDATA[METHOD Reset]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF EventProvider <> 0 THEN
	EventProvider.Reset();
END_IF

LastMasterState				  := 0;
LastChangeCount				  := 0;
LastSlaveCount				  := 0;
LastFramesWcStatesOk		  := FALSE;
_Error						  := FALSE;
_ErrorId					  := 0;
_ErrorSource				  := E_EcErrorSource.None;
SlaveSequence				  := 0;
RunSlaveDiag				  := FALSE;
GetAllSlaveStates.bExecute	  := FALSE;
GetSlaveTopologyInfo.bExecute := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ServiceCoeTransfers" Id="{05356306-57eb-4767-8dbb-3b6da6cd102b}" FolderPath="CoE\">
      <Declaration><![CDATA[// Calls CyclicLogic of every registered CoE transfer and drops the ones that finished.
METHOD PRIVATE ServiceCoeTransfers
VAR
	i : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[i := 0;
WHILE i < ActiveCoeCount DO
	ActiveCoe[i].CyclicLogic();
	IF ActiveCoe[i].Busy THEN
		i := i + 1;
	ELSE
		(* finished: move the last entry into the gap and service it in this cycle as well *)
		ActiveCoeCount			  := ActiveCoeCount - 1;
		ActiveCoe[i]			  := ActiveCoe[ActiveCoeCount];
		ActiveCoe[ActiveCoeCount] := 0;
	END_IF
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetError" Id="{54454f9e-58e9-4682-b57f-abdd8c767e72}" FolderPath="_Internal\">
      <Declaration><![CDATA[METHOD PROTECTED SetError
VAR_INPUT
	Source	: E_EcErrorSource;
	ErrorId : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Error		 := TRUE;
_ErrorSource := Source;
_ErrorId	 := ErrorId;]]></ST>
      </Implementation>
    </Method>
