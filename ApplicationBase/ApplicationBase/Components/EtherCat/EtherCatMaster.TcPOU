      </Get>
    </Property>
    <Method Name="FB_Init" Id="{b13f5ee7-b35d-4d18-9795-7f71c11f59d6}">
      <Declaration><![CDATA[(*FB_Init is always available implicitly and it is used primarily for initialization.
The return value is not evaluated. For a specific influence, you can also declare the
methods explicitly and provide additional code there with the standard initialization
code. You can evaluate the return value.*)
METHOD FB_Init : BOOL
VAR_INPUT
	(* TRUE: the retain variables are initialized (reset warm / reset cold)*)
	bInitRetains : BOOL;

	(* TRUE: the instance will be copied to the copy code afterward (online change)   *)
	bInCopyCode		: BOOL;
	Name			: T_MaxString;
	EcStartupCycles : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.EcStartupCycles := EcStartupCycles;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FramesWcStatesOk" Id="{d8515602-a931-0646-062f-139b29a44aad}" FolderPath="_Internal\">
      <Declaration><![CDATA[METHOD PROTECTED FramesWcStatesOk : BOOL
VAR
	i : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FramesWcStatesOk := TRUE;
FOR i := 0 TO (GetMasterFrameCount.nFrames - 1) DO
	IF FrmXWcState[i] <> 0 THEN
		FramesWcStatesOk := FALSE;
		EXIT;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetIoDeviceByAddr" Id="{8fec52b1-8c69-4759-b15f-16e0bfdd0031}" FolderPath="Diagnostic\">
      <Declaration><![CDATA[METHOD GetIoDeviceByAddr : I_EcIoDevice
VAR_INPUT
	Addr : WORD;
END_VAR

VAR
	i : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Initialized THEN
	GetIoDeviceByAddr := NullIoDevice;
	RETURN;
END_IF

FOR i := 0 TO (EcMaster.CfgSlaveCount - 1) DO
	IF IoDevice[i].Configuration.nAddr = Addr THEN
		GetIoDeviceByAddr := IoDevice[i];
		RETURN;
	END_IF
END_FOR

GetIoDeviceByAddr := NullIoDevice;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetIoDeviceByName" Id="{13f2fd00-8fca-4d64-97a3-0bb868e7b598}" FolderPath="Diagnostic\">
      <Declaration><![CDATA[METHOD GetIoDeviceByName : I_EcIoDevice
VAR_INPUT
	Name : STRING(31);
END_VAR

VAR
	i : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Initialized THEN
	GetIoDeviceByName := NullIoDevice;
	RETURN;
END_IF

FOR i := 0 TO (EcMaster.CfgSlaveCount - 1) DO
	IF IoDevice[i].Name = Name THEN
		GetIoDeviceByName := IoDevice[i];
		RETURN;
	END_IF
END_FOR

GetIoDeviceByName := NullIoDevice;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initialize" Id="{59fc31be-2fef-4308-9217-c3cfb6c18f0b}" FolderPath="Initialize\">
      <Declaration><![CDATA[METHOD Initialize
VAR_INST
	InitSequenceState : UDINT;
	GetLocalAmsNetId  : FB_GetLocalAmsNetId;
	StartCycles		  : UINT;
END_VAR

VAR
	i : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _Error AND NOT (F_GetMappingStatus(ADR(EcMaster.AmsNetID), SIZEOF(EcMaster.AmsNetID)) <> EplcMappingStatus.MS_Unmapped) AND NOT Simulated THEN
	_Error := TRUE;
	Trace.LogMessage(Name, 'Init Failed - AmsNetID mapped to Master!');
END_IF

IF NOT _Error AND NOT (F_GetMappingStatus(ADR(EcMaster.DevID), SIZEOF(EcMaster.DevID)) <> EplcMappingStatus.MS_Unmapped) AND NOT Simulated THEN
	_Error := TRUE;
	Trace.LogMessage(Name, 'Init Failed - DevID mapped to Master!');
END_IF

IF NOT _Error AND NOT (F_GetMappingStatus(ADR(EcMaster.DevState), SIZEOF(EcMaster.DevState)) <> EplcMappingStatus.MS_Unmapped) AND NOT Simulated THEN
	_Error := TRUE;
	Trace.LogMessage(Name, 'Init Failed - DevState mapped to Master!');
END_IF

IF NOT _Error AND NOT (F_GetMappingStatus(ADR(EcMaster.ChangeCount), SIZEOF(EcMaster.ChangeCount)) <> EplcMappingStatus.MS_Unmapped) AND NOT Simulated THEN
	_Error := TRUE;
	Trace.LogMessage(Name, 'Init Failed - ChangeCount mapped to Master!');
END_IF

IF NOT _Error AND NOT (F_GetMappingStatus(ADR(EcMaster.SlaveCount), SIZEOF(EcMaster.SlaveCount)) <> EplcMappingStatus.MS_Unmapped) AND NOT Simulated THEN
	_Error := TRUE;
	Trace.LogMessage(Name, 'Init Failed - CfgSlaveCount mapped to Master!');
END_IF

IF NOT _Error AND NOT (F_GetMappingStatus(ADR(EcMaster.CfgSlaveCount), SIZEOF(EcMaster.CfgSlaveCount)) <> EplcMappingStatus.MS_Unmapped) AND NOT Simulated THEN
	_Error := TRUE;
	Trace.LogMessage(Name, 'Init Failed - CfgSlaveCount mapped to Master!');
END_IF

IF _Error THEN
	RETURN;
END_IF

IF Simulated THEN
	FOR i := 0 TO (SYNC_UNITS - 1) DO
		SyncUnit[i].EventProvider := EventProvider;
		SyncUnit[i].Simulated	  := Simulated;
		SyncUnit[i].Initialize();
		IF NOT SyncUnit[i].Initialized THEN
			RETURN;
		END_IF
	END_FOR

	_Initialized := TRUE;
	RETURN;
END_IF

GetLocalAmsNetId(tTimeOut := T#1S);
_MasterAmsNetId := F_CreateAmsNetId(EcMaster.AmsNetID);
GetMasterFrameCount(sNetId := _MasterAmsNetId, tTimeout := T#1S);
GetConfiguredSlaves(sNetId				:= _MasterAmsNetId,
					pArrEcConfSlaveInfo := ADR(ConfiguredSlaveInfo),
					cbBufLen			:= SIZEOF(ConfiguredSlaveInfo),
					tTimeout			:= T#1S);

CASE InitSequenceState OF
	0:
		GetLocalAmsNetId.bExecute := TRUE;
		IF GetLocalAmsNetId.bBusy THEN
			NextMinorStep(InitSequenceState);
		END_IF

	1:
		IF NOT GetLocalAmsNetId.bBusy AND NOT GetLocalAmsNetId.bError THEN
			_LocalAmsNetId := GetLocalAmsNetId.AddrString;
			NextStep(InitSequenceState);
		END_IF

		IF GetLocalAmsNetId.bError THEN
			_ErrorID := GetLocalAmsNetId.nErrId;
			_Error	 := TRUE;
			Trace.LogMessage(Name, 'Init Failed - GetLocalAmsNetId!');
			InitSequenceState := 999;
		END_IF

	10:
		GetConfiguredSlaves.bExecute := TRUE;
		IF GetConfiguredSlaves.bBusy THEN
			NextMinorStep(InitSequenceState);
		END_IF

	11:
		IF NOT GetConfiguredSlaves.bBusy AND NOT GetConfiguredSlaves.bError THEN
			NextStep(InitSequenceState);
		END_IF

		IF GetConfiguredSlaves.bError THEN
			_ErrorId := GetConfiguredSlaves.nErrorId;
			_Error	 := TRUE;
			Trace.LogMessage(Name, 'Init Failed - Configured EtherCat Slaves could not be read - check linking of EtherCat Master FB!');
			InitSequenceState := 999;
		END_IF

	20: // Get Master Frame Count
		GetMasterFrameCount.bExecute := TRUE;
		IF GetMasterFrameCount.bBusy THEN
			NextMinorStep(InitSequenceState);
		END_IF

	21:
		IF NOT GetMasterFrameCount.bBusy AND NOT GetMasterFrameCount.bError THEN
			// Check Frame Count
			IF GetMasterFrameCount.nFrames > FRAMES THEN
				_Error := TRUE;
				Trace.LogMessage(Name, 'Increase of Frame diagnostic array (FRAMES_MAX) and link to FrmXWcState!');
				RETURN;
			END_IF

			// Check Frame Linking
			FOR i := 0 TO (GetMasterFrameCount.nFrames - 1) DO
				IF NOT (F_GetMappingStatus(ADR(FrmXWcState[i]), SIZEOF(FrmXWcState[i])) <> EplcMappingStatus.MS_Unmapped) THEN
					_Error := TRUE;
					Trace.LogMessage(Name, 'Init Failed - FrmXWcState[x] not mapped to Master!');
					RETURN;
				END_IF
			END_FOR

			NextStep(InitSequenceState);
		END_IF

		IF GetMasterFrameCount.bError THEN
			_ErrorId := GetMasterFrameCount.nErrId;
			_Error	 := TRUE;
			Trace.LogMessage(Name, 'Init Failed - Configured EtherCat Frames could not be read!');
			InitSequenceState := 999;
		END_IF

	30:
		FOR i := 0 TO (SYNC_UNITS - 1) DO
			SyncUnit[i].EventProvider := EventProvider;
			SyncUnit[i].Initialize();
			IF NOT SyncUnit[i].Initialized THEN
				RETURN;
			END_IF
		END_FOR

		NextStep(InitSequenceState);

	40:
		StartCycles := StartCycles + 1;
		IF StartCycles = EcStartupCycles THEN
			FOR i := 0 TO (EcMaster.CfgSlaveCount - 1) DO
				IoDevice[i].AmsNetId	  := EcMaster.AmsNetID;
				IoDevice[i].Name		  := ConfiguredSlaveInfo[i].sName;
				IoDevice[i].State		  REF= SlavesState[i];
				IoDevice[i].Configuration REF= ConfiguredSlaveInfo[i];
			END_FOR

			_Initialized := TRUE;
		END_IF

	999: // Fail - Look at trace message in ADS log
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="Initialized" Id="{462f1142-9a6c-459f-809a-d563cfeef048}" FolderPath="Initialize\">
