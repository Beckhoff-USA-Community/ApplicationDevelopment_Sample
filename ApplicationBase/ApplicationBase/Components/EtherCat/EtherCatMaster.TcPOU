<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="EtherCatMaster" Id="{e9f0f328-f6e9-478d-a143-06ac013b96e0}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK EtherCatMaster
VAR_GENERIC CONSTANT
	FRAMES	   : UINT := 1;
	SYNC_UNITS : UINT := 2;
END_VAR
EXTENDS CyclicComponent IMPLEMENTS I_EtherCatMasterDiagnostic, I_Initializable, I_TaskResult, I_Simulatable, I_CoeTransferScheduler
VAR
	EcMaster	AT %I*	: ST_EtherCatMasterInfo;
	FrmXWcState AT %I*	: ARRAY[0..(FRAMES - 1)] OF WORD;
	ConfiguredSlaveInfo : ARRAY[0..MAX_EC_SLAVES] OF ST_EcSlaveConfigData;
	SlavesState			: ARRAY[0..MAX_EC_SLAVES] OF ST_EcExtendedSlaveState;
	SlaveTopologyInfo	: ARRAY[0..MAX_EC_SLAVES] OF ST_TopologyDataEx;
	// Configured slave index + 1 by (EtherCAT address - FIRST_SLAVE_ADDR); 0 = no slave at that address
	AddrToIndex			: ARRAY[0..MAX_EC_SLAVES] OF UINT;
	// The sync units resolve their slaves through the I_EcSlaveRegistry role of this master
	SyncUnit			: ARRAY[0..(SYNC_UNITS - 1)] OF SyncUnitTask('Sync Unit', THIS^);
	IoDevice			: ARRAY[0..MAX_EC_SLAVES] OF EtherCatIoDevice('Io Device');
	// CoE transfers in flight - only these are serviced each cycle (I_CoeTransferScheduler)
	ActiveCoe			: ARRAY[0..MAX_EC_SLAVES] OF I_CoeTransfer;
	ActiveCoeCount		: UINT;
	EventProvider		: I_EtherCatDiagnosticEventProvider;
END_VAR

VAR
	InitSequenceState								 : UDINT;
	SlaveSequence									 : UDINT;
	RunSlaveDiag, LastFramesWcStatesOk				 : BOOL;
	LastChangeCount, LastSlaveCount, LastMasterState : UINT;
	EcStartupCycles									 : UINT;
	SlaveCountUsed									 : UINT;  // configured slaves covered by the arrays, latched in Initialize
	ScanIndex										 : UINT;  // slave position of the running multi-cycle pass
	SyncUnitScan									 : UINT;  // sync unit of the running assignment pass
	FirstDiagIndex									 : UINT;  // first slave that is not OP or reports a link problem
	AnyDiag											 : BOOL;
	SyncUnitsAssigned								 : BOOL;
	WaitCycles										 : UDINT; // ADS watchdog of the running wait step
	GetConfiguredSlaves								 : FB_EcGetConfSlaves;
	GetMasterFrameCount								 : FB_EcMasterFrameCount;
	GetAllSlaveStates								 : FB_EcGetAllExtSlaveStates;
	GetSlaveTopologyInfo							 : FB_EcGetSlaveTopologyInfo;
END_VAR

VAR
	{attribute 'hide'}
	_Initialized : BOOL;
	{attribute 'hide'}
	_Error : BOOL;
	{attribute 'hide'}
	_Busy : BOOL;
	{attribute 'hide'}
	_ErrorId : UDINT;
	{attribute 'hide'}
	_ErrorSource : E_EcErrorSource;
	{attribute 'hide'}
	_Simulated : BOOL;
	{attribute 'hide'}
	Config : ST_EcSlaveConfigData;
	{attribute 'hide'}
	State : ST_EcExtendedSlaveState;
	{attribute 'hide'}
	NullIoDevice : EtherCatIoDevice('NullIoDevice') := (Configuration := Config, State := State);
	{attribute 'hide'}
	_LocalAmsNetId : T_AmsNetId;
	{attribute 'hide'}
	_MasterAmsNetId : T_AmsNetId;
END_VAR

VAR CONSTANT
	FIRST_SLAVE_ADDR  : UINT  := 1001;	 // TwinCAT assigns EtherCAT addresses from 1001 in configuration order
	ADS_TIMEOUT		  : TIME  := T#5S;
	ERROR_ADS_TIMEOUT : UDINT := 16#745; // ADS client: timeout elapsed (watchdog abort)
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="_Internal" Id="{ca0b50fd-5048-4aec-b945-6ade741b5cc3}" />
    <Folder Name="CoE" Id="{3a013ee2-7997-4313-a622-78d410a5c6d2}" />
    <Folder Name="Diagnostic" Id="{8daf5ba7-ec56-4aa2-87f5-e02cf302f316}" />
    <Folder Name="Initialize" Id="{70d62c55-9a6e-4608-a13a-af986e41c0cf}" />
    <Folder Name="Resettable" Id="{3af3d3da-4a00-45c9-a31e-fe08287c134d}" />
    <Folder Name="TaskResult" Id="{8aae4edb-d4d6-4720-af63-e947524eb0f2}" />
    <Method Name="AdsWatchdogExpired" Id="{3b9bd3d5-6590-4dd4-868c-f84365f0df38}" FolderPath="_Internal\">
      <Declaration><![CDATA[// Counts the cycles of the running wait step; TRUE once MaxCycles is exceeded.
METHOD PRIVATE AdsWatchdogExpired : BOOL
VAR_INPUT
	MaxCycles : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[WaitCycles		   := WaitCycles + 1;
AdsWatchdogExpired := WaitCycles > MaxCycles;]]></ST>
      </Implementation>
    </Method>
    <Method Name="BuildAddrToIndex" Id="{540611c4-ced8-4f68-9d63-bc81cccaef12}" FolderPath="_Internal\">
      <Declaration><![CDATA[// Rebuilds the address map from the configured slaves (SlaveCountUsed entries).
METHOD PROTECTED BuildAddrToIndex
VAR
	i : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[MEMSET(ADR(AddrToIndex), 0, SIZEOF(AddrToIndex));

i := 0;
WHILE i < SlaveCountUsed DO
	MapSlaveAddress(i);
	i := i + 1;
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Property Name="Busy" Id="{a8d6e216-d136-48f1-a6ee-beda6d975c86}" FolderPath="TaskResult\">
      <Declaration><![CDATA[// TRUE while a diagnostic sequence runs. A pass over n slaves takes up to n / SLAVES_PER_CYCLE cycles,
// so Error/ErrorId of a change land that many cycles after the trigger.
{attribute 'monitoring' := 'call'}
PROPERTY Busy : BOOL]]></Declaration>
      <Get Name="Get" Id="{4056a01c-0c87-4417-bd5a-9b0e2daa64f5}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Busy := _Busy;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ConfiguredSlaveCount" Id="{fad5d2d6-9a3e-0291-3bce-eb8536172a8c}" FolderPath="Diagnostic\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ConfiguredSlaveCount : UINT]]></Declaration>
      <Get Name="Get" Id="{62ec34ab-2a7d-0373-052b-2643e3f7533b}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[ConfiguredSlaveCount := EcMaster.CfgSlaveCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CyclicLogic" Id="{78fc609d-40b9-4518-b70e-60c3ef93632e}">
      <Declaration><![CDATA[METHOD CyclicLogic
VAR
	i : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Initialized THEN
	Initialize();
	RETURN;
END_IF

IF Simulated THEN
	_Busy		 := FALSE;
	_Error		 := FALSE;
	_ErrorId	 := 0;
	_ErrorSource := E_EcErrorSource.None;
ELSE
	IF NOT _Busy THEN
		IF (LastChangeCount <> EcMaster.ChangeCount) THEN
			RunSlaveDiag := TRUE;
		ELSIF ((EcMaster.CfgSlaveCount <> EcMaster.SlaveCount) AND (LastSlaveCount <> EcMaster.SlaveCount)) THEN
			RunSlaveDiag := TRUE;
		ELSIF FramesWcStatesOk() <> LastFramesWcStatesOk THEN
			RunSlaveDiag := TRUE;
		END_IF

		IF RunSlaveDiag THEN
			LastChangeCount		 := EcMaster.ChangeCount;
			LastSlaveCount		 := EcMaster.SlaveCount;
			LastFramesWcStatesOk := FramesWcStatesOk();
		END_IF
	END_IF

	MasterState();
	SlaveState();
	FOR i := 0 TO (SYNC_UNITS - 1) DO
		SyncUnit[i].CyclicLogic();
	END_FOR

	_Busy := SlaveSequence <> 0;
END_IF

(* Only CoE transfers in flight are serviced; idle io devices cost nothing per cycle. *)
ServiceCoeTransfers();]]></ST>
      </Implementation>
    </Method>
    <Method Name="EndDiagnosticPass" Id="{a2e8164c-889e-4970-853b-1e9658378f69}" FolderPath="_Internal\">
      <Declaration><![CDATA[// Leaves the slave evaluation: assigns the sync units once they resolved their slave lists, otherwise idles.
METHOD PRIVATE EndDiagnosticPass]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT SyncUnitsAssigned AND_THEN SyncUnitsResolved() THEN
	SyncUnitScan  := 0;
	ScanIndex	  := 0;
	SlaveSequence := 40;
ELSE
	SlaveSequence := 0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="Error" Id="{fd2aad37-acbd-4549-8dff-3cc1e8b69d66}" FolderPath="TaskResult\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Error : BOOL]]></Declaration>
      <Get Name="Get" Id="{80679826-41d5-4b2a-92e4-bce3af7fb62b}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Error := _Error;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ErrorId" Id="{76e2677e-85b8-4192-ae01-7f29edcaffcd}" FolderPath="TaskResult\">
      <Declaration><![CDATA[// Raw code of ErrorSource: DevState word (Master), slave index (Slave), ADS error id (Ads), step (Sequence).
{attribute 'monitoring' := 'call'}
PROPERTY ErrorId : UDINT]]></Declaration>
      <Get Name="Get" Id="{c59f189e-2b3d-447d-8383-1ed95dba4997}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[ErrorId := _ErrorId;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ErrorSource" Id="{17e49a29-0c1e-4905-860e-026e3ec8b8ce}" FolderPath="TaskResult\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ErrorSource : E_EcErrorSource]]></Declaration>
      <Get Name="Get" Id="{f9b69b38-90d1-403e-a932-a7fc61f6b82a}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[ErrorSource := _ErrorSource;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="EvaluateSlave" Id="{9023d524-15b7-4b34-acbc-4468eb23bb1b}" FolderPath="_Internal\">
      <Declaration><![CDATA[// Raises the slave events for one configured slave. TRUE when a fault was latched (Error, ErrorSource.Slave).
METHOD PROTECTED EvaluateSlave : BOOL
VAR_INPUT
	Index : UINT;
END_VAR

VAR
	DiagByte : BYTE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF SlaveTopologyInfo[Index].nStatusBits.4 THEN
	RETURN; // member of a hot connect group: absence or a non-OP state is not a fault
END_IF

DiagByte := SlavesState[Index].deviceState AND 16#0F;
IF DiagByte <> EC_DEVICE_STATE_OP THEN
	IF SlavesState[Index].deviceState.7 THEN // slave is disabled - warning only
		IF EventProvider <> 0 THEN
			EventProvider.RaiseEtherCatDiagnosticEvent(E_EtherCatMaster.SlaveDisabled, ConfiguredSlaveInfo[Index].sName);
		END_IF
	ELSE
		IF EventProvider <> 0 THEN
			EventProvider.RaiseEtherCatDiagnosticEvent(E_EtherCatMaster.SlaveError, ConfiguredSlaveInfo[Index].sName, LookupSlaveState(Index));
		END_IF

		SetError(E_EcErrorSource.Slave, Index);
		EvaluateSlave := TRUE;
		RETURN;
	END_IF
END_IF

DiagByte := SlavesState[Index].linkState AND 16#0F;
IF DiagByte <> EC_LINK_STATE_OK THEN
	IF EventProvider <> 0 THEN
		EventProvider.RaiseEtherCatDiagnosticEvent(E_EtherCatMaster.SlaveError, ConfiguredSlaveInfo[Index].sName, LookupSlaveState(Index));
	END_IF

	SetError(E_EcErrorSource.Slave, Index);
	EvaluateSlave := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FailInit" Id="{4984ebc0-ef47-45e8-a10b-3591d1da83e0}" FolderPath="Initialize\">
      <Declaration><![CDATA[// Latches the error, logs Message and parks the init sequence in step 999.
METHOD PRIVATE FailInit
VAR_INPUT
	Source	: E_EcErrorSource;
	ErrorId : UDINT;
	Message : T_MaxString;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetError(Source, ErrorId);
Trace.LogMessage(Name, Message);
InitSequenceState := 999;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FailSequence" Id="{7dc00690-6d23-4b1f-ab9e-e84f63f4ef5b}" FolderPath="_Internal\">
      <Declaration><![CDATA[// Latches the error and aborts the running diagnostic sequence.
METHOD PRIVATE FailSequence
VAR_INPUT
	Source	: E_EcErrorSource;
	ErrorId : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetError(Source, ErrorId);
SlaveSequence := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{b13f5ee7-b35d-4d18-9795-7f71c11f59d6}">
      <Declaration><![CDATA[(*FB_Init is always available implicitly and it is used primarily for initialization.
The return value is not evaluated. For a specific influence, you can also declare the
methods explicitly and provide additional code there with the standard initialization
code. You can evaluate the return value.*)
METHOD FB_Init : BOOL
VAR_INPUT
	(* TRUE: the retain variables are initialized (reset warm / reset cold)*)
	bInitRetains : BOOL;

	(* TRUE: the instance will be copied to the copy code afterward (online change)   *)
	bInCopyCode		: BOOL;
	Name			: T_MaxString;
	EcStartupCycles : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.EcStartupCycles := EcStartupCycles;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FramesWcStatesOk" Id="{d8515602-a931-0646-062f-139b29a44aad}" FolderPath="_Internal\">
      <Declaration><![CDATA[METHOD PROTECTED FramesWcStatesOk : BOOL
VAR
	i : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FramesWcStatesOk := TRUE;
IF GetMasterFrameCount.nFrames = 0 THEN
	RETURN;
END_IF

FOR i := 0 TO (MIN(GetMasterFrameCount.nFrames, FRAMES) - 1) DO
	IF FrmXWcState[i] <> 0 THEN
		FramesWcStatesOk := FALSE;
		EXIT;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetIoDeviceByAddr" Id="{8fec52b1-8c69-4759-b15f-16e0bfdd0031}" FolderPath="Diagnostic\">
      <Declaration><![CDATA[// O(1) through the address map. Returns the null device (and logs a warning) for unknown addresses.
METHOD GetIoDeviceByAddr : I_EcIoDevice
VAR_INPUT
	Addr : WORD;
END_VAR

VAR
	Idx : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Initialized THEN
	GetIoDeviceByAddr := NullIoDevice;
	RETURN;
END_IF

Idx := GetSlaveIndexByAddr(WORD_TO_UINT(Addr));
IF Idx >= 0 THEN
	GetIoDeviceByAddr := IoDevice[Idx];
ELSE
	Trace.LogMessage(Name, CONCAT('GetIoDeviceByAddr: no configured slave at address ', TO_STRING(WORD_TO_UINT(Addr))));
	GetIoDeviceByAddr := NullIoDevice;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetIoDeviceByName" Id="{13f2fd00-8fca-4d64-97a3-0bb868e7b598}" FolderPath="Diagnostic\">
      <Declaration><![CDATA[// Linear search over the configured slaves: call once and keep the result.
// Returns the null device (and logs a warning) if no slave carries that name.
METHOD GetIoDeviceByName : I_EcIoDevice
VAR_INPUT
	Name : STRING(31);
END_VAR

VAR
	i : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Initialized THEN
	GetIoDeviceByName := NullIoDevice;
	RETURN;
END_IF

i := 0;
WHILE i < SlaveCountUsed DO
	IF IoDevice[i].Name = Name THEN
		GetIoDeviceByName := IoDevice[i];
		RETURN;
	END_IF
	i := i + 1;
END_WHILE

Trace.LogMessage(THIS^.Name, CONCAT('GetIoDeviceByName: no configured slave named ', Name));
GetIoDeviceByName := NullIoDevice;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetSlaveIndexByAddr" Id="{49de51a0-75fa-43d3-9637-c84ac886b692}" FolderPath="Diagnostic\">
      <Declaration><![CDATA[// Configured slave index (0-based) of the slave with EtherCAT address Addr, -1 if none.
// O(1) for the dense range FIRST_SLAVE_ADDR .. FIRST_SLAVE_ADDR + MAX_EC_SLAVES, linear search otherwise.
METHOD GetSlaveIndexByAddr : DINT
VAR_INPUT
	Addr : UINT;
END_VAR

VAR
	i : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetSlaveIndexByAddr := -1;

IF (Addr >= FIRST_SLAVE_ADDR) AND_THEN ((Addr - FIRST_SLAVE_ADDR) <= MAX_EC_SLAVES) THEN
	IF AddrToIndex[Addr - FIRST_SLAVE_ADDR] <> 0 THEN
		GetSlaveIndexByAddr := AddrToIndex[Addr - FIRST_SLAVE_ADDR] - 1;
	END_IF
	RETURN; // the map is complete for this range
END_IF

(* Addresses outside the dense range (assigned by the user): linear search. *)
i := 0;
WHILE i < SlaveCountUsed DO
	IF ConfiguredSlaveInfo[i].nAddr = Addr THEN
		GetSlaveIndexByAddr := i;
		RETURN;
	END_IF
	i := i + 1;
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetSlaveName" Id="{7ab1777b-bb34-4d61-afb1-332f6cf67366}" FolderPath="Diagnostic\">
      <Declaration><![CDATA[// I_EcSlaveRegistry: name of the configured slave at Index, '' if Index is out of range.
METHOD GetSlaveName : STRING
VAR_INPUT
	Index : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Index < SlaveCountUsed THEN
	GetSlaveName := ConfiguredSlaveInfo[Index].sName;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initialize" Id="{59fc31be-2fef-4308-9217-c3cfb6c18f0b}" FolderPath="Initialize\">
      <Declaration><![CDATA[// Init sequence: local AMS Net ID (0) - configured slaves (10) - topology (20) - frame count (30) -
// sync units (40) - startup cycles, io device wiring and address map (50). Step 999 = failed, see trace.
METHOD Initialize
VAR_INST
	GetLocalAmsNetId : FB_GetLocalAmsNetId;
	StartCycles		 : UINT;
END_VAR

VAR
	i : UDINT;
	k : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _Error AND NOT Simulated THEN
	IF F_GetMappingStatus(ADR(EcMaster.AmsNetID), SIZEOF(EcMaster.AmsNetID)) = EplcMappingStatus.MS_Unmapped THEN
		FailInit(E_EcErrorSource.Sequence, InitSequenceState, 'Init Failed - EcMaster.AmsNetID not mapped to the EtherCAT master!');
	ELSIF F_GetMappingStatus(ADR(EcMaster.DevID), SIZEOF(EcMaster.DevID)) = EplcMappingStatus.MS_Unmapped THEN
		FailInit(E_EcErrorSource.Sequence, InitSequenceState, 'Init Failed - EcMaster.DevID not mapped to the EtherCAT master!');
	ELSIF F_GetMappingStatus(ADR(EcMaster.DevState), SIZEOF(EcMaster.DevState)) = EplcMappingStatus.MS_Unmapped THEN
		FailInit(E_EcErrorSource.Sequence, InitSequenceState, 'Init Failed - EcMaster.DevState not mapped to the EtherCAT master!');
	ELSIF F_GetMappingStatus(ADR(EcMaster.ChangeCount), SIZEOF(EcMaster.ChangeCount)) = EplcMappingStatus.MS_Unmapped THEN
		FailInit(E_EcErrorSource.Sequence, InitSequenceState, 'Init Failed - EcMaster.ChangeCount not mapped to the EtherCAT master!');
	ELSIF F_GetMappingStatus(ADR(EcMaster.SlaveCount), SIZEOF(EcMaster.SlaveCount)) = EplcMappingStatus.MS_Unmapped THEN
		FailInit(E_EcErrorSource.Sequence, InitSequenceState, 'Init Failed - EcMaster.SlaveCount not mapped to the EtherCAT master!');
	ELSIF F_GetMappingStatus(ADR(EcMaster.CfgSlaveCount), SIZEOF(EcMaster.CfgSlaveCount)) = EplcMappingStatus.MS_Unmapped THEN
		FailInit(E_EcErrorSource.Sequence, InitSequenceState, 'Init Failed - EcMaster.CfgSlaveCount not mapped to the EtherCAT master!');
	END_IF
END_IF

IF _Error THEN
	RETURN;
END_IF

IF Simulated THEN
	FOR i := 0 TO (SYNC_UNITS - 1) DO
		SyncUnit[i].EventProvider := EventProvider;
		SyncUnit[i].Simulated	  := Simulated;
		SyncUnit[i].Initialize();
		IF NOT SyncUnit[i].Initialized THEN
			RETURN;
		END_IF
	END_FOR

	_Initialized := TRUE;
	RETURN;
END_IF

GetLocalAmsNetId(tTimeOut := T#1S);
_MasterAmsNetId := F_CreateAmsNetId(EcMaster.AmsNetID);
GetMasterFrameCount(sNetId := _MasterAmsNetId, tTimeout := ADS_TIMEOUT);
GetConfiguredSlaves(sNetId				:= _MasterAmsNetId,
					pArrEcConfSlaveInfo := ADR(ConfiguredSlaveInfo),
					cbBufLen			:= SlaveCountUsed * SIZEOF(ConfiguredSlaveInfo[0]),
					tTimeout			:= ADS_TIMEOUT);
GetSlaveTopologyInfo(sNetId	  := _MasterAmsNetId,
					 pAddrBuf := ADR(SlaveTopologyInfo),
					 cbBufLen := TopologyBufLen(),
					 tTimeout := ADS_TIMEOUT);

CASE InitSequenceState OF
	0: (* local AMS Net ID *)
		GetLocalAmsNetId.bExecute := TRUE;
		WaitCycles				  := 0;
		NextMinorStep(InitSequenceState);

	1:
		IF GetLocalAmsNetId.bBusy THEN
			IF AdsWatchdogExpired(ADS_WAIT_CYCLES) THEN
				GetLocalAmsNetId.bExecute := FALSE;
				FailInit(E_EcErrorSource.Ads, ERROR_ADS_TIMEOUT, 'Init Failed - GetLocalAmsNetId timed out!');
			END_IF
		ELSIF GetLocalAmsNetId.bError THEN
			GetLocalAmsNetId.bExecute := FALSE;
			FailInit(E_EcErrorSource.Ads, GetLocalAmsNetId.nErrId, 'Init Failed - GetLocalAmsNetId!');
		ELSE
			GetLocalAmsNetId.bExecute := FALSE;
			_LocalAmsNetId			  := GetLocalAmsNetId.AddrString;
			WaitCycles				  := 0;
			NextStep(InitSequenceState);
		END_IF

	10: (* configured slaves, read sized to the configured count *)
		IF EcMaster.CfgSlaveCount = 0 THEN
			IF AdsWatchdogExpired(ADS_WAIT_CYCLES) THEN
				FailInit(E_EcErrorSource.Sequence, InitSequenceState, 'Init Failed - EcMaster.CfgSlaveCount stays 0: no slaves configured or EcMaster not linked!');
			END_IF
			RETURN;
		END_IF

		IF EcMaster.CfgSlaveCount > (MAX_EC_SLAVES + 1) THEN
			FailInit(E_EcErrorSource.Sequence, EcMaster.CfgSlaveCount, 'Init Failed - more slaves configured than EtherCatParameter.MAX_EC_SLAVES + 1 can hold!');
			RETURN;
		END_IF

		SlaveCountUsed				 := EcMaster.CfgSlaveCount;
		GetConfiguredSlaves.bExecute := TRUE;
		WaitCycles					 := 0;
		NextMinorStep(InitSequenceState);

	11:
		IF GetConfiguredSlaves.bBusy THEN
			IF AdsWatchdogExpired(INIT_WAIT_CYCLES) THEN
				GetConfiguredSlaves.bExecute := FALSE;
				FailInit(E_EcErrorSource.Ads, ERROR_ADS_TIMEOUT, 'Init Failed - reading the configured EtherCAT slaves timed out!');
			END_IF
		ELSIF GetConfiguredSlaves.bError THEN
			GetConfiguredSlaves.bExecute := FALSE;
			FailInit(E_EcErrorSource.Ads, GetConfiguredSlaves.nErrorId, 'Init Failed - configured EtherCAT slaves could not be read - check linking of the EtherCAT master FB!');
		ELSE
			GetConfiguredSlaves.bExecute := FALSE;
			WaitCycles					 := 0;
			NextStep(InitSequenceState);
		END_IF

	20: (* topology: the hot connect flags are needed by the slave evaluation and the sync units *)
		GetSlaveTopologyInfo.bExecute := TRUE;
		WaitCycles					  := 0;
		NextMinorStep(InitSequenceState);

	21:
		IF GetSlaveTopologyInfo.bBusy THEN
			IF AdsWatchdogExpired(INIT_WAIT_CYCLES) THEN
				GetSlaveTopologyInfo.bExecute := FALSE;
				FailInit(E_EcErrorSource.Ads, ERROR_ADS_TIMEOUT, 'Init Failed - reading the EtherCAT topology timed out!');
			END_IF
		ELSIF GetSlaveTopologyInfo.bError THEN
			GetSlaveTopologyInfo.bExecute := FALSE;
			FailInit(E_EcErrorSource.Ads, GetSlaveTopologyInfo.nErrId, 'Init Failed - EtherCAT topology could not be read!');
		ELSE
			GetSlaveTopologyInfo.bExecute := FALSE;
			WaitCycles					  := 0;
			NextStep(InitSequenceState);
		END_IF

	30: (* frame count *)
		GetMasterFrameCount.bExecute := TRUE;
		WaitCycles					 := 0;
		NextMinorStep(InitSequenceState);

	31:
		IF GetMasterFrameCount.bBusy THEN
			IF AdsWatchdogExpired(ADS_WAIT_CYCLES) THEN
				GetMasterFrameCount.bExecute := FALSE;
				FailInit(E_EcErrorSource.Ads, ERROR_ADS_TIMEOUT, 'Init Failed - reading the EtherCAT frame count timed out!');
			END_IF
		ELSIF GetMasterFrameCount.bError THEN
			GetMasterFrameCount.bExecute := FALSE;
			FailInit(E_EcErrorSource.Ads, GetMasterFrameCount.nErrId, 'Init Failed - configured EtherCAT frames could not be read!');
		ELSE
			GetMasterFrameCount.bExecute := FALSE;
			IF GetMasterFrameCount.nFrames = 0 THEN
				FailInit(E_EcErrorSource.Sequence, InitSequenceState, 'Init Failed - the EtherCAT master reports no cyclic frames!');
				RETURN;
			END_IF

			IF GetMasterFrameCount.nFrames > FRAMES THEN
				FailInit(E_EcErrorSource.Sequence, GetMasterFrameCount.nFrames, 'Init Failed - increase the FRAMES generic parameter and link FrmXWcState[x] to the master!');
				RETURN;
			END_IF

			FOR i := 0 TO (GetMasterFrameCount.nFrames - 1) DO
				IF F_GetMappingStatus(ADR(FrmXWcState[i]), SIZEOF(FrmXWcState[i])) = EplcMappingStatus.MS_Unmapped THEN
					FailInit(E_EcErrorSource.Sequence, i, 'Init Failed - FrmXWcState[x] not mapped to the EtherCAT master!');
					RETURN;
				END_IF
			END_FOR

			NextStep(InitSequenceState);
		END_IF

	40: (* sync units *)
		FOR i := 0 TO (SYNC_UNITS - 1) DO
			SyncUnit[i].EventProvider := EventProvider;
			SyncUnit[i].Initialize();
			IF SyncUnit[i].Error THEN
				FailInit(E_EcErrorSource.Sequence, i, 'Init Failed - a sync unit could not be initialised (see its trace message)!');
				RETURN;
			END_IF

			IF NOT SyncUnit[i].Initialized THEN
				RETURN;
			END_IF
		END_FOR

		NextStep(InitSequenceState);

	50: (* let the master settle, then build the address map *)
		StartCycles := StartCycles + 1;
		IF StartCycles >= EcStartupCycles THEN
			BuildAddrToIndex();
			ScanIndex := 0;
			NextMinorStep(InitSequenceState);
		END_IF

	51: (* wire the io devices, SLAVES_PER_CYCLE per cycle *)
		FOR k := 1 TO SLAVES_PER_CYCLE DO
			IF ScanIndex >= SlaveCountUsed THEN
				EXIT;
			END_IF

			IoDevice[ScanIndex].AmsNetId	  := EcMaster.AmsNetID;
			IoDevice[ScanIndex].Name		  := ConfiguredSlaveInfo[ScanIndex].sName;
			IoDevice[ScanIndex].State		  REF= SlavesState[ScanIndex];
			IoDevice[ScanIndex].Configuration REF= ConfiguredSlaveInfo[ScanIndex];
			IoDevice[ScanIndex].CoeScheduler  := THIS^;
			ScanIndex						  := ScanIndex + 1;
		END_FOR

		IF ScanIndex >= SlaveCountUsed THEN
			_Initialized := TRUE;
		END_IF

	999: (* Fail - look at the trace message in the ADS log *)
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="Initialized" Id="{462f1142-9a6c-459f-809a-d563cfeef048}" FolderPath="Initialize\">
