<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="EtherCatMaster" Id="{e9f0f328-f6e9-478d-a143-06ac013b96e0}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK EtherCatMaster
VAR_GENERIC CONSTANT
	FRAMES	   : UINT := 1;
	SYNC_UNITS : UINT := 2;
END_VAR
EXTENDS CyclicComponent IMPLEMENTS I_EtherCatMasterDiagnostic, I_Initializable, I_TaskResult, I_Simulatable
VAR
	EcMaster	AT %I*	: ST_EtherCatMasterInfo;
	FrmXWcState AT %I*	: ARRAY[0..(FRAMES - 1)] OF WORD;
	ConfiguredSlaveInfo : ARRAY[0..MAX_EC_SLAVES] OF ST_EcSlaveConfigData;
	SlavesState			: ARRAY[0..MAX_EC_SLAVES] OF ST_EcSlaveState;
	SlaveTopologyInfo	: ARRAY[0..MAX_EC_SLAVES] OF ST_TopologyDataEx;
	SyncUnit			: ARRAY[0..(SYNC_UNITS - 1)] OF SyncUnitTask('Sync Unit', THIS^, ConfiguredSlaveInfo, SlaveTopologyInfo);
	IoDevice			: ARRAY[0..MAX_EC_SLAVES] OF EtherCatIoDevice('Io Device');
	EventProvider		: I_EtherCatDiagnosticEventProvider;
END_VAR

VAR
	SlaveSequence									 : UDINT;
	RunSlaveDiag, LastFramesWcStatesOk				 : BOOL;
	LastChangeCount, LastSlaveCount, LastMasterState : UINT;
	EcStartupCycles									 : UINT;
	GetConfiguredSlaves								 : FB_EcGetConfSlaves;
	GetMasterFrameCount								 : FB_EcMasterFrameCount;
	GetAllSlaveStates								 : FB_EcGetAllSlaveStates;
	GetSlaveTopologyInfo							 : FB_EcGetSlaveTopologyInfo;
END_VAR

VAR
	{attribute 'hide'}
	_Initialized : BOOL;
	{attribute 'hide'}
	_Error : BOOL;
	{attribute 'hide'}
	_Busy : BOOL;
	{attribute 'hide'}
	_ErrorId : UDINT;
	{attribute 'hide'}
	_Simulated : BOOL;
	{attribute 'hide'}
	Config : ST_EcSlaveConfigData;
	{attribute 'hide'}
	State : ST_EcSlaveState;
	{attribute 'hide'}
	NullIoDevice : EtherCatIoDevice('NullIoDevice') := (Configuration := Config, State := State);
	{attribute 'hide'}
	_LocalAmsNetId : T_AmsNetId;
	{attribute 'hide'}
	_MasterAmsNetId : T_AmsNetId;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="_Internal" Id="{ca0b50fd-5048-4aec-b945-6ade741b5cc3}" />
    <Folder Name="Diagnostic" Id="{8daf5ba7-ec56-4aa2-87f5-e02cf302f316}" />
    <Folder Name="Initialize" Id="{70d62c55-9a6e-4608-a13a-af986e41c0cf}" />
    <Folder Name="Resettable" Id="{3af3d3da-4a00-45c9-a31e-fe08287c134d}" />
    <Folder Name="TaskResult" Id="{8aae4edb-d4d6-4720-af63-e947524eb0f2}" />
    <Property Name="Busy" Id="{a8d6e216-d136-48f1-a6ee-beda6d975c86}" FolderPath="TaskResult\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Busy : BOOL]]></Declaration>
      <Get Name="Get" Id="{4056a01c-0c87-4417-bd5a-9b0e2daa64f5}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Busy := _Busy;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ConfiguredSlaveCount" Id="{fad5d2d6-9a3e-0291-3bce-eb8536172a8c}" FolderPath="Diagnostic\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ConfiguredSlaveCount : UINT]]></Declaration>
      <Get Name="Get" Id="{62ec34ab-2a7d-0373-052b-2643e3f7533b}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[ConfiguredSlaveCount := EcMaster.CfgSlaveCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CyclicLogic" Id="{78fc609d-40b9-4518-b70e-60c3ef93632e}">
      <Declaration><![CDATA[METHOD CyclicLogic
VAR
	i : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Initialized THEN
	Initialize();
	RETURN;
END_IF

IF Simulated THEN
	_Busy	 := FALSE;
	_Error	 := FALSE;
	_ErrorId := 0;
ELSE
	IF NOT _Busy THEN
		IF (LastChangeCount <> EcMaster.ChangeCount) THEN
			RunSlaveDiag := TRUE;
		ELSIF ((EcMaster.CfgSlaveCount <> EcMaster.SlaveCount) AND (LastSlaveCount <> EcMaster.SlaveCount)) THEN
			RunSlaveDiag := TRUE;
		ELSIF FramesWcStatesOk() <> LastFramesWcStatesOk THEN
			RunSlaveDiag := TRUE;
		END_IF

		IF RunSlaveDiag THEN
			LastChangeCount		 := EcMaster.ChangeCount;
			LastSlaveCount		 := EcMaster.SlaveCount;
			LastFramesWcStatesOk := FramesWcStatesOk();
		END_IF
	END_IF

	GetSlaveTopologyInfo(sNetId	  := _MasterAmsNetId,
						 pAddrBuf := ADR(SlaveTopologyInfo),
						 cbBufLen := SIZEOF(SlaveTopologyInfo),
						 tTimeout := T#5S);

	GetAllSlaveStates(sNetId	:= _MasterAmsNetId,
					  pStateBuf := ADR(SlavesState),
					  cbBufLen	:= SIZEOF(SlavesState),
					  tTimeout	:= T#5S);

	MasterState();
	SlaveState();
	FOR i := 0 TO (SYNC_UNITS - 1) DO
		SyncUnit[i].CyclicLogic();
	END_FOR

	_Busy := SlaveSequence <> 0;
END_IF

FOR i := 0 TO (EcMaster.CfgSlaveCount - 1) DO
	IoDevice[i].CyclicLogic();
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Property Name="Error" Id="{fd2aad37-acbd-4549-8dff-3cc1e8b69d66}" FolderPath="TaskResult\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
