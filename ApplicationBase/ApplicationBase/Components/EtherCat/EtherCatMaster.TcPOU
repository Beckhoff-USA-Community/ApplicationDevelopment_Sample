    <Property Name="SlaveCount" Id="{bfc36d0d-748f-4330-826a-e7f9a3550123}" FolderPath="Diagnostic\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SlaveCount : UINT]]></Declaration>
      <Get Name="Get" Id="{8ba43fb2-7af8-4a46-9c1a-f74e5d772835}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[SlaveCount := EcMaster.SlaveCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SlaveNeedsDiagnostic" Id="{bab5ddbf-5759-4fc8-9d73-93879e28cb5f}" FolderPath="_Internal\">
      <Declaration><![CDATA[// TRUE if the slave is not in OP with a clean link (any state or link bit set).
METHOD PROTECTED SlaveNeedsDiagnostic : BOOL
VAR_INPUT
	Index : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SlaveNeedsDiagnostic := (SlavesState[Index].deviceState <> EC_DEVICE_STATE_OP) OR (SlavesState[Index].linkState <> 0);]]></ST>
      </Implementation>
    </Method>
    <Method Name="SlaveState" Id="{483b8cf5-1244-4799-bded-62d3800d6efa}" FolderPath="_Internal\">
      <Declaration><![CDATA[// Slave diagnostic sequence, run on every trigger (ChangeCount, slave count, frame WC state):
//  10/11 read all slave states (sized to the configured count)
//  12    classify, SLAVES_PER_CYCLE slaves per cycle; a clean network ends here
//  20/21 read the topology (hot connect flags) - only when a slave needs a diagnostic
//  30    evaluate from the first suspicious slave, stop at the first fault
//  40    assign the sync unit of every slave, once, after the sync units resolved their lists
METHOD PROTECTED SlaveState : BOOL
VAR
	k	: UINT;
	Idx : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetSlaveTopologyInfo(sNetId	  := _MasterAmsNetId,
					 pAddrBuf := ADR(SlaveTopologyInfo),
					 cbBufLen := TopologyBufLen(),
					 tTimeout := ADS_TIMEOUT);

GetAllSlaveStates(sNetId	:= _MasterAmsNetId,
				  pStateBuf := ADR(SlavesState),
				  cbBufLen	:= SlaveCountUsed * SIZEOF(SlavesState[0]),
				  tTimeout	:= ADS_TIMEOUT);

CASE SlaveSequence OF
	(* Wait for a trigger *)
	0:
		IF RunSlaveDiag THEN
			RunSlaveDiag  := FALSE;
			SlaveSequence := 10;
		ELSIF NOT SyncUnitsAssigned AND_THEN SyncUnitsResolved() THEN
			EndDiagnosticPass();
		END_IF

	(* Read slave states *)
	10:
		GetAllSlaveStates.bExecute := TRUE;
		WaitCycles				   := 0;
		NextMinorStep(SlaveSequence);

	11:
		IF GetAllSlaveStates.bBusy THEN
			IF AdsWatchdogExpired(ADS_WAIT_CYCLES) THEN
				GetAllSlaveStates.bExecute := FALSE;
				FailSequence(E_EcErrorSource.Ads, ERROR_ADS_TIMEOUT);
			END_IF
		ELSIF GetAllSlaveStates.bError THEN
			GetAllSlaveStates.bExecute := FALSE;
			FailSequence(E_EcErrorSource.Ads, GetAllSlaveStates.nErrId);
		ELSE
			GetAllSlaveStates.bExecute := FALSE;
			ScanIndex				   := 0;
			AnyDiag					   := FALSE;
			FirstDiagIndex			   := 0;
			NextMinorStep(SlaveSequence);
		END_IF

	(* Classify: find the first slave that needs a diagnostic *)
	12:
		FOR k := 1 TO SLAVES_PER_CYCLE DO
			IF ScanIndex >= SlaveCountUsed THEN
				EXIT;
			END_IF

			IF SlaveNeedsDiagnostic(ScanIndex) THEN
				AnyDiag		   := TRUE;
				FirstDiagIndex := ScanIndex;
				EXIT;
			END_IF

			ScanIndex := ScanIndex + 1;
		END_FOR

		IF AnyDiag THEN
			SlaveSequence := 20;
		ELSIF ScanIndex >= SlaveCountUsed THEN
			EndDiagnosticPass(); // every slave OP with a clean link: no topology read, no evaluation
		END_IF

	(* Update topology *)
	20:
		GetSlaveTopologyInfo.bExecute := TRUE;
		WaitCycles					  := 0;
		NextMinorStep(SlaveSequence);

	21:
		IF GetSlaveTopologyInfo.bBusy THEN
			IF AdsWatchdogExpired(ADS_WAIT_CYCLES) THEN
				GetSlaveTopologyInfo.bExecute := FALSE;
				FailSequence(E_EcErrorSource.Ads, ERROR_ADS_TIMEOUT);
			END_IF
		ELSIF GetSlaveTopologyInfo.bError THEN
			GetSlaveTopologyInfo.bExecute := FALSE;
			FailSequence(E_EcErrorSource.Ads, GetSlaveTopologyInfo.nErrId);
		ELSE
			GetSlaveTopologyInfo.bExecute := FALSE;
			ScanIndex					  := FirstDiagIndex;
			SlaveSequence				  := 30;
		END_IF

	(* Evaluate slave errors from the first suspicious slave on *)
	30:
		FOR k := 1 TO SLAVES_PER_CYCLE DO
			IF ScanIndex >= SlaveCountUsed THEN
				EXIT;
			END_IF

			IF EvaluateSlave(ScanIndex) THEN
				ScanIndex := SlaveCountUsed; // fault latched: stop the pass
				EXIT;
			END_IF

			ScanIndex := ScanIndex + 1;
		END_FOR

		IF ScanIndex >= SlaveCountUsed THEN
			EndDiagnosticPass();
		END_IF

	(* Assign the sync unit of every slave (once) *)
	40:
		FOR k := 1 TO SLAVES_PER_CYCLE DO
			IF SyncUnitScan >= SYNC_UNITS THEN
				EXIT;
			END_IF

			IF ScanIndex >= SyncUnit[SyncUnitScan].SlaveCount THEN
				SyncUnitScan := SyncUnitScan + 1;
				ScanIndex	 := 0;
			ELSE
				Idx := GetSlaveIndexByAddr(SyncUnit[SyncUnitScan].SlaveAddress(ScanIndex));
				IF Idx >= 0 THEN
					IoDevice[Idx].SyncUnit := SyncUnit[SyncUnitScan];
				END_IF

				ScanIndex := ScanIndex + 1;
			END_IF
		END_FOR

		IF SyncUnitScan >= SYNC_UNITS THEN
			SyncUnitsAssigned := TRUE;
			SlaveSequence	  := 0;
		END_IF

ELSE
	(* Sequence error: unknown step *)
	FailSequence(E_EcErrorSource.Sequence, SlaveSequence);
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="SyncUnitsResolved" Id="{5054c0c0-c40a-449a-95f1-194f3792089a}" FolderPath="_Internal\">
      <Declaration><![CDATA[// TRUE once every sync unit has read and resolved its slave list.
METHOD PRIVATE SyncUnitsResolved : BOOL
VAR
	i : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SyncUnitsResolved := TRUE;
FOR i := 0 TO (SYNC_UNITS - 1) DO
	IF NOT SyncUnit[i].SlavesResolved THEN
		SyncUnitsResolved := FALSE;
		RETURN;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="TopologyBufLen" Id="{2a906241-c190-4ecd-8467-1699bf9f6338}" FolderPath="_Internal\">
      <Declaration><![CDATA[// Byte length of the topology read: one entry per configured slave, not the whole array.
METHOD PRIVATE TopologyBufLen : UDINT]]></Declaration>
      <Implementation>
        <ST><![CDATA[TopologyBufLen := SlaveCountUsed * SIZEOF(SlaveTopologyInfo[0]);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>