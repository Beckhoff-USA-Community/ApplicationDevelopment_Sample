    <Method Name="LookupMasterState" Id="{77909b3a-0ac2-4bf6-a988-7eb95f542820}" FolderPath="_Internal\">
      <Declaration><![CDATA[METHOD PROTECTED LookupMasterState : STRING
VAR_INPUT
	State : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF State.0 THEN
	LookupMasterState := 'Link error';
ELSIF State.1 THEN
	LookupMasterState := 'I/O locked after link error (I/O reset required)';
ELSIF State.2 THEN
	LookupMasterState := 'Link error (redundancy adapter)';
ELSIF State.3 THEN
	LookupMasterState := 'Missing one frame (redundancy mode)';
ELSIF State.4 THEN
	LookupMasterState := 'Out of send resources (I/O reset required)';
ELSIF State.5 THEN
	LookupMasterState := 'Watchdog triggered';
ELSIF State.6 THEN
	LookupMasterState := 'Ethernet driver (miniport) NOT found';
ELSIF State.7 THEN
	LookupMasterState := 'I/O reset active';
ELSIF State.8 THEN
	LookupMasterState := 'At least one device in INIT state';
ELSIF State.9 THEN
	LookupMasterState := 'At least one device in PRE-OP state';
ELSIF State.10 THEN
	LookupMasterState := 'At least one device in SAFE-OP state';
ELSIF State.11 THEN
	LookupMasterState := 'At least one device indicates an error state';
ELSIF State.12 THEN
	LookupMasterState := 'DC not in sync';
ELSE
	LookupMasterState := 'State not found';
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="LookupSlaveState" Id="{2b979181-e45f-4339-bf02-a4112dadec98}" FolderPath="_Internal\">
      <Declaration><![CDATA[METHOD PROTECTED LookupSlaveState : STRING
VAR_INPUT
	Slave : UINT;
END_VAR

VAR_INST
	DiagByte	: BYTE;
	BitMaskDiag : BYTE := 16#0F;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* State *)
BitMaskDiag := 16#0F;
DiagByte	:= SlavesState[Slave].deviceState AND BitMaskDiag;
CASE DiagByte OF
	EC_DEVICE_STATE_INIT:
		LookupSlaveState := 'Init';

	EC_DEVICE_STATE_PREOP:
		LookupSlaveState := 'Pre-op';

	EC_DEVICE_STATE_BOOTSTRAP:
		LookupSlaveState := 'Boot';

	EC_DEVICE_STATE_SAFEOP:
		LookupSlaveState := 'Safe-op';

	EC_DEVICE_STATE_OP:
		LookupSlaveState := 'OP';

ELSE
	LookupSlaveState := '';
END_CASE

(* Additional State Bits *)
IF SlavesState[Slave].deviceState.4 THEN // EC_DEVICE_STATE_ERROR
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'State machine error in the EtherCAT slave');
END_IF

IF SlavesState[Slave].deviceState.5 THEN // EC_DEVICE_STATE_INVALID_VPRS
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'Invalid vendor ID');
END_IF

IF SlavesState[Slave].deviceState.6 THEN // EC_DEVICE_STATE_INITCMD_ERROR
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'Error during sending of initialization commands');
END_IF

IF SlavesState[Slave].deviceState.7 THEN // EC_DEVICE_STATE_DISABLED
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'Slave is disabled');
END_IF

//_____________________________________________________________________________________________________

(* Link States *)
IF SlavesState[Slave].linkState.0 THEN // EC_LINK_STATE_NOT_PRESENT
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'No EtherCAT communication with the EtherCAT slave');
END_IF

IF SlavesState[Slave].linkState.1 THEN // EC_LINK_STATE_LINK_WITHOUT_COMM
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'Error AT port X');
END_IF

IF SlavesState[Slave].linkState.2 THEN // EC_LINK_STATE_MISSING_LINK
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'Missing link AT port X');
END_IF

IF SlavesState[Slave].linkState.3 THEN // EC_LINK_STATE_ADDITIONAL_LINK
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'Additional link AT port X');
END_IF

(* Additional State Bits *)
IF SlavesState[Slave].linkState.4 THEN // EC_LINK_STATE_PORT_A
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'Port 0');
END_IF

IF SlavesState[Slave].linkState.5 THEN // EC_LINK_STATE_PORT_B
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'Port 1');
END_IF

IF SlavesState[Slave].linkState.6 THEN // EC_LINK_STATE_PORT_C
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'Port 2');
END_IF

IF SlavesState[Slave].linkState.7 THEN // EC_LINK_STATE_PORT_D
	LookupSlaveState := CONCAT(LookupSlaveState, ' - ');
	LookupSlaveState := CONCAT(LookupSlaveState, 'Port 3');
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="MasterAmsNetId" Id="{e8191ac3-4bf6-4260-9bd6-73f87a18d477}" FolderPath="Diagnostic\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY MasterAmsNetId : T_AmsNetId]]></Declaration>
      <Get Name="Get" Id="{cd0137ef-9d12-42f0-957e-c261bf7bfde0}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[MasterAmsNetId := _MasterAmsNetId;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="MasterState" Id="{9cab473b-cce9-4d54-aadc-9cb8f27d7c22}" FolderPath="_Internal\">
      <Declaration><![CDATA[METHOD PROTECTED MasterState : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (LastMasterState <> EcMaster.DevState) AND (EcMaster.DevState <> 0) AND (EcMaster.SlaveCount < EcMaster.CfgSlaveCount) THEN
	IF EcMaster.DevState <> 0 THEN
		IF EventProvider <> 0 THEN
			EventProvider.RaiseEtherCatDiagnosticEvent(E_EtherCatMaster.MasterError, LookupMasterState(EcMaster.DevState));
		END_IF

		_Error	 := TRUE;
		_ErrorId := EcMaster.DevState;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RegisterEventProvider" Id="{3c83d169-3fdc-4962-9915-fa3129e33709}" FolderPath="Diagnostic\">
      <Declaration><![CDATA[METHOD RegisterEventProvider
VAR_INPUT
	EventProvider : I_EtherCatDiagnosticEventProvider;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.EventProvider := EventProvider;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{ee94ff59-f1a9-498f-aa45-98618a0c1c63}" FolderPath="Resettable\">
      <Declaration><![CDATA[METHOD Reset]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF EventProvider <> 0 THEN
	EventProvider.Reset();
END_IF

LastMasterState := 0;
LastChangeCount := 0;
LastSlaveCount	:= 0;
_Error			:= FALSE;
_ErrorId		:= 0;
SlaveSequence	:= 0;
RunSlaveDiag	:= FALSE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Simulated" Id="{aa6d861b-93bc-45a2-853a-7b9fd1cc7e49}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Simulated : BOOL]]></Declaration>
      <Get Name="Get" Id="{cc7febd7-07c6-461f-ab58-a79f9f2f810a}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Simulated := _Simulated;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{6f7e37d4-83d8-4e75-a97b-cc1689d77fd4}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_Simulated := Simulated;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="SlaveCount" Id="{bfc36d0d-748f-4330-826a-e7f9a3550123}" FolderPath="Diagnostic\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SlaveCount : UINT]]></Declaration>
      <Get Name="Get" Id="{8ba43fb2-7af8-4a46-9c1a-f74e5d772835}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[SlaveCount := EcMaster.SlaveCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SlaveState" Id="{483b8cf5-1244-4799-bded-62d3800d6efa}" FolderPath="_Internal\">
      <Declaration><![CDATA[METHOD PROTECTED SlaveState : BOOL
VAR_INST
	DiagByte	 : BYTE;
	BitMaskDiag	 : BYTE := 16#0F;
	FaultedSlave : UINT;
	i, j		 : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE SlaveSequence OF
	(* Wait for start *)
	0:
		GetAllSlaveStates.bExecute	  := FALSE;
		GetSlaveTopologyInfo.bExecute := FALSE;
		IF RunSlaveDiag THEN
			RunSlaveDiag := FALSE;
			NextStep(SlaveSequence);
		END_IF

	(* Update Topology*)
	10:
		GetSlaveTopologyInfo.bExecute := TRUE;
		IF GetSlaveTopologyInfo.bBusy THEN
			NextMinorStep(SlaveSequence);
		END_IF

	11:
		IF NOT GetSlaveTopologyInfo.bBusy AND NOT GetSlaveTopologyInfo.bError THEN
			NextStep(SlaveSequence);
		END_IF

		IF GetSlaveTopologyInfo.bError THEN
			SlaveSequence := 999;
		END_IF

	(* Read Slave States *)
	20:
		GetAllSlaveStates.bExecute := TRUE;
		IF GetAllSlaveStates.bBusy THEN
			NextMinorStep(SlaveSequence);
		END_IF

	21:
		IF NOT GetAllSlaveStates.bBusy AND NOT GetAllSlaveStates.bError THEN
			NextStep(SlaveSequence);
		END_IF

		IF GetAllSlaveStates.bError THEN
			SlaveSequence := 999;
		END_IF

	(* Evaluate Slave Error *)
	30:
		FOR FaultedSlave := 0 TO (EcMaster.CfgSlaveCount - 1) DO
			BitMaskDiag := 16#0F;
			DiagByte	:= SlavesState[FaultedSlave].deviceState AND BitMaskDiag;
			IF DiagByte <> EC_DEVICE_STATE_OP AND SlaveTopologyInfo[FaultedSlave].nStatusBits.4 = FALSE THEN // No error if hotconnect
				IF SlavesState[FaultedSlave].deviceState.7 THEN												 // Slave is Disabled - warning only
					IF EventProvider <> 0 THEN
						EventProvider.RaiseEtherCatDiagnosticEvent(E_EtherCatMaster.SlaveDisabled, ConfiguredSlaveInfo[FaultedSlave].sName);
					END_IF
				ELSE
					IF EventProvider <> 0 THEN
						EventProvider.RaiseEtherCatDiagnosticEvent(E_EtherCatMaster.SlaveError, ConfiguredSlaveInfo[FaultedSlave].sName, LookupSlaveState(FaultedSlave));
					END_IF

					_Error	 := TRUE;
					_ErrorId := FaultedSlave;
					EXIT;
				END_IF
			END_IF

			BitMaskDiag := 16#0F;
			DiagByte	:= SlavesState[FaultedSlave].linkState AND BitMaskDiag;
			IF DiagByte <> EC_LINK_STATE_OK AND SlaveTopologyInfo[FaultedSlave].nStatusBits.4 = FALSE THEN // Next slave is in hotconnect group, no error
				IF EventProvider <> 0 THEN
					EventProvider.RaiseEtherCatDiagnosticEvent(E_EtherCatMaster.SlaveError, ConfiguredSlaveInfo[FaultedSlave].sName, LookupSlaveState(FaultedSlave));
				END_IF

				_Error	 := TRUE;
				_ErrorId := FaultedSlave;
				EXIT;
			END_IF
		END_FOR

		NextStep(SlaveSequence);

	(* Build Slaves *)
	40:
		FOR i := 0 TO (EcMaster.CfgSlaveCount - 1) DO
			FOR j := 0 TO (SYNC_UNITS - 1) DO
				IF SyncUnit[j].IsTerminalPartOfSyncUnit(ConfiguredSlaveInfo[i].nAddr) THEN
					IoDevice[i].SyncUnit := SyncUnit[j];
				END_IF
			END_FOR
		END_FOR

		SlaveSequence := 0;

	(* Sequence Error *)
	999:
		_ErrorId	  := 999;
		SlaveSequence := 0;
END_CASE]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>