<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="SyncUnitTask" Id="{c7a74bd5-89aa-04ee-11e8-939f4b4902b2}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'no_explicit_call' := 'do not call this POU directly'}
FUNCTION_BLOCK FINAL SyncUnitTask EXTENDS CyclicComponent IMPLEMENTS I_SyncUnitTask, I_Initializable, I_TaskResult, I_Simulatable
VAR
	SyncUnitTaskInfo AT %I* : ST_EtherCatSyncUnitTaskInfo;
	_SlaveCount				: UINT;
	_IsHotConnect			: BOOL;
	_SlavesResolved			: BOOL;
	// Resolves sync unit slave addresses to configured slaves (implemented by EtherCatMaster)
	Registry				: I_EcSlaveRegistry;
	SyncUnitSlaveAddresses	: ARRAY[0..MAX_EC_SLAVES] OF UINT;
	// TRUE at the configured slave index of every slave in this sync unit (filled by the resolve pass)
	MemberByIndex			: ARRAY[0..MAX_EC_SLAVES] OF BOOL;
END_VAR

VAR
	{attribute 'hide'}
	_Initialized : BOOL;
	{attribute 'hide'}
	_Error : BOOL;
	{attribute 'hide'}
	_Busy : BOOL;
	{attribute 'hide'}
	_ErrorId : UDINT;
	{attribute 'hide'}
	_Simulated : BOOL;
END_VAR

VAR
	SyncUnitState			  : UDINT := READ_SLAVES;
	ScanIndex				  : UINT;  // position of the multi-cycle resolve pass
	WaitCycles				  : UDINT; // ADS watchdog and retry delay
	ReadErrorLogged			  : BOOL;
	SlaveMessagePartA		  : STRING;
	SlaveMessagePartB		  : STRING;
	_EventProvider			  : I_EtherCatDiagnosticEventProvider;
	EcGetAllSyncUnitSlaveAddr : FB_EcGetAllSyncUnitSlaveAddr;
END_VAR

VAR CONSTANT
	ERROR_READ_SLAVE_NAMES	   : UDINT := 1;
	ERROR_REGISTER_SYNC_UNIT   : UDINT := 2;
	ERROR_VALID_DATA_SYNC_UNIT : UDINT := 3;
	STRING_LEN				   : INT   := 80;
	SYNC_UNIT_ALARM_MAX		   : UINT  := 3;

	//
	READ_SLAVES			  : UDINT := 0;
	READ_SLAVES_DONE	  : UDINT := 1;
	SYNC_UNIT_OK		  : UDINT := 2;
	RESOLVE_SLAVES		  : UDINT := 3;
	WORKING_COUNTER_ERROR : UDINT := 4;
	READ_ERROR			  : UDINT := 5;
	READ_RETRY_WAIT		  : UDINT := 6;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Initialize" Id="{e2c06de2-8913-0bc2-3171-b18ce4f50a67}" />
    <Folder Name="SyncUnitTask" Id="{9ecda84e-6ec3-04ab-3827-af113ad3e658}" />
    <Folder Name="TaskResult" Id="{408e4c43-c95b-43fa-b009-f6e408f68e00}" />
    <Method Name="AppendSlaveName" Id="{5938d094-8abf-4dcb-aedf-9efb74bfd17e}" FolderPath="SyncUnitTask\">
      <Declaration><![CDATA[// Appends the name to the two event message parts while they have room (STRING_LEN each).
METHOD PRIVATE AppendSlaveName
VAR_INPUT
	SlaveName : STRING;
END_VAR

VAR
	Entry : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF LEN(SlaveName) = 0 THEN
	RETURN;
END_IF

Entry := CONCAT(SlaveName, ', ');
IF (LEN(Entry) + LEN(SlaveMessagePartA)) <= STRING_LEN THEN
	SlaveMessagePartA := CONCAT(SlaveMessagePartA, Entry);
ELSIF (LEN(Entry) + LEN(SlaveMessagePartB)) <= STRING_LEN THEN
	SlaveMessagePartB := CONCAT(SlaveMessagePartB, Entry);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="Busy" Id="{781d128d-30d4-4fb1-b0a7-ba9b7b332088}" FolderPath="TaskResult\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Busy : BOOL]]></Declaration>
      <Get Name="Get" Id="{1497cb35-6d83-4303-bf83-f234ce6dbff5}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Busy := _Busy;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CyclicLogic" Id="{61b2331c-0631-0abf-1495-53eeaf453480}">
      <Declaration><![CDATA[METHOD PUBLIC CyclicLogic
VAR
	k	 : UINT;
	Addr : UINT;
	Idx	 : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Initialized THEN
	Initialize();
	RETURN;
END_IF

IF Simulated THEN
	RETURN;
END_IF

(* The slave list of a sync unit is configuration data: it is read once (retried on failure) and
   never re-read on working counter recovery. The buffer is sized to the configured slave count. *)
EcGetAllSyncUnitSlaveAddr(sNetId	:= '',
						  nObjectId := SyncUnitTaskInfo.ObjectId,
						  pAddrBuf	:= ADR(SyncUnitSlaveAddresses),
						  cbBufLen	:= SIZEOF(UINT) * MIN(Registry.ConfiguredSlaveCount, MAX_EC_SLAVES + 1),
						  tTimeout	:= T#5S);

EcGetAllSyncUnitSlaveAddr.bExecute := FALSE;
CASE SyncUnitState OF
	READ_SLAVES:
		EcGetAllSyncUnitSlaveAddr.bExecute := TRUE;
		WaitCycles						   := 0;
		SyncUnitState					   := READ_SLAVES_DONE;

	READ_SLAVES_DONE:
		IF EcGetAllSyncUnitSlaveAddr.bBusy THEN
			WaitCycles := WaitCycles + 1;
			IF WaitCycles > ADS_WAIT_CYCLES THEN
				SyncUnitState := READ_ERROR;
			END_IF
		ELSIF EcGetAllSyncUnitSlaveAddr.bError THEN
			SyncUnitState := READ_ERROR;
		ELSE
			_SlaveCount		  := EcGetAllSyncUnitSlaveAddr.nSlaves;
			ScanIndex		  := 0;
			_IsHotConnect	  := FALSE;
			SlaveMessagePartA := '';
			SlaveMessagePartB := '';
			MEMSET(ADR(MemberByIndex), 0, SIZEOF(MemberByIndex));
			SyncUnitState	  := RESOLVE_SLAVES;
		END_IF

	RESOLVE_SLAVES:
		(* Map every address to its configured slave through the slave registry of the master:
		   O(n) in total, SLAVES_PER_CYCLE slaves per cycle. *)
		FOR k := 1 TO SLAVES_PER_CYCLE DO
			IF ScanIndex >= _SlaveCount THEN
				EXIT;
			END_IF

			Addr := SyncUnitSlaveAddresses[ScanIndex];
			IF Addr <> 0 THEN
				Idx := Registry.GetSlaveIndexByAddr(Addr);
				IF Idx >= 0 THEN
					MemberByIndex[Idx] := TRUE;
					_IsHotConnect	   := _IsHotConnect OR Registry.IsHotConnectMember(DINT_TO_UINT(Idx));
					AppendSlaveName(Registry.GetSlaveName(DINT_TO_UINT(Idx)));
				END_IF
			END_IF

			ScanIndex := ScanIndex + 1;
		END_FOR

		IF ScanIndex >= _SlaveCount THEN
			_SlavesResolved := TRUE;
			SyncUnitState	:= SYNC_UNIT_OK;
		END_IF

	SYNC_UNIT_OK:
		IF SyncUnitTaskInfo.WcState THEN
			SyncUnitState := WORKING_COUNTER_ERROR;
			_Busy		  := TRUE;
		ELSE
			_Error	 := FALSE;
			_ErrorID := 0;
			_Busy	 := FALSE;
		END_IF

	WORKING_COUNTER_ERROR:
		_Busy	 := FALSE;
		_Error	 := TRUE;
		_ErrorID := ERROR_VALID_DATA_SYNC_UNIT;
		IF _EventProvider <> 0 THEN
			IF _IsHotConnect THEN
				_EventProvider.RaiseSyncUnitEvent(E_SyncUnit.SyncUnitWarning,
												  _Name,
												  SlaveMessagePartA,
												  SlaveMessagePartB);
			ELSE
				_EventProvider.RaiseSyncUnitEvent(E_SyncUnit.SyncUnitError,
												  _Name,
												  SlaveMessagePartA,
												  SlaveMessagePartB);
			END_IF
		END_IF

		IF NOT SyncUnitTaskInfo.WcState THEN
			IF _EventProvider <> 0 THEN
				_EventProvider.Reset();
			END_IF

			SyncUnitState := SYNC_UNIT_OK; // membership does not change on WC recovery: no re-read
		END_IF

	READ_ERROR:
		IF NOT ReadErrorLogged THEN
			Trace.LogMessage(Name, CONCAT('Sync Unit slave addresses could not be read! Error ID: ', TO_STRING(EcGetAllSyncUnitSlaveAddr.nErrId)));
			ReadErrorLogged := TRUE;
		END_IF

		_Error		  := TRUE;
		_ErrorID	  := ERROR_READ_SLAVE_NAMES;
		WaitCycles	  := 0;
		SyncUnitState := READ_RETRY_WAIT;

	READ_RETRY_WAIT:
		WaitCycles := WaitCycles + 1;
		IF WaitCycles > ADS_WAIT_CYCLES THEN
			SyncUnitState := READ_SLAVES;
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="Error" Id="{d5ac5e36-0c3d-42f5-a469-dde715ad6684}" FolderPath="TaskResult\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Error : BOOL]]></Declaration>
      <Get Name="Get" Id="{3335df65-f613-4928-b7b9-292f91e8d8ae}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Error := _Error;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ErrorId" Id="{b5bba318-c537-4ad2-a824-92e6feb9beca}" FolderPath="TaskResult\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ErrorId : UDINT]]></Declaration>
      <Get Name="Get" Id="{7111fec5-ee06-46aa-9769-9d986bc93833}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[ErrorId := _ErrorId;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="EventProvider" Id="{82545f18-ec96-4985-b85d-367c717520bc}">
      <Declaration><![CDATA[PROPERTY EventProvider : I_EtherCatDiagnosticEventProvider]]></Declaration>
      <Set Name="Set" Id="{8810f062-61df-4822-9605-4ea64505714f}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_EventProvider := EventProvider;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="FB_Init" Id="{d6d2cead-fe48-43a4-9be6-f6b4dc3d00c6}">
      <Declaration><![CDATA[(*FB_Init is always available implicitly and it is used primarily for initialization.
The return value is not evaluated. For a specific influence, you can also declare the
methods explicitly and provide additional code there with the standard initialization
code. You can evaluate the return value.*)
METHOD FB_Init : BOOL
VAR_INPUT
	(* TRUE: the retain variables are initialized (reset warm / reset cold)*)
	bInitRetains : BOOL;

	(* TRUE: the instance will be copied to the copy code afterward (online change)   *)
	bInCopyCode			: BOOL;
	Name	 : T_MaxString;
	Registry : I_EcSlaveRegistry;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.Registry := Registry;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initialize" Id="{c396d1a2-ac47-0c27-2331-87a75aa82632}" FolderPath="Initialize\">
      <Declaration><![CDATA[METHOD Initialize
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _Error AND NOT Simulated AND F_GetMappingStatus(ADR(SyncUnitTaskInfo.ObjectId), SIZEOF(SyncUnitTaskInfo.ObjectId)) = EplcMappingStatus.MS_Unmapped THEN
	_Error := TRUE;
	Trace.LogMessage(Name, 'Init Failed - SyncUnitTaskInfo.ObjectId not mapped to the sync unit diagnostic!');
END_IF

IF NOT _Error AND NOT Simulated AND F_GetMappingStatus(ADR(SyncUnitTaskInfo.SlaveCount), SIZEOF(SyncUnitTaskInfo.SlaveCount)) = EplcMappingStatus.MS_Unmapped THEN
	_Error := TRUE;
	Trace.LogMessage(Name, 'Init Failed - SyncUnitTaskInfo.SlaveCount not mapped to the sync unit diagnostic!');
END_IF

IF NOT _Error AND NOT Simulated AND F_GetMappingStatus(ADR(SyncUnitTaskInfo.State), SIZEOF(SyncUnitTaskInfo.State)) = EplcMappingStatus.MS_Unmapped THEN
	_Error := TRUE;
	Trace.LogMessage(Name, 'Init Failed - SyncUnitTaskInfo.State not mapped to the sync unit diagnostic!');
END_IF

IF NOT _Error AND NOT Simulated AND F_GetMappingStatus(ADR(SyncUnitTaskInfo.WcState), SIZEOF(SyncUnitTaskInfo.WcState)) = EplcMappingStatus.MS_Unmapped THEN
	_Error := TRUE;
	Trace.LogMessage(Name, 'Init Failed - SyncUnitTaskInfo.WcState not mapped to the sync unit diagnostic!');
END_IF

IF _Error THEN
	RETURN;
END_IF

IF Simulated THEN
	_Initialized := TRUE;
	RETURN;
END_IF

F_EcGetSyncUnitName(SyncUnitTaskInfo.ObjectId, sSyncUnitName => _Name);
_Initialized := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="Initialized" Id="{f865ce62-ae08-4bf8-b0dc-ea02273b2c97}" FolderPath="Initialize\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Initialized : BOOL]]></Declaration>
      <Get Name="Get" Id="{57a1f872-f645-4ec7-8ae5-9da0776a42d7}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Initialized := _Initialized;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{fb9d4752-358a-4e38-82dd-5341dc60f16c}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_Initialized := Initialized;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="IoDataValid" Id="{6c231f20-53a4-4778-903c-ae0d353408df}" FolderPath="SyncUnitTask\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY IoDataValid : BOOL]]></Declaration>
      <Get Name="Get" Id="{591c4e27-ab51-4f4d-956a-1fcfd680cedc}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[IoDataValid := NOT SyncUnitTaskInfo.WcState;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsHotConnect" Id="{293d2159-e010-034c-07aa-3ccb3cd64192}" FolderPath="SyncUnitTask\">
      <Declaration><![CDATA[// TRUE if at least one slave of this sync unit belongs to a hot connect group.
{attribute 'monitoring' := 'call'}
PROPERTY IsHotConnect : BOOL]]></Declaration>
      <Get Name="Get" Id="{1ff3282e-a7b2-0f15-1b5c-4f7ccb374a97}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsHotConnect := _IsHotConnect;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="IsTerminalPartOfSyncUnit" Id="{04f70e98-80b6-4853-9fa9-735db194cd89}" FolderPath="SyncUnitTask\">
      <Declaration><![CDATA[// O(1) once the slave list is resolved (SlavesResolved).
METHOD IsTerminalPartOfSyncUnit : BOOL
VAR_INPUT
	Addr : UINT;
END_VAR

VAR
	Idx : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Idx						 := Registry.GetSlaveIndexByAddr(Addr);
IsTerminalPartOfSyncUnit := (Idx >= 0) AND_THEN MemberByIndex[Idx];]]></ST>
      </Implementation>
    </Method>
    <Property Name="Simulated" Id="{28507140-3303-4f90-8c85-ee2f70eef988}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Simulated : BOOL]]></Declaration>
      <Get Name="Get" Id="{0642729d-4d21-4868-897c-017028e95ea2}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Simulated := _Simulated;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{9f5cb5d0-12b6-4d54-9042-4f2e711edbda}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_Simulated := Simulated;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="SlaveAddress" Id="{eb050526-dd81-4f5c-985d-33c7db4ccb5f}" FolderPath="SyncUnitTask\">
      <Declaration><![CDATA[// EtherCAT address of the slave at Position (0..SlaveCount-1) in this sync unit; 0 if out of range.
METHOD SlaveAddress : UINT
VAR_INPUT
	Position : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Position < _SlaveCount THEN
	SlaveAddress := SyncUnitSlaveAddresses[Position];
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="SlaveCount" Id="{ed198b01-8178-08bb-18c7-2d8c6088f441}" FolderPath="SyncUnitTask\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY PUBLIC SlaveCount : UINT]]></Declaration>
      <Get Name="Get" Id="{b3c50076-5bd6-02e1-0543-7f3bb0682e6e}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[SlaveCount := _SlaveCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SlavesResolved" Id="{4df048de-86c2-444b-ac3b-46caa5143b0b}" FolderPath="SyncUnitTask\">
      <Declaration><![CDATA[// TRUE once the slave list has been read and mapped to the configured slaves.
{attribute 'monitoring' := 'call'}
PROPERTY SlavesResolved : BOOL]]></Declaration>
      <Get Name="Get" Id="{8a25e2e4-7e89-4ad9-906b-2a380d4f0c09}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[SlavesResolved := _SlavesResolved;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
