        </Implementation>
      </Get>
    </Property>
    <Method Name="IsTerminalPartOfSyncUnit" Id="{04f70e98-80b6-4853-9fa9-735db194cd89}" FolderPath="SyncUnitTask\">
      <Declaration><![CDATA[METHOD IsTerminalPartOfSyncUnit : BOOL
VAR_INPUT
	Addr : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO (_SlaveCount - 1) DO
	IF SyncUnitSlaveAddresses[i] = Addr THEN
		IsTerminalPartOfSyncUnit := TRUE;
		EXIT;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
