        </Implementation>
      </Set>
    </Property>
    <Property Name="IoDataValid" Id="{6c231f20-53a4-4778-903c-ae0d353408df}" FolderPath="SyncUnitTask\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY IoDataValid : BOOL]]></Declaration>
      <Get Name="Get" Id="{591c4e27-ab51-4f4d-956a-1fcfd680cedc}">
