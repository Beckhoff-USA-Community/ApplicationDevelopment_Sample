END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[IoDataValid := NOT SyncUnitTaskInfo.WcState;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsHotConnect" Id="{293d2159-e010-034c-07aa-3ccb3cd64192}" FolderPath="SyncUnitTask\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY IsHotConnect : BOOL]]></Declaration>
      <Get Name="Get" Id="{1ff3282e-a7b2-0f15-1b5c-4f7ccb374a97}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
