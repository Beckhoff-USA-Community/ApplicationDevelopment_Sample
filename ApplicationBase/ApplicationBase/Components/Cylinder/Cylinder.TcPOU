    <Method Name="Retract" Id="{7fd5f0a8-b267-430e-829d-ce85282c13bf}" FolderPath="Cylinder\">
      <Declaration><![CDATA[METHOD Retract]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF CylinderState <> E_CylinderState.Retracted THEN
	ExtendOutput.On	 := FALSE;
	RetractOutput.On := TRUE;
	CylinderState	 := E_CylinderState.Retracting;
END_IF]]></ST>
      </Implementation>
    </Method>
