    <Method Name="Extend" Id="{7c6e8466-4304-4e3e-a8fb-07c8dbc215ee}" FolderPath="Cylinder\">
      <Declaration><![CDATA[METHOD Extend]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF CylinderState <> E_CylinderState.Extended THEN
	RetractOutput.On := FALSE;
	ExtendOutput.On	 := TRUE;
	CylinderState	 := E_CylinderState.Extending;
END_IF]]></ST>
      </Implementation>
    </Method>
