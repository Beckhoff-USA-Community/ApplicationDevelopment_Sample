<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="Cylinder" Id="{63fca959-c060-4d6e-b17b-ca34044559a9}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Cylinder EXTENDS CyclicComponent IMPLEMENTS I_Cylinder
VAR
	ExtendOutput   : I_DigitalOutput;
	RetractOutput  : I_DigitalOutput;
	ExtendedInput  : I_DigitalInput;
	RetractedInput : I_DigitalInput;
	CylinderState  : E_CylinderState;
	{attribute 'hide'}
	_ExtendTimeout : TIME;
	{attribute 'hide'}
	_RetractTimeout : TIME;
	{attribute 'hide'}
	_Busy : BOOL;
	{attribute 'hide'}
	_Error : BOOL;
	{attribute 'hide'}
	_ErrorId : UDINT;
END_VAR

VAR
	{attribute 'hide'}
	NullEO : BOOL;
	{attribute 'hide'}
	NullExtendOutput : DigitalOutput('Null Digital Output', NullEO);
	{attribute 'hide'}
	NullRO : BOOL;
	{attribute 'hide'}
	NullRetractOutput : DigitalOutput('Null Digital Output', NullRO);
	{attribute 'hide'}
	NullEI : BOOL;
	{attribute 'hide'}
	NullExtendedInput : DigitalInput_NO('Null Digital Input', NullEI);
	{attribute 'hide'}
	NullRI : BOOL;
	{attribute 'hide'}
	NullRetractedInput : DigitalInput_NO('Null Digital Input', NullRI);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
