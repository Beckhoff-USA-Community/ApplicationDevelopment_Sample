    <Method Name="FB_Init" Id="{ef20c057-8c4a-4d03-b7fc-407d3f8dd441}">
      <Declaration><![CDATA[//FB_Init is always available implicitly and it is used primarily for initialization.

//The return value is not evaluated. For a specific influence, you can also declare the

//methods explicitly and provide additional code there with the standard initialization

//code. You can evaluate the return value.
METHOD FB_Init : BOOL
VAR_INPUT
	bInitRetains   : BOOL; // TRUE: the retain variables are initialized (reset warm / reset cold)
	bInCopyCode	   : BOOL; // TRUE: the instance will be copied to the copy code afterward (online change)  
	Name		   : T_MaxString;
	ExtendOutput   : I_DigitalOutput;
	RetractOutput  : I_DigitalOutput;
	ExtendedInput  : I_DigitalInput;
	RetractedInput : I_DigitalInput;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ExtendOutput = 0 THEN
	THIS^.ExtendOutput := NullExtendOutput;
ELSE
	THIS^.ExtendOutput := ExtendOutput;
END_IF

IF RetractOutput = 0 THEN
	THIS^.RetractOutput := NullRetractOutput;
ELSE
	THIS^.RetractOutput := RetractOutput;
END_IF

IF ExtendedInput = 0 THEN
	THIS^.ExtendedInput := NullExtendedInput;
ELSE
	THIS^.ExtendedInput := ExtendedInput;
END_IF

IF RetractedInput = 0 THEN
	THIS^.RetractedInput := NullRetractedInput;
ELSE
	THIS^.RetractedInput := RetractedInput;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{62478212-4312-471c-b74d-d3370f361e74}" FolderPath="Resettable\">
