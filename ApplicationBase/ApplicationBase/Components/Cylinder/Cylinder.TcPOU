      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Busy : BOOL]]></Declaration>
      <Get Name="Get" Id="{5b1df233-0cef-433b-8bf0-a7ba4a306ddf}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Busy := _Busy;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CyclicLogic" Id="{7b2ef387-258c-42f0-b8d5-38e284d8b531}" FolderPath="Cyclic\">
      <Declaration><![CDATA[METHOD CyclicLogic
VAR_INST
	TON_RetractTimeout : TON;
	TON_ExtendTimeout  : TON;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[NullEI := ExtendOutput.On;
NullRI := RetractOutput.On;
CASE CylinderState OF
	E_CylinderState.Undefined:
		IF ExtendedInput.IsActive THEN
			CylinderState := E_CylinderState.Extended;
		ELSIF RetractedInput.IsActive THEN
			CylinderState := E_CylinderState.Retracted;
		END_IF

	E_CylinderState.Extending:
		IF ExtendedInput.IsActive THEN
			CylinderState := E_CylinderState.Extended;
		END_IF

	E_CylinderState.Retracting:
		IF RetractedInput.IsActive THEN
			CylinderState := E_CylinderState.Retracted;
		END_IF
END_CASE

IF ExtendedInput.IsActive AND RetractedInput.IsActive THEN
	CylinderState := E_CylinderState.Undefined;
END_IF

// Generate Errors
IF CylinderState = E_CylinderState.Extending THEN
	IF _ExtendTimeout > T#0.0S THEN
		TON_ExtendTimeout(IN := TRUE, PT := _ExtendTimeout);
		IF TON_ExtendTimeout.Q THEN
			_Error	 := TRUE;
			_ErrorId := E_CylinderErrorId.ExtendTimeout;
		END_IF
	END_IF
ELSE
	TON_ExtendTimeout(IN := FALSE);
END_IF

IF CylinderState = E_CylinderState.Retracting THEN
	IF _RetractTimeout > T#0.0S THEN
		TON_RetractTimeout(IN := TRUE, PT := _RetractTimeout);
		IF TON_RetractTimeout.Q THEN
			_Error	 := TRUE;
			_ErrorId := E_CylinderErrorId.RetractTimeout;
		END_IF
	END_IF
ELSE
	TON_RetractTimeout(IN := FALSE);
END_IF

IF CylinderState = E_CylinderState.Extended THEN
	IF NOT ExtendedInput.IsActive THEN
		CylinderState := E_CylinderState.Undefined;
		_Error		  := TRUE;
		_ErrorId	  := E_CylinderErrorId.ExtendedPlausibility;
	END_IF
END_IF

IF CylinderState = E_CylinderState.Retracted THEN
	IF NOT RetractedInput.IsActive THEN
		CylinderState := E_CylinderState.Undefined;
		_Error		  := TRUE;
		_ErrorId	  := E_CylinderErrorId.RetractedPlausibility;
	END_IF
END_IF

IF ExtendedInput.IsActive AND RetractedInput.IsActive THEN
	CylinderState := E_CylinderState.Undefined;
	_Error		  := TRUE;
	_ErrorId	  := E_CylinderErrorId.BothSensorsActive;
END_IF

_Busy := (CylinderState = E_CylinderState.Extending) OR (CylinderState = E_CylinderState.Retracting);]]></ST>
      </Implementation>
    </Method>
