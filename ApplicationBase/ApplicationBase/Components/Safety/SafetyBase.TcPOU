  <POU Name="SafetyBase" Id="{2e5c85ad-93c6-4cb6-9069-cdd30a70691e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK SafetyBase EXTENDS CyclicComponent IMPLEMENTS I_SafetyBase
