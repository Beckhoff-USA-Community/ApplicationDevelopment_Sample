    <Method Name="CyclicLogic" Id="{e2439ed2-b1db-487e-a7b1-52bc020d523b}" FolderPath="Cyclic\">
      <Declaration><![CDATA[METHOD CyclicLogic
VAR_INST
	LinkError : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT LinkError AND NOT Simulated AND (F_GetMappingStatus(ADR(InfoData), SIZEOF(InfoData)) = EplcMappingStatus.MS_Unmapped) THEN
	LinkError := TRUE;
	Trace.LogMessage(Name, 'Not mapped to Safety, no diagnostics available!');
END_IF

IF _ResetFunction <> 0 THEN
	_ResetFunction.CyclicLogic();
END_IF]]></ST>
      </Implementation>
    </Method>
