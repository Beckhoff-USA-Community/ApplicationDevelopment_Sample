<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.21">
  <POU Name="SafetyModule" Id="{1cc953a6-bf43-4bbb-a475-b0a5baac31f8}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK SafetyModule EXTENDS Module IMPLEMENTS I_SafetyModule
VAR
	SequenceState			 : UDINT;
	ResetRequestedThisScan	 : BOOL;
	TwinSAFEResetDelay		 : TON;
	SafetyPLC_WcState AT %I* : BOOL;
	SafetyPLC_AmsAddr AT %I* : AMSADDR;
	_SafetyPlcCoE			 : CoeDevice('Safety PLC') := (AdsAddr := SafetyPLC_AmsAddr);
	_SafetyAddressInfo		 : ST_SafetyAddressInfo;
END_VAR

VAR
	GetComponentsTaskResultVisitor : GetComponentsTaskResultVisitor;
	SetSafetySimulationVisitor	   : SetSafetySimulationVisitor;
	SafetyOkVisitor				   : SafetyOkVisitor;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Cyclic" Id="{c4981cda-16bc-470e-af5a-e1f35b9cbe3a}" />
    <Folder Name="Initialize" Id="{b7f8fc5e-f1dd-449c-88e6-e56a167c5456}" />
    <Folder Name="Safety Simulation" Id="{b6be3fc2-38ea-4cce-a2e8-ac2d4e5aa0f0}" />
    <Folder Name="Task Result" Id="{09b84b21-0c39-426a-8f3a-6012a0df5c4b}" />
    <Method Name="AddSafetyComponent" Id="{315a3e35-02f8-4038-a83e-8559fb0c282c}">
      <Declaration><![CDATA[METHOD AddSafetyComponent
VAR_INPUT
	Component : I_SafetyBase;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Component.RegisterWithParent(THIS^);]]></ST>
      </Implementation>
    </Method>
    <Property Name="Busy" Id="{6e50ddf1-36f1-424c-b8c0-b3de7809d002}" FolderPath="Task Result\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Busy : BOOL]]></Declaration>
      <Get Name="Get" Id="{888f4230-250d-412e-aaef-0f9027f443e7}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[// State 30 (reset complete, latched) is not busy so a polling caller sees completion
Busy := (SequenceState <> 0) AND (SequenceState <> 30);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Error" Id="{d63da2b3-a3b3-462b-8efa-6c9d66507f85}" FolderPath="Task Result\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Error : BOOL]]></Declaration>
      <Get Name="Get" Id="{b376ee6e-7808-4d6e-a7ec-eb49abc5dba2}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Error := GetComponentsTaskResultVisitor.Error;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ErrorId" Id="{b010b629-240a-47a6-a958-23fddcc188ff}" FolderPath="Task Result\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ErrorId : UDINT]]></Declaration>
      <Get Name="Get" Id="{abe0d089-4611-4a9d-b922-c4ed4ecab6c5}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[ErrorId := GetComponentsTaskResultVisitor.ErrorId;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FB_Init" Id="{078d27df-2311-4911-939b-f79b787791f0}">
      <Declaration><![CDATA[(*FB_Init is always available implicitly and it is used primarily for initialization.
The return value is not evaluated. For a specific influence, you can also declare the
methods explicitly and provide additional code there with the standard initialization
code. You can evaluate the return value.*)
METHOD FB_Init : BOOL
VAR_INPUT
	(* TRUE: the retain variables are initialized (reset warm / reset cold)*)
	bInitRetains : BOOL;

	(* TRUE: the instance will be copied to the copy code afterward (online change)   *)
	bInCopyCode : BOOL;
	Name		: T_MaxString;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SafetyPlcCoE.RegisterWithParent(THIS^);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initializing" Id="{3b163022-1b14-4452-8618-d5f3ee9cb107}" FolderPath="Initialize\">
      <Declaration><![CDATA[(* This Module will be done initialize when ModuleInitialized := TRUE;, subequently all subitems will be called to be initialized *)
METHOD Initializing]]></Declaration>
      <Implementation>
        <ST><![CDATA[_SafetyPlcCoE.CyclicLogic();
CASE SequenceState OF
	0:
		IF F_GetMappingStatus(ADR(SafetyPLC_WcState), SIZEOF(SafetyPLC_WcState)) = EplcMappingStatus.MS_Unmapped OR F_GetMappingStatus(ADR(SafetyPLC_AmsAddr), SIZEOF(SafetyPLC_AmsAddr)) = EplcMappingStatus.MS_Unmapped THEN
			SequenceState := 100;
			Trace.LogMessage(Name, 'Safety PLC not mapped, info will not be read!');
		ELSE
			SequenceState := SequenceState + 10;
		END_IF

	10:
		IF NOT SafetyPLC_WcState THEN
			SequenceState := SequenceState + 10;
		END_IF

	20:
		SafetyPlcCoE.Read(16#F980,
						  1,
						  ADR(_SafetyAddressInfo.FSoEAddress),
						  SIZEOF(_SafetyAddressInfo.FSoEAddress));

		SequenceState := SequenceState + 1;

	21:
		IF NOT SafetyPlcCoE.Error AND NOT SafetyPlcCoE.Busy THEN
			SequenceState := SequenceState + 1;
		END_IF

	22:
		SafetyPlcCoE.Read(16#F980,
						  2,
						  ADR(_SafetyAddressInfo.SerialNumber),
						  SIZEOF(_SafetyAddressInfo.SerialNumber));

		SequenceState := SequenceState + 1;

	23:
		IF NOT SafetyPlcCoE.Error AND NOT SafetyPlcCoE.Busy THEN
			SequenceState := SequenceState + 1;
		END_IF

	24:
		SafetyPlcCoE.Read(16#F980,
						  3,
						  ADR(_SafetyAddressInfo.ProjectCRC),
						  SIZEOF(_SafetyAddressInfo.ProjectCRC));

		SequenceState := SequenceState + 1;

	25:
		IF NOT SafetyPlcCoE.Error AND NOT SafetyPlcCoE.Busy THEN
			SequenceState := SequenceState + 1;
		END_IF

	26:
		SafetyPlcCoE.Read(16#F980,
						  4,
						  ADR(_SafetyAddressInfo.DefaultProjectCRC),
						  SIZEOF(_SafetyAddressInfo.DefaultProjectCRC));

		SequenceState := SequenceState + 1;

	27:
		IF NOT SafetyPlcCoE.Error AND NOT SafetyPlcCoE.Busy THEN
			SequenceState := 100;
		END_IF

	100:
		SequenceState	  := 0;
		ModuleInitialized := TRUE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="OK" Id="{c41da4a9-26c2-45fe-9be5-5f0d1280fe2b}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY OK : BOOL]]></Declaration>
      <Get Name="Get" Id="{ca5eee10-8db5-4f41-8483-0af19692b972}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[OK := SafetyOkVisitor.OK;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="OnCyclicCall" Id="{50b95709-2139-45ff-9a75-cf17ac99eb24}" FolderPath="Cyclic\">
      <Declaration><![CDATA[METHOD OnCyclicCall]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Initialized THEN
	Initialize();
	RETURN;
END_IF

TwinSAFEResetDelay(PT := T#250MS);
CASE SequenceState OF
	0:
		TwinSAFEResetDelay.IN := FALSE;

	10:
		ResetComponents();
		SequenceState := 20;

	20:
		TwinSAFEResetDelay.IN := TRUE;
		IF TwinSAFEResetDelay.Q THEN
			SequenceState := 30;
		END_IF

	30:
		// Reset complete: latched until the caller stops requesting resets
		TwinSAFEResetDelay.IN := FALSE;
		IF NOT ResetRequestedThisScan THEN
			SequenceState := 0;
		END_IF
END_CASE
ResetRequestedThisScan := FALSE;

GetComponentsTaskResultVisitor.Update(THIS^);
SafetyOkVisitor.Check(Components);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{bac45c0a-62e1-4841-ae21-4a6a041a17ca}">
      <Declaration><![CDATA[METHOD Reset]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Holds the completed state while the caller keeps polling
ResetRequestedThisScan := TRUE;

IF Busy THEN
	RETURN;
END_IF

// Already reset and no error present: silently reject cyclic requests
IF SequenceState = 30 AND NOT Error THEN
	RETURN;
END_IF

SequenceState := 10;]]></ST>
      </Implementation>
    </Method>
    <Property Name="SafetyAddressInfo" Id="{1ea51f96-15c8-4af8-a79c-ef78e42ebe6d}">
      <Declaration><![CDATA[PROPERTY SafetyAddressInfo : REFERENCE TO ST_SafetyAddressInfo]]></Declaration>
      <Get Name="Get" Id="{a963db84-4502-44ae-9e40-da59245b6be8}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[SafetyAddressInfo REF= _SafetyAddressInfo;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="SafetyPlcCoE" Id="{8aa21f8e-1155-4aa6-8381-a884efc0e2a0}">
      <Declaration><![CDATA[PROPERTY SafetyPlcCoE : I_CoeDevice]]></Declaration>
      <Get Name="Get" Id="{c892039f-683c-4af1-9d02-6b920276ae1a}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[SafetyPlcCoE := _SafetyPlcCoE;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Simulated" Id="{72c9e5c6-9a77-4770-be37-32042ad6c45c}" FolderPath="Safety Simulation\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Simulated : BOOL]]></Declaration>
      <Get Name="Get" Id="{23418fcc-3747-4f54-b9d2-04d4e853fe45}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Simulated := SetSafetySimulationVisitor.Simulated;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{a94247ea-582b-4609-8728-469d4e9ed8e9}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[SetSafetySimulationVisitor.Simulated := Simulated;
Components.Accept(SetSafetySimulationVisitor);]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="SimulateSafetyDiag" Id="{fb407649-aeac-4270-9ec4-8ec0220c371d}" FolderPath="Safety Simulation\">
      <Declaration><![CDATA[METHOD SimulateSafetyDiag
VAR_INPUT
	SimulationValueDiag : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetSafetySimulationVisitor.Diag := SimulationValueDiag;
Components.Accept(SetSafetySimulationVisitor);]]></ST>
      </Implementation>
    </Method>
    <Method Name="SimulateSafetyState" Id="{5cba82a3-2193-4146-931b-954e6c5b8587}" FolderPath="Safety Simulation\">
      <Declaration><![CDATA[METHOD SimulateSafetyState
VAR_INPUT
	SimulationValueState : USINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SetSafetySimulationVisitor.State := SimulationValueState;
Components.Accept(SetSafetySimulationVisitor);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>