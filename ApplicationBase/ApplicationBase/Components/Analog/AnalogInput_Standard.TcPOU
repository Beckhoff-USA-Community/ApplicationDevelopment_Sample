  <POU Name="AnalogInput_Standard" Id="{71805f60-3fa6-4837-90c8-ebd868d11a17}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK AnalogInput_Standard EXTENDS AnalogInput IMPLEMENTS I_AnalogChannel_Standard
VAR
	Status : REFERENCE TO ST_AnalogInputStatus_EL30xx;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Property Name="DataValid" Id="{c9db11b9-c3d3-49c3-9ee1-33b16d646fe1}">
