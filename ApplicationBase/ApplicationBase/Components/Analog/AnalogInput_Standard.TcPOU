        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[DataValid := NOT Status.TxPDOState;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Error" Id="{13dc8754-b7ef-4c4f-8726-89334a7e4ddd}">
