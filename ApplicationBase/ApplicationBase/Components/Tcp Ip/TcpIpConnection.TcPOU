      </Set>
    </Property>
    <Property Name="ReceiveTimeout" Id="{36aaf0c8-ea58-4056-8047-8640a2536dab}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ReceiveTimeout : TIME]]></Declaration>
      <Set Name="Set" Id="{48893327-b0b9-4562-9b84-ebb4e68f7b35}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_ReceiveTimeout := ReceiveTimeout;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="ReconnectionTime" Id="{f11a4531-e6dc-4b7f-8df4-2f5b793c8646}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ReconnectionTime : TIME]]></Declaration>
      <Set Name="Set" Id="{a8b68293-85c8-4229-a273-d82ce63e2b69}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_ReconnectionTime := ReconnectionTime;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="RegisterCommand" Id="{b56b8796-0d62-4df7-bc0f-cccc1da562bf}">
      <Declaration><![CDATA[METHOD RegisterCommand
VAR_INPUT
	Command : I_TcpIpSubscription;
END_VAR

VAR
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO COMMAND_BUFFER DO
	IF Commands[i] = 0 THEN
		Commands[i] := Command;
		RETURN;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendCommand" Id="{5510a947-4be1-47cf-a558-7bb4b90879cf}">
      <Declaration><![CDATA[METHOD SendCommand
VAR_INPUT
	Command : POINTER TO ST_TcpIpPayload;
END_VAR

VAR
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO COMMAND_BUFFER DO
	IF SendBuffer[i].Size = 0 THEN
		MEMCPY(ADR(SendBuffer[i]), Command, SIZEOF(SendBuffer[i]));
		RETURN;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Property Name="SendInterval" Id="{61287e3c-e0e9-4e49-8e2b-3fb8129b8b04}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY SendInterval : TIME]]></Declaration>
      <Set Name="Set" Id="{b8f96504-85ee-4954-938e-d5a6edb0ae06}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_SendInterval := SendInterval;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="SendPriorityCommand" Id="{84f33cc6-1777-4aa6-bfd1-1e42faa5ec9e}">
      <Declaration><![CDATA[METHOD SendPriorityCommand
VAR_INPUT
	Command : POINTER TO ST_TcpIpPayload;
END_VAR

VAR
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO COMMAND_BUFFER DO
	IF PrioritySendBuffer[i].Size = 0 THEN
		MEMCPY(ADR(PrioritySendBuffer[i]), Command, SIZEOF(PrioritySendBuffer[i]));
		RETURN;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="SendReceiveSequence" Id="{7ee58811-71c6-42cb-b65f-c1c1c911a15c}" FolderPath="Protected\">
      <Declaration><![CDATA[METHOD PROTECTED SendReceiveSequence
VAR_INST
	SequenceState : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ClientServerConnection(sSrvNetID   := '',
					   sRemoteHost := _IP,
					   nRemotePort := _Port,
					   hSocket	   => _Socket,
					   eState	   => _ServerConnectionState);

SocketSend(sSrvNetId := '',
		   hSocket	 := _Socket,
		   cbLen	 := SendMessage.Size,
		   pSrc		 := ADR(SendMessage.Data),
		   tTimeout	 := T#5S);

SocketReceive(sSrvNetId := '',
			  hSocket	:= _Socket,
			  cbLen		:= SIZEOF(ReceiveMessage.Data),
			  pDest		:= ADR(ReceiveMessage.Data),
			  tTimeout	:= _ReceiveTimeout);

ReceiveMessage.Size := SIZEOF(ReceiveMessage.Data);

//
ReconnectTimer(PT := _ReconnectionTime);
PollTimer(PT := _PollTime);
ResponseTimer(PT := _ReceiveTimeout);
CASE SequenceState OF
	0:
		ClientServerConnection.bEnable := TRUE;
		IF _ServerConnectionState = eSOCKET_CONNECTED THEN
			SequenceState := SequenceState + 10;
		END_IF

		IF ClientServerConnection.bError THEN
			Trace.Error(_Name, CONCAT('ClientServerConnection.bError: ', TO_STRING(ClientServerConnection.nErrId)));
			SequenceState := 200;
		END_IF

	10:
		// SENDING -----------------------------------------------------------------------------------
		SendDelay(IN := NOT SendDelay.Q, PT := _SendInterval);
		IF SendMessage.Size = 0 THEN
			GetNextPriorityCommand();
		END_IF

		IF SendMessage.Size = 0 THEN
			GetNextCommand();
		END_IF

		IF SocketSend.bExecute AND NOT SocketSend.bBusy AND NOT SocketSend.bError THEN
			Trace.Info(_Name, 'Client sent');
			MEMSET(ADR(SendMessage), 0, SIZEOF(SendMessage));
			SocketSend.bExecute := FALSE;
		END_IF

		IF SendMessage.Size <> 0 AND NOT SocketSend.bExecute AND SendDelay.Q THEN
			SocketSend.bExecute := TRUE;
		END_IF

		IF SocketSend.bError THEN
			Trace.Error(_Name, CONCAT('SocketSend.bError: ', TO_STRING(SocketSend.nErrId)));
			SequenceState := 200;
		END_IF

		// RECEIVING -----------------------------------------------------------------------------------
		PollTimer.IN		   := TRUE;
		SocketReceive.bExecute := TRUE;
		IF PollTimer.Q AND NOT SocketReceive.bError AND NOT SocketReceive.bBusy THEN
			IF SocketReceive.nRecBytes > 0 THEN
				ResponseTimer.IN := FALSE;
				Trace.Info(_Name, 'Client recieved');
				EvaluateResponse();
			END_IF

			SequenceState := 11;
			// Stale connection, disconnected while socket was open
			IF SocketReceive.nRecBytes = 0 THEN
				ResponseTimer.IN := TRUE;
				IF ResponseTimer.Q THEN
					Trace.Error(_Name, 'Receive Connection stale - re-connect!');
					SequenceState := 200;
				END_IF
			END_IF
		END_IF

		IF SocketReceive.bError THEN
			Trace.Error(_Name, CONCAT('SocketReceive.bError: ', TO_STRING(SocketReceive.nErrId)));
			SequenceState := 200;
		END_IF

	11:
		PollTimer.IN		   := FALSE;
		SocketReceive.bExecute := FALSE;
		SequenceState		   := 10;

	200:
		ReconnectTimer.IN			   := TRUE;
		ResponseTimer.IN			   := FALSE;
		ClientServerConnection.bEnable := FALSE;
		SocketReceive.bExecute		   := FALSE;
		SocketSend.bExecute			   := FALSE;
		IF _ServerConnectionState = eSOCKET_DISCONNECTED AND ReconnectTimer.Q THEN
			ReconnectTimer.IN := FALSE;
			SequenceState	  := 0;
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="Socket" Id="{47a2ce11-778a-429f-85c7-54e661f9530d}">
      <Declaration><![CDATA[PROPERTY Socket : T_HSOCKET]]></Declaration>
      <Get Name="Get" Id="{af4dcea2-fcf5-49ad-a29d-80a2e9bb6d7e}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Socket := _Socket;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>