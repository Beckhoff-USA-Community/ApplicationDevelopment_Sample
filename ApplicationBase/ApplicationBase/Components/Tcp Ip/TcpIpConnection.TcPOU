      <Set Name="Set" Id="{dbc87d39-e55c-4efa-baff-2af80a50f23f}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_IP := IP;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="PollTime" Id="{66ad43bb-7e79-4fb0-a0a1-e1e8187064b1}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY PollTime : TIME]]></Declaration>
      <Set Name="Set" Id="{3a4ab4a9-f916-41c8-9674-7a75958d7e09}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_PollTime := PollTime;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="Port" Id="{823626e9-c0b1-4eb9-a19d-dd6e9f8c5c10}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Port : UDINT]]></Declaration>
      <Set Name="Set" Id="{20188e88-c4d3-4e28-88fe-383940d4e209}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_Port := Port;]]></ST>
