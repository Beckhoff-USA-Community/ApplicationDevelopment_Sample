<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="TcpIpConnection" Id="{b1a3122f-5ede-4a48-b6dc-1cfa2cce2b3a}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK TcpIpConnection EXTENDS CyclicComponent IMPLEMENTS I_TcpIpConnection, I_Initializable
VAR
	_Initialized   : BOOL;
	_IP			   : T_IPv4Addr := '127.0.0.1';
	_Port		   : UDINT;
	SocketCloseAll : FB_SocketCloseAll;

	// Send Port
	ReconnectTimer		   : TON;
	ClientServerConnection : FB_ClientServerConnection;
	_ServerConnectionState : E_SocketConnectionState;
	SocketSend			   : FB_SocketSend;
	SendMessage			   : ST_TcpIpPayload;
	_Socket				   : T_HSOCKET;
	SendDelay			   : TON;
	PollTimer			   : TON;
	ResponseTimer		   : TON;
	SocketReceive		   : FB_SocketReceive;
	ReceiveMessage		   : ST_TcpIpPayload;

	//
	_ReconnectionTime : TIME := T#10S;
	_PollTime		  : TIME := T#100MS;
	_ReceiveTimeout	  : TIME := T#50S;
	_SendInterval	  : TIME := T#100MS;
END_VAR

VAR
	Commands		   : ARRAY[0..COMMAND_BUFFER] OF I_TcpIpSubscription;
	SendBuffer		   : ARRAY[0..COMMAND_BUFFER] OF ST_TcpIpPayload;
	PrioritySendBuffer : ARRAY[0..COMMAND_BUFFER] OF ST_TcpIpPayload;
END_VAR

VAR CONSTANT
	COMMAND_BUFFER : DINT := 99;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Cyclic" Id="{970a1acd-4462-4133-a362-04981756bb4e}" />
    <Folder Name="Initialize" Id="{afe115e3-8c76-4bf2-aa2a-b4c2e4090464}" />
    <Folder Name="Protected" Id="{833ca4ba-4e9b-4359-9019-a25f997bedef}" />
    <Property Name="ConnectionState" Id="{186725ee-3266-41ef-99c3-9d84b8ff8c46}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ConnectionState : E_SocketConnectionState]]></Declaration>
      <Get Name="Get" Id="{423598c7-00d5-4850-b04a-65ded3d7856c}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[ConnectionState := _ServerConnectionState;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CyclicLogic" Id="{68e775cc-d02d-4598-8424-d58492e213ce}" FolderPath="Cyclic\">
      <Declaration><![CDATA[METHOD CyclicLogic]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _Initialized THEN
	Initialize();
	RETURN;
END_IF

SendReceiveSequence();]]></ST>
      </Implementation>
    </Method>
    <Method Name="EvaluateResponse" Id="{503d0b5f-9afc-43cd-a9d6-4140fc9c50d6}" FolderPath="Protected\">
      <Declaration><![CDATA[METHOD PROTECTED EvaluateResponse
VAR
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO COMMAND_BUFFER DO
	IF Commands[i] = 0 THEN
		EXIT;
	END_IF

	Commands[i].UpdateCommandResult(ADR(ReceiveMessage));
END_FOR

MEMSET(ADR(ReceiveMessage), 0, SIZEOF(ReceiveMessage));]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetNextCommand" Id="{da83caaa-1db5-4167-b245-d510dddf2b72}" FolderPath="Protected\">
      <Declaration><![CDATA[METHOD PROTECTED GetNextCommand
VAR
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF SendBuffer[0].Size <> 0 THEN
	MEMCPY(ADR(SendMessage), ADR(SendBuffer[0]), SIZEOF(SendBuffer[0]));
	FOR i := 0 TO (COMMAND_BUFFER - 1) DO
		MEMCPY(ADR(SendBuffer[i]), ADR(SendBuffer[i + 1]), SIZEOF(SendBuffer[i]));
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetNextPriorityCommand" Id="{6d002078-ba64-484d-89e2-ddc764c01c02}" FolderPath="Protected\">
      <Declaration><![CDATA[METHOD PROTECTED GetNextPriorityCommand
VAR
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF PrioritySendBuffer[0].Size <> 0 THEN
	MEMCPY(ADR(SendMessage), ADR(PrioritySendBuffer[0]), SIZEOF(PrioritySendBuffer[0]));
	FOR i := 0 TO (COMMAND_BUFFER - 1) DO
		MEMCPY(ADR(PrioritySendBuffer[i]), ADR(PrioritySendBuffer[i + 1]), SIZEOF(PrioritySendBuffer[i]));
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initialize" Id="{60efe5ce-4332-4f1a-832a-6ce4c8f1dc8a}" FolderPath="Initialize\">
      <Declaration><![CDATA[METHOD Initialize]]></Declaration>
      <Implementation>
        <ST><![CDATA[SocketCloseAll(sSrvNetId := '', bExecute := TRUE);
IF NOT SocketCloseAll.bBusy AND NOT SocketCloseAll.bError THEN
	_Initialized := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="Initialized" Id="{c037b38f-bac6-4526-89a6-0075edc6dc9b}" FolderPath="Initialize\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Initialized : BOOL]]></Declaration>
      <Get Name="Get" Id="{fdff3c81-11f1-4c7b-8e1c-a48777544992}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Initialized := _Initialized;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{72d54468-d904-44da-873f-36352cdb72dc}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_Initialized := Initialized;]]></ST>
        </Implementation>
      </Set>
    </Property>
