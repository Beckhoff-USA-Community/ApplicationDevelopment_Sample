<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TcEventClass" Id="{f296ebbc-7688-440d-8415-d25114030b28}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'enable_dynamic_creation'}
FUNCTION_BLOCK TcEventClass EXTENDS CyclicComponent IMPLEMENTS I_EventClassTcEvents
VAR
	pEventClass				   : PVOID;
	pEventBuffer			   : POINTER TO PVOID;
	pEventTriggerBuffer		   : POINTER TO PVOID;
	pEventAutoResetBuffer	   : POINTER TO PVOID;
	// Slot = position of an event in the event class of the type system (1..NumberOfEvents). Event ids may have gaps.
	pEventIdBuffer			   : POINTER TO UDINT; // event id of each slot
	pSortedSlotBuffer		   : POINTER TO UDINT; // slots ordered by ascending event id, binary searched by FindSlot
	NullEvent				   : FB_TcAlarm;
	GenerationFailedEvent	   : FB_TcAlarm; // raised (never cleared) when GenerateTcEvents fails verification, see ReportGenerationFailure
	NullBool				   : BOOL;
	NumberOfEvents			   : UDINT;
	GenerationFailed		   : BOOL; // TRUE if the dynamic allocation or the event ids failed VerifyAllocation. All lookups by event id then fail
	GenerationFailureCode	   : UDINT; // 0 = verified, otherwise the number of the VerifyAllocation check that failed
	HighestActiveEventSeverity : TcEventSeverity;
	EventReactionVerbose	   : DINT := 0;
	EventReactionInfo		   : DINT := 1;
	EventReactionWarning	   : DINT := 2;
	EventReactionError		   : DINT := 3;
	EventReactionCritical	   : DINT := 4;
	TcEventClassArguments	   : TcEventClassArguments;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Destructor" Id="{3c44b2be-77f6-48de-8306-fda5c0f1ccaa}" />
    <Folder Name="EventClass" Id="{9b7e3a0b-cb27-481d-a5fd-de6679491d19}" />
    <Folder Name="Private" Id="{d1044572-d217-4de9-b6fc-8ee0a16193c5}" />
    <Folder Name="Reset" Id="{44e59c43-7a7e-4a95-b81b-c9383285c707}" />
    <Method Name="Arguments" Id="{f4e9bbbb-37cb-456a-98e1-ee5ad2878507}">
      <Declaration><![CDATA[METHOD PUBLIC Arguments : I_EventArguments
VAR_INPUT
	EventId : UDINT;
END_VAR

VAR
	pEvent : POINTER TO FB_TcAlarm;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF CheckEventId(EventId) THEN
	pEvent := GetEventInstanceById(EventId);
	IF (pEvent <> 0) THEN
		TcEventClassArguments.Event := pEvent;
	ELSE
		TcEventClassArguments.Event := ADR(NullEvent);
	END_IF
ELSE
	TcEventClassArguments.Event := ADR(NullEvent);
END_IF

Arguments := TcEventClassArguments;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckEventId" Id="{c3195e9d-ff2e-4617-92b6-b77cccbd8812}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PROTECTED CheckEventId : BOOL
VAR_INPUT
	EventId : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CheckEventId := FindSlot(EventId) <> 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClearEventById" Id="{0bc34990-e2a1-4d61-80e6-6e73e823ff10}" FolderPath="EventClass\">
      <Declaration><![CDATA[METHOD ClearEventById
VAR_INPUT
	EventId : UDINT;
END_VAR

VAR
	pEvent : POINTER TO FB_TcAlarm;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF CheckEventId(EventId) THEN
	pEvent := GetEventInstanceById(EventId);
	IF (pEvent <> 0) THEN
		IF pEvent^.bRaised THEN
			pEvent^.Clear();
			FindActiveSeverity();
		END_IF
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="CyclicLogic" Id="{de50ef7d-7e5b-4c92-88c5-8ff275abf33f}">
      <Declaration><![CDATA[METHOD CyclicLogic
VAR
	i	   : UDINT;
	pEvent : POINTER TO FB_TcAlarm;
	pTrigger  : POINTER TO BOOL;
    AutoReset : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO NumberOfEvents DO
	pTrigger := GetEventTriggerInstanceBySlot(i);
	IF (pTrigger <> 0) THEN
		pEvent	  := GetEventInstanceBySlot(i);
		AutoReset := GetEventAutoResetInstanceBySlot(i)^;
		IF (pEvent <> 0) AND_THEN AutoReset AND NOT pTrigger^ THEN
			pEvent^.Clear();
			FindActiveSeverity();
		END_IF

		IF (pEvent <> 0) AND_THEN pTrigger^ THEN
			pEvent^.Raise(0);
			FindActiveSeverity();
		END_IF
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="Dispose" Id="{c2a2e0ed-32e6-414a-9fba-591f7246fc2e}" FolderPath="Destructor\">
      <Declaration><![CDATA[METHOD Dispose
VAR
	pDispose : POINTER TO TcEventClass;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[pDispose := THIS;
ReleaseBuffers();
__DELETE(pDispose);]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Exit" Id="{17232ae3-3631-4da3-b234-aa6161b3bc99}" FolderPath="Destructor\">
      <Declaration><![CDATA[//FB_Exit must be implemented explicitly. If there is an implementation, then the

//method is called before the controller removes the code of the function block instance

//(implicit call). The return value is not evaluated.
METHOD FB_Exit : BOOL
VAR_INPUT
	bInCopyCode : BOOL; // TRUE: the exit method is called in order to leave the instance which will be copied afterwards (online change).
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ReleaseBuffers();]]></ST>
      </Implementation>
    </Method>
    <Method Name="FindActiveSeverity" Id="{e9db7bf4-bc96-4131-b2cb-d92e8b4fea93}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PROTECTED FindActiveSeverity
VAR
	i	   : UDINT;
	pEvent : POINTER TO FB_TcAlarm;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[HighestActiveEventSeverity := Global.TcEventSeverity.Verbose;
FOR i := 1 TO NumberOfEvents DO
	pEvent := GetEventInstanceBySlot(i);
	IF (pEvent <> 0) AND_THEN pEvent^.bRaised AND_THEN pEvent^.eSeverity > HighestActiveEventSeverity THEN
		HighestActiveEventSeverity := pEvent^.eSeverity;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="FindSlot" Id="{5ff99340-2603-4b0f-9e67-d557718f0b79}" FolderPath="Private\">
      <Declaration><![CDATA[// Binary search of an event id through the sorted slots. Returns the slot (1..NumberOfEvents), or 0 if the id is not in the class
METHOD PROTECTED FindSlot : UDINT
VAR_INPUT
	EventId : UDINT;
END_VAR

VAR
	Low	 : UDINT;
	High : UDINT;
	Mid	 : UDINT;
	Slot : UDINT;
	Id	 : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FindSlot := 0;
IF GenerationFailed OR (pEventIdBuffer = 0) OR (pSortedSlotBuffer = 0) THEN
	RETURN;
END_IF

Low	 := 1;
High := NumberOfEvents;
WHILE Low <= High DO
	Mid	 := Low + (High - Low) / 2;
	Slot := GetSortedSlot(Mid);
	Id	 := GetEventIdBySlot(Slot);
	IF Id = EventId THEN
		FindSlot := Slot;
		RETURN;
	ELSIF Id < EventId THEN
		Low := Mid + 1;
	ELSE
		High := Mid - 1; // Mid >= 1 here, so this cannot underflow
	END_IF
END_WHILE]]></ST>
      </Implementation>
    </Method>
    <Method Name="GenerateTcEvents" Id="{b70681ab-99f1-42be-b37f-8c919729985e}">
      <Declaration><![CDATA[METHOD PUBLIC GenerateTcEvents
VAR_INPUT
	Name   : T_MaxString;
	pClass : PVOID; // ADR(TC_Events.XY) - TC Event Class in TypeSystem
	nSize  : UDINT; // SIZEOF(ST_XY) - TC Event Class in TypeSystem
END_VAR

VAR
	i				 : UDINT;
	j				 : UDINT;
	SortedIndex		 : UDINT;
	EventCount		 : UDINT;
	pEventDef		 : POINTER TO TcEventEntry;
	pOtherDef		 : POINTER TO TcEventEntry;
	pEvent			 : POINTER TO FB_TcAlarm;
	ppEvent			 : POINTER TO POINTER TO FB_TcAlarm;
	SourceInfo		 : FB_TcSourceInfo;
	pEventAutoReset	 : POINTER TO BOOL;
	ppEventAutoReset : POINTER TO POINTER TO BOOL;
	pId				 : POINTER TO UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// A repeated call must not leak the buffers of the previous one
ReleaseBuffers();

// Fail-safe: the class stays unusable until VerifyAllocation has passed at the end of this method
GenerationFailed := TRUE;
pEventClass		 := pClass;
EventCount		 := nSize / SIZEOF(TcEventEntry);

IF (pClass <> 0) AND (EventCount > 0) THEN
	NumberOfEvents		  := EventCount;
	pEventBuffer		  := __NEW(PVOID, EventCount);
	pEventTriggerBuffer	  := __NEW(PVOID, EventCount);
	pEventAutoResetBuffer := __NEW(PVOID, EventCount);
	pEventIdBuffer		  := __NEW(UDINT, EventCount);
	pSortedSlotBuffer	  := __NEW(UDINT, EventCount);
END_IF

IF (NumberOfEvents > 0) AND (pEventBuffer <> 0) AND (pEventTriggerBuffer <> 0) AND (pEventAutoResetBuffer <> 0) AND (pEventIdBuffer <> 0) AND (pSortedSlotBuffer <> 0) THEN
	SourceInfo.ResetToDefault();
	SourceInfo.sName := Name;

	// Do not rely on the allocator: start with every pointer unassigned (0) and every sorted slot unset (0)
	MEMSET(pEventBuffer, 0, EventCount * SIZEOF(PVOID));
	MEMSET(pEventTriggerBuffer, 0, EventCount * SIZEOF(PVOID));
	MEMSET(pEventAutoResetBuffer, 0, EventCount * SIZEOF(PVOID));
	MEMSET(pEventIdBuffer, 0, EventCount * SIZEOF(UDINT));
	MEMSET(pSortedSlotBuffer, 0, EventCount * SIZEOF(UDINT));

	// Store the event id of each slot
	FOR i := 1 TO EventCount DO
		pEventDef := pEventClass + ((i - 1) * SIZEOF(TcEventEntry));
		pId		  := pEventIdBuffer + ((i - 1) * SIZEOF(UDINT));
		pId^	  := pEventDef^.nEventID;
	END_FOR

	// Sorted index of slot i = 1 + number of events with a smaller id. Equal ids are ordered by slot so the
	// result is always a permutation of the slots; VerifyAllocation rejects duplicate ids.
	FOR i := 1 TO EventCount DO
		pEventDef	:= pEventClass + ((i - 1) * SIZEOF(TcEventEntry));
		SortedIndex := 1;
		FOR j := 1 TO EventCount DO
			pOtherDef := pEventClass + ((j - 1) * SIZEOF(TcEventEntry));
			IF (pOtherDef^.nEventID < pEventDef^.nEventID) OR ((pOtherDef^.nEventID = pEventDef^.nEventID) AND (j < i)) THEN
				SortedIndex := SortedIndex + 1;
			END_IF
		END_FOR

		pId	  := pSortedSlotBuffer + ((SortedIndex - 1) * SIZEOF(UDINT));
		pId^  := i;
	END_FOR

	// One alarm and one auto reset flag per slot. A failed allocation is left as 0 and caught by VerifyAllocation
	FOR i := 1 TO EventCount DO
		pEventDef := pEventClass + ((i - 1) * SIZEOF(TcEventEntry));

		pEvent	  := __NEW(FB_TcAlarm);
		ppEvent	  := pEventBuffer + ((i - 1) * SIZEOF(PVOID));
		ppEvent^  := pEvent;
		IF pEvent <> 0 THEN
			pEvent^.CreateEx2(pEventDef^, SourceInfo);
		END_IF

		pEventAutoReset	  := __NEW(BOOL);
		ppEventAutoReset  := pEventAutoResetBuffer + ((i - 1) * SIZEOF(PVOID));
		ppEventAutoReset^ := pEventAutoReset;
		IF pEventAutoReset <> 0 THEN
			pEventAutoReset^ := FALSE;
		END_IF
	END_FOR
END_IF

GenerationFailureCode := VerifyAllocation();
GenerationFailed	  := GenerationFailureCode <> 0;
IF GenerationFailed THEN
	ReportGenerationFailure(Name);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetEventAutoResetInstanceById" Id="{ccc4ce8d-afb2-44b8-9905-aada37ad25a4}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PROTECTED GetEventAutoResetInstanceById : POINTER TO BOOL
VAR_INPUT
	EventId : UDINT;
END_VAR

VAR
	Slot : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Slot := FindSlot(EventId);
IF Slot <> 0 THEN
	GetEventAutoResetInstanceById := GetEventAutoResetInstanceBySlot(Slot);
ELSE
	GetEventAutoResetInstanceById := ADR(NullBool);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetEventAutoResetInstanceBySlot" Id="{077e2e4b-5043-4ff8-9a36-1f3dc4a4222b}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PROTECTED GetEventAutoResetInstanceBySlot : POINTER TO BOOL
VAR_INPUT
	Slot : UDINT;
END_VAR

VAR
	ppEventAutoReset : POINTER TO POINTER TO BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (Slot >= 1) AND (Slot <= NumberOfEvents) AND (pEventAutoResetBuffer <> 0) THEN
	ppEventAutoReset				:= pEventAutoResetBuffer + ((Slot - 1) * SIZEOF(PVOID));
	GetEventAutoResetInstanceBySlot := ppEventAutoReset^;
ELSE
	GetEventAutoResetInstanceBySlot := ADR(NullBool);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetEventIdBySlot" Id="{c5901ea8-4bef-4585-b384-d1e994909f4a}" FolderPath="Private\">
      <Declaration><![CDATA[// Event id stored for a slot, 0 if the slot does not exist
METHOD PROTECTED GetEventIdBySlot : UDINT
VAR_INPUT
	Slot : UDINT;
END_VAR

VAR
	pId : POINTER TO UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetEventIdBySlot := 0;
IF (Slot >= 1) AND (Slot <= NumberOfEvents) AND (pEventIdBuffer <> 0) THEN
	pId				 := pEventIdBuffer + ((Slot - 1) * SIZEOF(UDINT));
	GetEventIdBySlot := pId^;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetEventInstanceById" Id="{8c4f7721-baec-4f66-b099-e4a1d6d31119}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PROTECTED GetEventInstanceById : POINTER TO FB_TcAlarm
VAR_INPUT
	EventId : UDINT;
END_VAR

VAR
	Slot : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Slot := FindSlot(EventId);
IF Slot <> 0 THEN
	GetEventInstanceById := GetEventInstanceBySlot(Slot);
ELSE
	GetEventInstanceById := ADR(NullEvent);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetEventInstanceBySlot" Id="{783cd066-637b-49da-b402-0cecad4b66e7}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PROTECTED GetEventInstanceBySlot : POINTER TO FB_TcAlarm
VAR_INPUT
	Slot : UDINT;
END_VAR

VAR
	ppEvent : POINTER TO POINTER TO FB_TcAlarm;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (Slot >= 1) AND (Slot <= NumberOfEvents) AND (pEventBuffer <> 0) THEN
    ppEvent                := pEventBuffer + ((Slot - 1) * SIZEOF(PVOID));
    GetEventInstanceBySlot := ppEvent^;
ELSE
    GetEventInstanceBySlot := ADR(NullEvent);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetEventTriggerInstanceBySlot" Id="{387644ae-774a-449f-8fec-aa433a4bfe4f}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PROTECTED GetEventTriggerInstanceBySlot : POINTER TO BOOL
VAR_INPUT
	Slot : UDINT;
END_VAR

VAR
	ppEventTrigger : POINTER TO POINTER TO BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (Slot >= 1) AND (Slot <= NumberOfEvents) AND (pEventTriggerBuffer <> 0) THEN
	ppEventTrigger				  := pEventTriggerBuffer + ((Slot - 1) * SIZEOF(PVOID));
	GetEventTriggerInstanceBySlot := ppEventTrigger^;
ELSE
	GetEventTriggerInstanceBySlot := ADR(NullBool);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetHighestActiveEventReaction" Id="{3dd72723-00f8-4a41-9c50-1e832e481a96}" FolderPath="EventClass\">
      <Declaration><![CDATA[METHOD GetHighestActiveEventReaction : DINT]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE HighestActiveEventSeverity OF
	TcEventSeverity.Verbose:
		GetHighestActiveEventReaction := EventReactionVerbose;

	TcEventSeverity.Info:
		GetHighestActiveEventReaction := EventReactionInfo;

	TcEventSeverity.Warning:
		GetHighestActiveEventReaction := EventReactionWarning;

	TcEventSeverity.Error:
		GetHighestActiveEventReaction := EventReactionError;

	TcEventSeverity.Critical:
		GetHighestActiveEventReaction := EventReactionCritical;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetHighestActiveEventSeverity" Id="{4fbe4d53-d662-402d-94fc-b4b0c75556f4}" FolderPath="EventClass\">
      <Declaration><![CDATA[METHOD GetHighestActiveEventSeverity : TcEventSeverity]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetHighestActiveEventSeverity := HighestActiveEventSeverity;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetSortedSlot" Id="{1ed6ef09-588a-4cb2-a001-c944c2e246be}" FolderPath="Private\">
      <Declaration><![CDATA[// Reads entry Position (1-based) of the sorted list of slots, which is ordered by ascending event id.
// Example: ids by slot = [2, 5, 4, 65534] gives the sorted list [1, 3, 2, 4], so GetSortedSlot(2) = 3,
// because the second smallest id (4) is in slot 3. Returns 0 if Position is outside 1..NumberOfEvents.
METHOD PROTECTED GetSortedSlot : UDINT
VAR_INPUT
	Position : UDINT;
END_VAR

VAR
	pSlot : POINTER TO UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetSortedSlot := 0;
IF (Position >= 1) AND (Position <= NumberOfEvents) AND (pSortedSlotBuffer <> 0) THEN
	pSlot		  := pSortedSlotBuffer + ((Position - 1) * SIZEOF(UDINT));
	GetSortedSlot := pSlot^;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="IsResettable" Id="{6572cedf-e2f0-4204-b69d-e02d9ba95338}" FolderPath="EventClass\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY IsResettable : BOOL]]></Declaration>
      <Get Name="Get" Id="{36d93a76-f89b-4346-be4a-d5bd3fe859e2}">
        <Declaration><![CDATA[VAR
	i		  : UDINT;
	pEvent	  : POINTER TO FB_TcAlarm;
	pTrigger  : POINTER TO BOOL;
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsResettable := FALSE;
FOR i := 1 TO NumberOfEvents DO
	pTrigger := GetEventTriggerInstanceBySlot(i);
	IF (pTrigger <> 0) THEN
		pEvent := GetEventInstanceBySlot(i);
		IF (pEvent <> 0) AND_THEN NOT pTrigger^ AND pEvent^.bRaised THEN
			IsResettable := TRUE;
		END_IF
	END_IF
END_FOR]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="RaiseEvent" Id="{648ad2c3-20e6-47f9-8c03-6521ffdaefac}" FolderPath="EventClass\">
      <Declaration><![CDATA[METHOD RaiseEvent
VAR_INPUT
	EventId	  : UDINT;
END_VAR

VAR
	pEvent : POINTER TO FB_TcAlarm;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF CheckEventId(EventId) THEN
	pEvent := GetEventInstanceById(EventId);
	IF (pEvent <> 0) THEN
		IF NOT pEvent^.bRaised THEN
			pEvent^.Raise();
			IF pEvent^.eSeverity > HighestActiveEventSeverity THEN
				HighestActiveEventSeverity := pEvent^.eSeverity;
			END_IF

			pEvent^.ipArguments.Clear();
		END_IF
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReleaseBuffers" Id="{46a0392a-126f-4ac8-89e0-09f6f0431f43}" FolderPath="Private\">
      <Declaration><![CDATA[// Frees everything GenerateTcEvents allocated. Safe to call repeatedly and after a partly failed allocation
METHOD PROTECTED ReleaseBuffers
VAR
	i				 : UDINT;
	pEvent			 : POINTER TO FB_TcAlarm;
	ppEvent			 : POINTER TO POINTER TO FB_TcAlarm;
	pEventAutoReset	 : POINTER TO BOOL;
	ppEventAutoReset : POINTER TO POINTER TO BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO NumberOfEvents DO
	IF pEventBuffer <> 0 THEN
		ppEvent := pEventBuffer + ((i - 1) * SIZEOF(PVOID));
		pEvent	:= ppEvent^;
		IF pEvent <> 0 THEN
			__DELETE(pEvent);
		END_IF

		ppEvent^ := 0;
	END_IF

	IF pEventAutoResetBuffer <> 0 THEN
		ppEventAutoReset := pEventAutoResetBuffer + ((i - 1) * SIZEOF(PVOID));
		pEventAutoReset	 := ppEventAutoReset^;
		IF pEventAutoReset <> 0 THEN
			__DELETE(pEventAutoReset);
		END_IF

		ppEventAutoReset^ := 0;
	END_IF
END_FOR

IF pEventBuffer <> 0 THEN
	__DELETE(pEventBuffer);
END_IF

IF pEventTriggerBuffer <> 0 THEN
	__DELETE(pEventTriggerBuffer);
END_IF

IF pEventAutoResetBuffer <> 0 THEN
	__DELETE(pEventAutoResetBuffer);
END_IF

IF pEventIdBuffer <> 0 THEN
	__DELETE(pEventIdBuffer);
END_IF

IF pSortedSlotBuffer <> 0 THEN
	__DELETE(pSortedSlotBuffer);
END_IF

pEventBuffer		  := 0;
pEventTriggerBuffer	  := 0;
pEventAutoResetBuffer := 0;
pEventIdBuffer		  := 0;
pSortedSlotBuffer	  := 0;
NumberOfEvents		  := 0;
HighestActiveEventSeverity := Global.TcEventSeverity.Verbose;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{84598324-b79b-4c91-9e45-be0f6a3b4619}" FolderPath="Reset\">
      <Declaration><![CDATA[METHOD Reset
VAR
	i		 : UDINT;
	pEvent	 : POINTER TO FB_TcAlarm;
	pTrigger : POINTER TO BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO NumberOfEvents DO
	pTrigger := GetEventTriggerInstanceBySlot(i);
	pEvent	 := GetEventInstanceBySlot(i);
	IF (pEvent <> 0) THEN
		IF (pTrigger <> 0) AND_THEN NOT pTrigger^ THEN
			pEvent^.Clear();
		END_IF

		IF (pTrigger = 0) THEN
			pEvent^.Clear();
		END_IF
	END_IF
END_FOR

HighestActiveEventSeverity := Global.TcEventSeverity.Verbose;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetBySeverity" Id="{4d4f7798-b9b3-4572-8959-f8d476034098}" FolderPath="EventClass\">
      <Declaration><![CDATA[METHOD ResetBySeverity : BOOL
VAR_INPUT
	Severity : UDINT;
END_VAR

VAR
	i	   : UDINT;
	pEvent : POINTER TO FB_TcAlarm;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 1 TO NumberOfEvents DO
	pEvent := GetEventInstanceBySlot(i);
	IF (pEvent <> 0) AND_THEN (pEvent^.eSeverity <= TO_DINT(Severity)) THEN
		pEvent^.Clear();
	END_IF
END_FOR

FindActiveSeverity();
ResetBySeverity := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetEvent" Id="{fb706f66-4415-4158-b47a-e2aff277a8b4}" FolderPath="EventClass\">
      <Declaration><![CDATA[METHOD SetEvent
VAR_INPUT
	EventId	  : UDINT;
	Trigger	  : POINTER TO BOOL;
	AutoReset : BOOL;
END_VAR

VAR
	pBool : POINTER TO BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF CheckEventId(EventId) THEN
	IF Trigger <> 0 THEN
		SetEventTriggerInstance(EventId, Trigger);
	END_IF

	pBool  := GetEventAutoResetInstanceById(EventId);
	pBool^ := AutoReset;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetEventReactions" Id="{8ac7ddb8-251e-4580-8cc8-495adcd545af}" FolderPath="EventClass\">
      <Declaration><![CDATA[METHOD SetEventReactions
VAR_INPUT
	Verbose	 : DINT := 0;
	Info	 : DINT := 1;
	Warning	 : DINT := 2;
	Error	 : DINT := 3;
	Critical : DINT := 4;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[EventReactionVerbose  := Verbose;
EventReactionInfo	  := Info;
EventReactionWarning  := Warning;
EventReactionError	  := Error;
EventReactionCritical := Critical;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetEventTriggerInstance" Id="{aeb516f8-63fe-41e6-8f6a-ca6ce4cf8b29}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PROTECTED SetEventTriggerInstance
VAR_INPUT
	EventId : UDINT;
    Trigger : POINTER TO BOOL;
END_VAR

VAR
	Slot		   : UDINT;
	ppEventTrigger : POINTER TO POINTER TO BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Slot := FindSlot(EventId);
IF (Slot <> 0) AND (pEventTriggerBuffer <> 0) THEN
	ppEventTrigger	:= pEventTriggerBuffer + ((Slot - 1) * SIZEOF(PVOID));
	ppEventTrigger^ := Trigger;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="VerifyAllocation" Id="{2d5eb436-5eb8-4a9f-8c93-cc3b10502492}" FolderPath="Private\">
      <Declaration><![CDATA[// Verification of the dynamic allocation done by GenerateTcEvents (fail-safe, SIL1): everything the lookups and loops
// dereference must exist, be distinct and be consistent. Returns 0 if all checks pass, otherwise the number of the first failed check:
//  1. the class definition and all five buffers were allocated, and there is at least one event
//  2. a slot has no FB_TcAlarm or no auto reset flag (the allocation returned 0)
//  3. two slots share the same FB_TcAlarm or auto reset flag
//  4. the trigger of a slot is already assigned (it must be 0 until SetEvent)
//  5. an alarm does not answer to the event id stored for its slot (broken link slot -> id -> alarm)
//  6. SortedSlots refers to a slot that does not exist
//  7. the ids along SortedSlots are not strictly ascending: duplicate event ids, or a broken sort,
//     so the binary search would be invalid. (Strictly ascending also makes SortedSlots a permutation.)
METHOD PROTECTED VerifyAllocation : UDINT
VAR
	i				 : UDINT;
	j				 : UDINT;
	Slot			 : UDINT;
	pEvent			 : POINTER TO FB_TcAlarm;
	pOtherEvent		 : POINTER TO FB_TcAlarm;
	ppEvent			 : POINTER TO POINTER TO FB_TcAlarm;
	pEventAutoReset	 : POINTER TO BOOL;
	pOtherAutoReset	 : POINTER TO BOOL;
	ppEventAutoReset : POINTER TO POINTER TO BOOL;
	ppEventTrigger	 : POINTER TO POINTER TO BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (pEventClass = 0) OR (NumberOfEvents = 0) OR (pEventBuffer = 0) OR (pEventTriggerBuffer = 0) OR (pEventAutoResetBuffer = 0) OR (pEventIdBuffer = 0) OR (pSortedSlotBuffer = 0) THEN
	VerifyAllocation := 1;
	RETURN;
END_IF

FOR i := 1 TO NumberOfEvents DO
	ppEvent			 := pEventBuffer + ((i - 1) * SIZEOF(PVOID));
	pEvent			 := ppEvent^;
	ppEventAutoReset := pEventAutoResetBuffer + ((i - 1) * SIZEOF(PVOID));
	pEventAutoReset	 := ppEventAutoReset^;
	ppEventTrigger	 := pEventTriggerBuffer + ((i - 1) * SIZEOF(PVOID));

	IF (pEvent = 0) OR (pEventAutoReset = 0) THEN
		VerifyAllocation := 2;
		RETURN;
	END_IF

	FOR j := 1 TO i - 1 DO
		ppEvent			 := pEventBuffer + ((j - 1) * SIZEOF(PVOID));
		pOtherEvent		 := ppEvent^;
		ppEventAutoReset := pEventAutoResetBuffer + ((j - 1) * SIZEOF(PVOID));
		pOtherAutoReset	 := ppEventAutoReset^;
		IF (pEvent = pOtherEvent) OR (pEventAutoReset = pOtherAutoReset) THEN
			VerifyAllocation := 3;
			RETURN;
		END_IF
	END_FOR

	IF ppEventTrigger^ <> 0 THEN
		VerifyAllocation := 4;
		RETURN;
	END_IF

	IF pEvent^.nEventId <> GetEventIdBySlot(i) THEN
		VerifyAllocation := 5;
		RETURN;
	END_IF

	Slot := GetSortedSlot(i);
	IF (Slot < 1) OR (Slot > NumberOfEvents) THEN
		VerifyAllocation := 6;
		RETURN;
	END_IF

	IF (i > 1) AND_THEN (GetEventIdBySlot(GetSortedSlot(i - 1)) >= GetEventIdBySlot(Slot)) THEN
		VerifyAllocation := 7;
		RETURN;
	END_IF
END_FOR

VerifyAllocation := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReportGenerationFailure" Id="{cf7acd43-0ced-499c-b548-6f7a085132b9}" FolderPath="Private\">
      <Declaration><![CDATA[// Raises the Critical event that belongs to GenerationFailureCode (TC_EVENTS.TcEventClassFailure), with the name of the failed class as argument {0}.
// It is not cleared again, so the failure stays visible in the logged events. It uses its own FB_TcAlarm and no dynamic memory.
METHOD PROTECTED ReportGenerationFailure
VAR_INPUT
	Name : T_MaxString;
END_VAR

VAR
	SourceInfo : FB_TcSourceInfo;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF GenerationFailedEvent.bRaised THEN
	RETURN; // keep the first failure, a second Create would also reset the alarm
END_IF

SourceInfo.ResetToDefault();
SourceInfo.sName := Name;
CASE GenerationFailureCode OF
	1: GenerationFailedEvent.CreateEx2(TC_EVENTS.TcEventClassFailure.BufferMissing, SourceInfo);
	2: GenerationFailedEvent.CreateEx2(TC_EVENTS.TcEventClassFailure.AllocationFailed, SourceInfo);
	3: GenerationFailedEvent.CreateEx2(TC_EVENTS.TcEventClassFailure.SharedMemory, SourceInfo);
	4: GenerationFailedEvent.CreateEx2(TC_EVENTS.TcEventClassFailure.TriggerAssigned, SourceInfo);
	5: GenerationFailedEvent.CreateEx2(TC_EVENTS.TcEventClassFailure.IdMismatch, SourceInfo);
	6: GenerationFailedEvent.CreateEx2(TC_EVENTS.TcEventClassFailure.SortedSlotOutOfRange, SourceInfo);
ELSE
	GenerationFailedEvent.CreateEx2(TC_EVENTS.TcEventClassFailure.DuplicateEventId, SourceInfo);
END_CASE

GenerationFailedEvent.ipArguments.Clear();
GenerationFailedEvent.ipArguments.AddString(Name);
GenerationFailedEvent.Raise(0);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>