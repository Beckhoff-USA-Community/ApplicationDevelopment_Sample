    <Method Name="RegisterComponent" Id="{f891c5eb-7c27-49fc-bd52-67b687db0c3b}" FolderPath="Register\">
      <Declaration><![CDATA[METHOD RegisterComponent : RegistrationResult
VAR_INPUT
	Component : I_Component;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[RegisterComponent := ComponentCollection.AddComponent(Component);]]></ST>
      </Implementation>
    </Method>
    <Method Name="RegisterCyclic" Id="{e0d43d55-4c2d-41ca-9c92-4c1d59271668}" FolderPath="Register\">
      <Declaration><![CDATA[METHOD RegisterCyclic : RegistrationResult
VAR_INPUT
	Cyclic : I_Cyclic;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[RegisterCyclic := CyclicRunner.AddCallee(Cyclic);]]></ST>
      </Implementation>
    </Method>
    <Method Name="RegisterInitialize" Id="{9dcccf88-aab0-4dc4-9295-b3c00aa2606d}" FolderPath="Register\">
      <Declaration><![CDATA[METHOD RegisterInitialize : RegistrationResult
VAR_INPUT
	Initializable : I_Initializable;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[RegisterInitialize := Initializer.AddInitialize(Initializable);]]></ST>
      </Implementation>
    </Method>
    <Method Name="RegisterModule" Id="{eccb7e2e-e326-4ac8-8c58-bdffe5567128}" FolderPath="Register\">
      <Declaration><![CDATA[METHOD RegisterModule : RegistrationResult
VAR_INPUT
	Module : I_Module;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[RegisterModule := ModuleCollection.AddModule(Module);]]></ST>
      </Implementation>
    </Method>
    <Method Name="RegisterWithParent" Id="{0e69af46-11af-4ad1-be6a-9efbf989c269}" FolderPath="Register\">
      <Declaration><![CDATA[METHOD RegisterWithParent
VAR_INPUT
	Parent : I_ContainModules;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Parent.RegisterModule(THIS^);
Parent.RegisterCyclic(THIS^);
Parent.RegisterInitialize(THIS^);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetComponents" Id="{f973ec71-a7f4-4fa0-8997-c6b2ac13cd92}" FolderPath="Reset\">
      <Declaration><![CDATA[METHOD ResetComponents : BOOL
VAR_INST
	ResetComponentsVisitor : ResetComponentsVisitor;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ResetComponentsVisitor.Reset(THIS^);
ResetComponents := NOT ResetComponentsVisitor.Error AND NOT ResetComponentsVisitor.Busy;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetModules" Id="{179349de-35b5-4459-8b5e-e17e9d56d3af}" FolderPath="Reset\">
      <Declaration><![CDATA[METHOD ResetModules : BOOL
VAR_INST
	ResetModulesVisitor : ResetModulesVisitor;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ResetModulesVisitor.Reset(THIS^);
ResetModules := NOT ResetModulesVisitor.Error AND NOT ResetModulesVisitor.Busy;]]></ST>
      </Implementation>
    </Method>
