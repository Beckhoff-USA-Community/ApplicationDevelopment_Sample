      </Get>
    </Property>
    <Property Name="Name" Id="{a49b4550-78b0-4910-a0a8-4a104f15e841}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Name : T_MaxString]]></Declaration>
      <Get Name="Get" Id="{1e05850f-8152-42a8-af80-f66f89b22454}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Name := _Name;]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{c18c3cb1-3370-43d0-a7de-8ea729562e40}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_Name := Name;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="OnCyclicCall" Id="{b49f13fa-fc59-4158-b58e-dfd322deb29f}" FolderPath="Cyclic\">
      <Declaration><![CDATA[METHOD ABSTRACT OnCyclicCall
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
