    <Property Name="Statemachine" Id="{1c470240-50cc-47d0-b4e1-938f2e4bae3b}">
      <Declaration><![CDATA[PROPERTY Statemachine : I_Statemachine]]></Declaration>
      <Get Name="Get" Id="{fcea9f8e-87e4-4500-b028-2bb2188b6a76}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Statemachine := _Statemachine;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="StateSelect" Id="{13881525-b521-4102-aead-d8a7122bf0de}">
      <Declaration><![CDATA[METHOD PRIVATE StateSelect
VAR_INST
	ClearingTon : TON;
	LastState	: DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF LastState <> _Statemachine.CurrentState THEN
	SequenceState := 0;
	LastState	  := _Statemachine.CurrentState;
END_IF

CASE _Statemachine.CurrentState OF
	E_PMLState.Undefined:
		;

	E_PMLState.Clearing:
		ClearingTon(IN := TRUE, PT := ApplicationBaseParameter.ClearingTimeout);
		IF Clearing() THEN
			ClearingTon(IN := FALSE);
			_Statemachine.StateComplete();
		END_IF

		IF ClearingTon.Q THEN
			ClearingTon(IN := FALSE);
			Trace.LogMessage('Clearing Timeout exeeded! - ', _Name);
			_Statemachine.ChangeState(E_PMLCommand.Abort);
		END_IF

	E_PMLState.Stopped:
		Stopped();

	E_PMLState.Starting:
		IF Starting() THEN
			_Statemachine.StateComplete();
		END_IF

	E_PMLState.Idle:
		Idle();

	E_PMLState.Suspended:
		Suspended();

	E_PMLState.Execute:
		Execute();

	E_PMLState.Stopping:
		IF Stopping() THEN
			_Statemachine.StateComplete();
		END_IF

	E_PMLState.Aborting:
		IF Aborting() THEN
			_Statemachine.StateComplete();
		END_IF

	E_PMLState.Aborted:
		Aborted();

	E_PMLState.Holding:
		IF Holding() THEN
			_Statemachine.StateComplete();
		END_IF

	E_PMLState.Held:
		Held();

	E_PMLState.Unholding:
		IF Unholding() THEN
			_Statemachine.StateComplete();
		END_IF

	E_PMLState.Suspending:
		IF Suspending() THEN
			_Statemachine.StateComplete();
		END_IF

	E_PMLState.Unsuspending:
		IF Unsuspending() THEN
			_Statemachine.StateComplete();
		END_IF

	E_PMLState.Resetting:
		IF Resetting() THEN
			_Statemachine.StateComplete();
		END_IF

	E_PMLState.Completing:
		IF Completing() THEN
			_Statemachine.StateComplete();
		END_IF

	E_PMLState.Completed:
		Completed();
END_CASE]]></ST>
      </Implementation>
    </Method>
