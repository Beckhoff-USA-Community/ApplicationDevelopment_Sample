    <Method Name="Stop" Id="{a6e1f9e7-a7dc-4ce9-9d10-71a0c88fda01}" FolderPath="Stop\">
      <Declaration><![CDATA[METHOD Stop]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Error AND _Axis.McToPlc.Std.HasError THEN
	(* It's possible that a function block errored but
	not the NC itself--in this case we can allow a stop command.
	If the NC Axis has a real fault then we want a successful reset first *)
	RETURN;
END_IF

_StopTask.Execute();]]></ST>
      </Implementation>
    </Method>
    <Property Name="Stopped" Id="{eb504364-1142-4d8a-aeaf-e6c339ec2b03}" FolderPath="Stop\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Stopped : BOOL]]></Declaration>
      <Get Name="Get" Id="{61398e68-c2d5-41a6-a473-8f47af6975cd}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Stopped := (_Axis.McToPlc.Std.AxisState = EAxisState.Standstill) OR ((_Axis.McToPlc.Std.AxisState = EAxisState.SynchronizedMotion) AND (SetVelocity = 0.0));]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="StopTask" Id="{83aabd6c-04dc-4c57-ac8f-c297822a2fe5}" FolderPath="Stop\">
      <Declaration><![CDATA[PROPERTY StopTask : I_Mc3MotionTask]]></Declaration>
      <Set Name="Set" Id="{4d7620a7-cb64-423e-b169-666c783e0917}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[MotionTaskCollection.RemoveTaskByInstance(_StopTask);
_StopTask := StopTask;
MotionTaskCollection.AddTask(_ResetTask);]]></ST>
        </Implementation>
      </Set>
    </Property>
