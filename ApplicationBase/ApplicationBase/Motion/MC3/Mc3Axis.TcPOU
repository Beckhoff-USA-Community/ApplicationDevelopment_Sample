    <Method Name="Jog" Id="{bd10ad3a-a14e-42a8-a8e2-938896daa865}" FolderPath="Jog\">
      <Declaration><![CDATA[METHOD Jog
VAR_INPUT
	JogForward	 : BOOL;
	JogBackwards : BOOL;
	Distance	 : LREAL := 0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Error THEN
	RETURN;
END_IF

JogTask.JogBackwards := JogBackwards;
JogTask.JogForward	 := JogForward;
JogTask.Distance	 := Distance;
JogTask.Mode		 := _JogMode;
JogTask.Execute();]]></ST>
      </Implementation>
    </Method>
