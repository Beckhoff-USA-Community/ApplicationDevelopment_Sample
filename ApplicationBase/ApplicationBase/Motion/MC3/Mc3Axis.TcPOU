    <Property Name="ResetTask" Id="{6429039c-8bcc-4f20-8071-2f53bec22a1b}" FolderPath="Reset\">
      <Declaration><![CDATA[PROPERTY ResetTask : I_Mc3MotionTask]]></Declaration>
      <Set Name="Set" Id="{fb4317fc-0b94-4bc0-9403-5ae0652dfb52}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[MotionTaskCollection.RemoveTaskByInstance(_ResetTask);
_ResetTask := ResetTask;
MotionTaskCollection.AddTask(_ResetTask);]]></ST>
        </Implementation>
      </Set>
    </Property>
