    <Method Name="Initialize" Id="{48b8ddc2-531b-4ffa-afa5-b9951fa039dc}" FolderPath="Initialize\">
      <Declaration><![CDATA[METHOD Initialize
VAR_INST
    Sequence : UDINT;
    ReadParameter : Tc3_Mc3Ptp.MC_ReadParameter;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _Initialized AND (_Axis.McToPlc.Std.AxisState <> EAxisState.Invalid) THEN
	CASE Sequence OF
		0:
			ReadParameter(Axis		  := _Axis,
						  Enable	  := TRUE,
						  ParameterId := EAxisParameterId.DefaultAcceleration,
						  Mode		  := EReadMode.Once,
						  Valid		  =>,
						  Busy		  =>,
						  Error		  =>,
						  ErrorId	  =>,
						  Value		  => _Acceleration);

			IF ReadParameter.Valid THEN
				ReadParameter(Axis := _Axis, Enable := FALSE);
				NextStep(Sequence);
			END_IF

		10:
			ReadParameter(Axis		  := _Axis,
						  Enable	  := TRUE,
						  ParameterId := EAxisParameterId.DefaultDeceleration,
						  Mode		  := EReadMode.Once,
						  Valid		  =>,
						  Busy		  =>,
						  Error		  =>,
						  ErrorId	  =>,
						  Value		  => _Deceleration);

			IF ReadParameter.Valid THEN
				ReadParameter(Axis := _Axis, Enable := FALSE);
				NextStep(Sequence);
			END_IF

		20:
			ReadParameter(Axis		  := _Axis,
						  Enable	  := TRUE,
						  ParameterId := EAxisParameterId.DefaultJerk,
						  Mode		  := EReadMode.Once,
						  Valid		  =>,
						  Busy		  =>,
						  Error		  =>,
						  ErrorId	  =>,
						  Value		  => _Jerk);

			IF ReadParameter.Valid THEN
				ReadParameter(Axis := _Axis, Enable := FALSE);
				NextStep(Sequence);
			END_IF

		30:
			ReadParameter(Axis		  := _Axis,
						  Enable	  := TRUE,
						  ParameterId := EAxisParameterId.MaximumVelocity,
						  Mode		  := EReadMode.Once,
						  Valid		  =>,
						  Busy		  =>,
						  Error		  =>,
						  ErrorId	  =>,
						  Value		  => _Velocity);

			IF ReadParameter.Valid THEN
				ReadParameter(Axis := _Axis, Enable := FALSE);
				NextStep(Sequence);
			END_IF

		40:
			Trace.LogMessage(_Name, 'Axis initialization complete');
			NextStep(Sequence);

		50:
			_Initialized := TRUE;

		999: // Error :-(
	END_CASE

	IF ReadParameter.Error AND Sequence <> 999 THEN
		Trace.LogMessage(_Name, 'Axis not initialized - error reading parameter - check links!');
		Sequence := 999;
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
