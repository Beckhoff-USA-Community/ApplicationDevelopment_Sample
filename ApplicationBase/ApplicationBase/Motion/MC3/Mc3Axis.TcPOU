<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="Mc3Axis" Id="{7b755d12-bde7-47e4-872e-d19b5ce399e8}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Mc3Axis EXTENDS CyclicComponent IMPLEMENTS I_Initializable, I_Mc3Axis
VAR
	_Axis				 : REFERENCE TO Tc3_Mc3Ptp.AXIS_REF;
	Defaults			 : ST_Mc3MotionDefaults;
	MotionTaskCollection : Mc3MotionTaskCollection<ApplicationBaseMotionParameter.MaxMotionTasks>(THIS^);

	// Tasks
	PowerTask  : Mc3PowerTask	 := (Name := 'MC Power');
	JogTask	   : Mc3MoveJogTask	 := (Name := 'MC Jog');
	_StopTask  : I_Mc3MotionTask := Defaults.DefaultStopTask;
	_ResetTask : I_Mc3MotionTask := Defaults.DefaultResetTask;
	_HomeTask  : I_Mc3MotionTask := Defaults.DefaultHomeTask;
	SetOverride : Tc3_Mc3Ptp.MC_SetOverride;

	//
	_Initialized  : BOOL;
	_Acceleration : LREAL;
	_Deceleration : LREAL;
	_Velocity	  : LREAL;
	_Jerk		  : LREAL;
	_McBufferMode : Tc3_Mc3Ptp.EBufferMode		:= Tc3_Mc3Ptp.EBufferMode.Aborting;
	_Direction	  : Tc3_Mc3Ptp.EModuloDirection := Tc3_Mc3Ptp.EModuloDirection.ShortestDistance;
	_JogMode	  : Tc3_Mc3Ptp.EJogMode			:= Tc3_Mc3Ptp.EJogMode.StandardSlow;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
