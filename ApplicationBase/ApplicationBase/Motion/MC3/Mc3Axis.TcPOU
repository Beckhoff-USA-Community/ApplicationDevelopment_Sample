    <Property Name="Override" Id="{079ee53b-9370-4491-afb1-0b7f309a6f57}" FolderPath="Enable\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Override : LREAL // 0-100%]]></Declaration>
