<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <Itf Name="I_Mc3Axis" Id="{fb36648c-4ae2-4934-a09b-d28e9229474b}">
    <Declaration><![CDATA[(* MC3 flavour of I_Axis: everything generic, plus the MC3 specific settings
   and the raw Tc3_Mc3Ptp.AXIS_REF via I_Mc3AxisRef.
   This interface is MC3 bound by design. Code that should work with MC2 and
   MC3 alike must be typed on I_Axis / I_Axis_PTP instead. *)
INTERFACE I_Mc3Axis EXTENDS I_Axis, I_Mc3Settings, I_Mc3AxisRef]]></Declaration>
  </Itf>
</TcPlcObject>