<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <Itf Name="I_Mc2Axis" Id="{347e2aef-5611-452f-9ffc-b6ad926a510a}">
    <Declaration><![CDATA[(* MC2 flavour of I_Axis: everything generic, plus the MC2 specific settings
   and the raw Tc2_MC2.AXIS_REF via I_Mc2AxisRef.
   This interface is MC2 bound by design. Code that should work with MC2 and
   MC3 alike must be typed on I_Axis / I_Axis_PTP instead. *)
INTERFACE I_Mc2Axis EXTENDS I_Axis, I_Mc2Settings, I_Mc2AxisRef]]></Declaration>
  </Itf>
</TcPlcObject>