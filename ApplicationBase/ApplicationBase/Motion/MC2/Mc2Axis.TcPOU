    <Method Name="CyclicLogic" Id="{10fc0310-6f8d-455a-992b-f31a600e3e01}" FolderPath="Cyclic\">
      <Declaration><![CDATA[METHOD CyclicLogic]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _Initialized THEN
	// A parent module drives Initialize() through its Initializer. Only
	// self-initialize when there is no parent, so the call has one owner.
	IF NOT _InitializeDrivenByParent THEN
		Initialize();
	END_IF

	RETURN;
END_IF

_Axis.ReadStatus();
MotionTaskCollection.CyclicLogic();]]></ST>
      </Implementation>
    </Method>
