    <Method Name="Jog" Id="{c855961c-fd72-4b30-bb3c-30f7dfb030f5}" FolderPath="Jog\">
      <Declaration><![CDATA[METHOD Jog
VAR_INPUT
	JogForward	 : BOOL;
	JogBackwards : BOOL;
	Distance	 : LREAL := 0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Error OR Coupled THEN
	RETURN;
END_IF

JogTask.JogBackwards := JogBackwards;
JogTask.JogForward	 := JogForward;
JogTask.Position	 := Distance;
JogTask.Mode		 := _JogMode;
JogTask.Execute();]]></ST>
      </Implementation>
    </Method>
    <Property Name="JogMode" Id="{cc91e9f8-9b64-407b-bfcb-72aff2578f80}" FolderPath="Settings\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY JogMode : E_AxisJogMode]]></Declaration>
      <Get Name="Get" Id="{543a0da7-d855-4288-9d69-02ff90a93b9b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF _JogMode = Tc2_MC2.E_JogMode.MC_JOGMODE_STANDARD_FAST THEN
	JogMode := E_AxisJogMode.Fast;
ELSE
	JogMode := E_AxisJogMode.Slow;
END_IF]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{0aade66c-e629-4232-9bdb-e5b7a262f5d9}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF JogMode = E_AxisJogMode.Fast THEN
	_JogMode := Tc2_MC2.E_JogMode.MC_JOGMODE_STANDARD_FAST;
ELSE
	_JogMode := Tc2_MC2.E_JogMode.MC_JOGMODE_STANDARD_SLOW;
END_IF]]></ST>
        </Implementation>
      </Set>
    </Property>
