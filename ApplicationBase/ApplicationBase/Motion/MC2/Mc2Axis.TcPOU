        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[MotionTaskCollection.RemoveTaskByInstance(_ResetTask);
_ResetTask := ResetTask;
MotionTaskCollection.AddTask(_ResetTask);]]></ST>
        </Implementation>
      </Set>
    </Property>
