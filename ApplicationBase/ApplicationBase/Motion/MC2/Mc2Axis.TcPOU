<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="Mc2Axis" Id="{c3c03e8a-759c-4ce9-bcae-63318d943e7c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Mc2Axis EXTENDS CyclicComponent IMPLEMENTS I_Initializable, I_Mc2Axis
VAR
	_Axis				 : REFERENCE TO Tc2_MC2.AXIS_REF;
	Defaults			 : ST_Mc2MotionDefaults;
	MotionTaskCollection : Mc2MotionTaskCollection<ApplicationBaseMotionParameter.MaxMotionTasks>(THIS^);

	// Tasks
	{attribute 'hide'}
	PowerTask : Mc2PowerTask := (Name := 'MC Power');
	{attribute 'hide'}
	JogTask : Mc2MoveJogTask := (Name := 'MC Jog');
	{attribute 'hide'}
	_StopTask : I_Mc2MotionTask := Defaults.DefaultStopTask;
	{attribute 'hide'}
	_ResetTask : I_Mc2MotionTask := Defaults.DefaultResetTask;
	{attribute 'hide'}
	_HomeTask : I_Mc2MotionTask := Defaults.DefaultHomeTask;

	// Initialization is delegated to its own component
	ParameterLoader : Mc2AxisParameterLoader;
	{attribute 'hide'}
	_Initialized : BOOL;
	// TRUE once a parent module owns our Initialize() call
	{attribute 'hide'}
	_InitializeDrivenByParent : BOOL;
	{attribute 'hide'}
	_LoadErrorLogged : BOOL;

	//
	{attribute 'hide'}
	_Acceleration : LREAL;
	{attribute 'hide'}
	_Deceleration : LREAL;
	{attribute 'hide'}
	_Velocity : LREAL;
	{attribute 'hide'}
	_Jerk		  : LREAL;
	_McBufferMode : Tc2_MC2.MC_BufferMode;
	_MoveOptions  : Tc2_MC2.ST_MoveOptions;
	_Direction	  : Tc2_MC2.MC_Direction := Tc2_MC2.MC_Direction.MC_Shortest_Way;
	_JogMode	  : Tc2_MC2.E_JogMode	 := Tc2_MC2.E_JogMode.MC_JOGMODE_STANDARD_SLOW;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
