    <Method Name="Initialize" Id="{66bade57-0863-4af8-8c50-55eb772839b1}" FolderPath="Initialize\">
      <Declaration><![CDATA[METHOD Initialize]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _Initialized THEN
	RETURN;
END_IF

ParameterLoader.Initialize();

IF ParameterLoader.Initialized THEN
	_Velocity	  := ParameterLoader.AxisParameterSet.fVeloSlowManual;
	_Acceleration := ParameterLoader.AxisParameterSet.fAcceleration;
	_Deceleration := ParameterLoader.AxisParameterSet.fDeceleration;
	_Jerk		  := ParameterLoader.AxisParameterSet.fJerk;
	Trace.LogMessage(_Name, 'Axis initialization complete');
	_Initialized := TRUE;
	RETURN;
END_IF

IF ParameterLoader.Error AND NOT _LoadErrorLogged THEN
	_LoadErrorLogged := TRUE;
	Trace.LogMessage(_Name, 'Axis not initialized - McReadParameter failed!');
END_IF]]></ST>
      </Implementation>
    </Method>
