        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[MotionTaskCollection.RemoveTaskByInstance(_StopTask);
_StopTask := StopTask;
MotionTaskCollection.AddTask(_ResetTask);]]></ST>
        </Implementation>
