    <Method Name="RegisterWithParent" Id="{7c253cad-8e86-46be-a1de-97f3fe4d6992}" FolderPath="Component\">
      <Declaration><![CDATA[METHOD RegisterWithParent
VAR_INPUT
	Parent : I_ContainComponents;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.RegisterWithParent(Parent);
Parent.RegisterInitialize(THIS^);
_InitializeDrivenByParent := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{4345ab78-8abd-4dc4-8462-07064700c600}" FolderPath="Reset\">
      <Declaration><![CDATA[METHOD Reset]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _ResetTask.Execute() THEN
	MotionTaskCollection.Reset();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="ResetTask" Id="{b49f90e4-bf55-4e04-8fe2-be9f3fad9f2b}" FolderPath="Reset\">
