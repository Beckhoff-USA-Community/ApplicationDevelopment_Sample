      <Set Name="Set" Id="{99467d9a-fbd5-4581-897d-65ef07609208}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_RatioDenominator := RatioDenominator;]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Property Name="RatioNumerator" Id="{348ae990-2cef-4379-aa55-ad15c8a94ccf}">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY RatioNumerator : LREAL]]></Declaration>
      <Set Name="Set" Id="{51db2914-c08e-49f1-adff-1504aed61cf3}">
