      <Declaration><![CDATA[PROPERTY InGear : BOOL]]></Declaration>
      <Set Name="Set" Id="{46241fd3-4ea3-4d32-9cfa-fbd084e4eae3}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[_InGear := InGear;]]></ST>
