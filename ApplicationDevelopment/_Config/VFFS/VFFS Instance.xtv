				</Relation>
			</Relations>
		</DataType>
		<DataType>
			<Name GUID="{ABD7A116-8AB9-4E1A-99C3-07858EE414A0}" Namespace="MC" TcBaseType="true">CDT_MCTOPLC_AXIS_FLUIDPOWER</Name>
			<Comment><![CDATA[CDT provides fluid power specific setpoint and actpoint.]]></Comment>
			<BitSize>640</BitSize>
			<SubItem>
				<Name>IsConnected</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[TRUE if the data area is connected and data is being received from MC.]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>0</BitOffs>
			</SubItem>
			<SubItem>
				<Name>ActPressureA</Name>
				<Type GUID="{49CA3172-48CF-4AF2-88AD-7F479944AB64}" Namespace="MC">LoadData</Type>
				<Comment><![CDATA[PressureA actpoint]]></Comment>
				<BitSize>192</BitSize>
				<BitOffs>64</BitOffs>
			</SubItem>
