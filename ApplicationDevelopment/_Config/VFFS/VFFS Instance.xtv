		</DataType>
		<DataType>
			<Name GUID="{CF9F9285-BE5D-469F-BB76-FE58A946F660}" Namespace="MC" TcBaseType="true">ELoadType</Name>
			<Comment><![CDATA[Indicates the type of the currently selected load of the axis.]]></Comment>
			<BitSize>32</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000008}">UDINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[None]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[No load control active.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Force]]></Text>
				<Enum>2</Enum>
				<Comment><![CDATA[Load control based on force.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[PressureA]]></Text>
				<Enum>3</Enum>
				<Comment><![CDATA[Load control based on pressure at area A of the cylinder.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[PressureB]]></Text>
				<Enum>4</Enum>
				<Comment><![CDATA[Load control based on pressure at area B of the cylinder.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[DirectVelocityOutput]]></Text>
				<Enum>5</Enum>
				<Comment><![CDATA[Velocity setpoint is written directly to the drive output.]]></Comment>
			</EnumInfo>
			<Properties>
				<Property>
					<Name>plcAttribute_qualified_only</Name>
				</Property>
				<Property>
					<Name>plcAttribute_strict</Name>
				</Property>
				<Property>
					<Name>plcAttribute_to_string</Name>
				</Property>
			</Properties>
			<Hides>
				<Hide GUID="{C30BA4E3-B1A6-4607-B389-710F8A9F5693}"/>
			</Hides>
		</DataType>
		<DataType>
			<Name GUID="{49CA3172-48CF-4AF2-88AD-7F479944AB64}" Namespace="MC" TcBaseType="true">LoadData</Name>
			<BitSize>192</BitSize>
			<SubItem>
				<Name>Value</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</Type>
				<Comment><![CDATA[Current load value in the configured load unit.]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>0</BitOffs>
				<Unit><![CDATA[[Unit]]]></Unit>
			</SubItem>
			<SubItem>
				<Name>Derivative</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</Type>
				<Comment><![CDATA[First time derivative of the load value.]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>64</BitOffs>
				<Unit><![CDATA[[Unit]/s]]></Unit>
			</SubItem>
			<SubItem>
				<Name HideItem="true">SecondDerivative</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</Type>
				<Comment><![CDATA[Second time derivative of the load value.]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>128</BitOffs>
				<Unit><![CDATA[[Unit]/s^2]]></Unit>
			</SubItem>
			<Hides>
				<Hide GUID="{F7620BC4-20C0-4D21-9ECB-42FABAF0E6E7}"/>
				<Hide GUID="{710C97BB-58DA-489A-822C-39B2F054620C}"/>
			</Hides>
		</DataType>
		<DataType>
			<Name GUID="{FAA1A803-EAD7-4A75-B851-39DA12582F94}" Namespace="MC" TcBaseType="true">CDT_MCTOPLC_AXIS_LOADCONTROL</Name>
			<Comment><![CDATA[CDT provides load setpoint and actpoint.]]></Comment>
			<BitSize>512</BitSize>
			<SubItem>
				<Name>IsConnected</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[TRUE if the data area is connected and data is beeing received from MC.]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>0</BitOffs>
			</SubItem>
			<SubItem>
				<Name>IsInLoadMode</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[True if the axis is producing load setpoints, false otherwise.]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>8</BitOffs>
			</SubItem>
			<SubItem>
				<Name>LoadType</Name>
				<Type GUID="{CF9F9285-BE5D-469F-BB76-FE58A946F660}" Namespace="MC">ELoadType</Type>
				<Comment><![CDATA[Load selected for load control.]]></Comment>
				<BitSize>32</BitSize>
				<BitOffs>64</BitOffs>
			</SubItem>
			<SubItem>
				<Name>Set</Name>
				<Type GUID="{49CA3172-48CF-4AF2-88AD-7F479944AB64}" Namespace="MC">LoadData</Type>
				<Comment><![CDATA[Current load setpoint.]]></Comment>
				<BitSize>192</BitSize>
				<BitOffs>128</BitOffs>
			</SubItem>
			<SubItem>
				<Name>Act</Name>
				<Type GUID="{49CA3172-48CF-4AF2-88AD-7F479944AB64}" Namespace="MC">LoadData</Type>
				<Comment><![CDATA[Current load actpoint.]]></Comment>
				<BitSize>192</BitSize>
				<BitOffs>320</BitOffs>
			</SubItem>
			<Hides>
				<Hide GUID="{852492A4-8E0A-4240-80C1-72535FF50AB0}"/>
				<Hide GUID="{5AB529E5-CBAB-4F1F-A4C0-220BBDAFC4AB}"/>
				<Hide GUID="{222F7CA1-43FF-474A-AC84-1035F5DA7F7A}"/>
