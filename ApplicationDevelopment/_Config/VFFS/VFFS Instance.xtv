		<DataType>
			<Name GUID="{0B0DBDAE-EDDB-492C-A6B1-EEFFED71DF0D}" Namespace="MC" TcBaseType="true">CDT_MCTOPLC_AXIS_SET</Name>
			<Comment><![CDATA[CDT provides current set values.]]></Comment>
			<BitSize>320</BitSize>
			<SubItem>
				<Name>IsConnected</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[TRUE if the data area is connected and data is beeing received from MC.]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>0</BitOffs>
			</SubItem>
			<SubItem>
				<Name>Position</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</Type>
				<Comment><![CDATA[Current position setpoint of the axis.]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>64</BitOffs>
			</SubItem>
			<SubItem>
				<Name>Velocity</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</Type>
				<Comment><![CDATA[Current velocity setpoint of the axis.]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>128</BitOffs>
			</SubItem>
			<SubItem>
				<Name>Acceleration</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</Type>
				<Comment><![CDATA[Current acceleration setpoint of the axis.]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>192</BitOffs>
			</SubItem>
