<?xml version="1.0"?>
<TcSmItem xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.beckhoff.com/schemas/2012/07/TcSmProject" TcSmVersion="1.0" TcVersion="3.1.4026.27" ClassName="CTComPlcObjDef">
	<DataTypes>
		<DataType>
			<Name GUID="{4FF974A8-531B-49D0-8DF5-E3398C9DA9C3}" Namespace="MC" TcBaseType="true">EAxisState</Name>
			<BitSize>16</BitSize>
			<BaseType GUID="{18071995-0000-0000-0000-000000000005}">UINT</BaseType>
			<EnumInfo>
				<Text><![CDATA[Invalid]]></Text>
				<Enum>0</Enum>
				<Comment><![CDATA[Axis object is not initialized or in an undefined state.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Disabled]]></Text>
				<Enum>1</Enum>
				<Comment><![CDATA[Axis is disabled and the drive power stage is off.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Standstill]]></Text>
				<Enum>2</Enum>
				<Comment><![CDATA[Axis is enabled and at standstill, ready to accept motion commands.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Homing]]></Text>
				<Enum>3</Enum>
				<Comment><![CDATA[Axis is performing a homing procedure to establish a reference position.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[ErrorStop]]></Text>
				<Enum>4</Enum>
				<Comment><![CDATA[Axis has stopped due to an error. Error must be reset before further motion.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Stopping]]></Text>
				<Enum>5</Enum>
				<Comment><![CDATA[Axis is decelerating to standstill during a stop command and remains in this state until Execute for stop command is released.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[DiscreteMotion]]></Text>
				<Enum>6</Enum>
				<Comment><![CDATA[Axis is executing a point-to-point motion command with a defined target position.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[ContinuousMotion]]></Text>
				<Enum>7</Enum>
				<Comment><![CDATA[Axis is executing a continuous velocity motion without a defined end position.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[SynchronizedMotion]]></Text>
				<Enum>8</Enum>
				<Comment><![CDATA[Axis is coupled to a master axis and following synchronized setpoints (e.g. gearing, camming).]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[ResetPending]]></Text>
				<Enum>10</Enum>
				<Comment><![CDATA[An error reset has been requested and is being processed.]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Enabling]]></Text>
				<Enum>11</Enum>
				<Comment><![CDATA[Axis is in the process of being enabled (drive power stage is starting up).]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[Disabling]]></Text>
				<Enum>12</Enum>
				<Comment><![CDATA[Axis is in the process of being disabled (drive power stage is shutting down).]]></Comment>
			</EnumInfo>
			<EnumInfo>
				<Text><![CDATA[NotReady]]></Text>
				<Enum>13</Enum>
				<Comment><![CDATA[Axis is not ready for operation, e.g. waiting for required sub-modules to initialize or to start up.]]></Comment>
			</EnumInfo>
			<Properties>
				<Property>
					<Name>plcAttribute_qualified_only</Name>
				</Property>
				<Property>
					<Name>plcAttribute_strict</Name>
				</Property>
				<Property>
					<Name>plcAttribute_to_string</Name>
				</Property>
			</Properties>
			<Hides>
				<Hide GUID="{64ADA9A8-4EAE-4872-9C2D-E6B7FA96B984}"/>
			</Hides>
		</DataType>
		<DataType>
			<Name GUID="{E7BFE865-900F-4F3A-B607-76F75FE96459}" Namespace="MC" TcBaseType="true">CDT_MCTOPLC_AXIS_STD</Name>
			<BitSize>192</BitSize>
			<SubItem>
				<Name>AxisOid</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000F}">OTCID</Type>
				<Comment><![CDATA[Object ID of the axis for identification.]]></Comment>
				<BitSize>32</BitSize>
				<BitOffs>0</BitOffs>
			</SubItem>
			<SubItem>
				<Name>AxisState</Name>
				<Type GUID="{4FF974A8-531B-49D0-8DF5-E3398C9DA9C3}" Namespace="MC">EAxisState</Type>
				<Comment><![CDATA[Current state of the axis state machine.]]></Comment>
				<BitSize>16</BitSize>
				<BitOffs>32</BitOffs>
			</SubItem>
			<SubItem>
				<Name>IsInControl</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[TRUE if the axis controller is actively controlling the drive (control loop closed).]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>48</BitOffs>
			</SubItem>
			<SubItem>
				<Name>HasError</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[TRUE if the axis is in an error state.]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>56</BitOffs>
			</SubItem>
			<SubItem>
				<Name>ErrorId</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000008}">UDINT</Type>
				<Comment><![CDATA[Error code of the current axis error (0 if no error).]]></Comment>
				<BitSize>32</BitSize>
				<BitOffs>64</BitOffs>
			</SubItem>
			<SubItem>
				<Name>IsPositionValid</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[TRUE if the reported position values are valid (e.g. after homing or with absolute encoder and drive/encoder signals a valid position).]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>96</BitOffs>
			</SubItem>
			<SubItem>
				<Name>DcTime</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000C}">LINT</Type>
				<Comment><![CDATA[Distributed clock timestamp of the cyclic data exchange.]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>128</BitOffs>
			</SubItem>
			<Hides>
				<Hide GUID="{A078A7A3-A581-4C4D-8E9A-775A3EEC1AA5}"/>
				<Hide GUID="{1FDF4C99-95D5-41A1-806D-90D273DC6BDC}"/>
			</Hides>
