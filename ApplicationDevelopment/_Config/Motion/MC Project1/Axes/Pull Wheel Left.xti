		<DataType>
			<Name GUID="{928ACD6D-34F6-4728-BC12-CB3937EB34C2}" Namespace="MC" TcBaseType="true">CDT_PLCTOMC_AXIS_STD</Name>
			<BitSize>192</BitSize>
			<SubItem>
				<Name>Enable</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[Enables the axis power stage.]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>0</BitOffs>
			</SubItem>
			<SubItem>
				<Name>EnablePositive</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[Allows motion in positive direction when TRUE.]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>8</BitOffs>
			</SubItem>
			<SubItem>
				<Name>EnableNegative</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[Allows motion in negative direction when TRUE.]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>16</BitOffs>
			</SubItem>
			<Hides>
				<Hide GUID="{83F84DB6-EBE2-4013-96D4-729A54553EDC}"/>
				<Hide GUID="{EC5954F8-EAC3-4E8C-BB06-1CA66ACC17DB}"/>
				<Hide GUID="{5A944F05-2D7C-4FD6-9ABA-134068F48E38}"/>
				<Hide GUID="{BDE5BC28-38E9-438E-81EF-FD1285D93E36}"/>
