		<DataType>
			<Name GUID="{ABD7A116-8AB9-4E1A-99C3-07858EE414A0}" Namespace="MC" TcBaseType="true">CDT_MCTOPLC_AXIS_FLUIDPOWER</Name>
			<Comment><![CDATA[CDT provides fluid power specific setpoint and actpoint.]]></Comment>
