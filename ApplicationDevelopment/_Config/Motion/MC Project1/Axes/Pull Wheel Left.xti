					<Type GUID="{D27F3152-C087-4D28-8C07-DBCD0A6C21D7}">DeprecatedName</Type>
				</Relation>
			</Relations>
		</DataType>
		<DataType>
			<Name GUID="{A44CE81F-76FF-4B9B-9906-BBAF0C1247D2}" Namespace="MC" TcBaseType="true">CDT_MCTOPLC_AXIS_MODULO</Name>
			<Comment><![CDATA[CDT provides information about modulo positioning.]]></Comment>
			<BitSize>320</BitSize>
			<SubItem>
				<Name>IsConnected</Name>
				<Type GUID="{18071995-0000-0000-0000-000000000030}">BOOL</Type>
				<Comment><![CDATA[TRUE if the data area is connected and data is beeing received from MC.]]></Comment>
				<BitSize>8</BitSize>
				<BitOffs>0</BitOffs>
			</SubItem>
			<SubItem>
				<Name>SetPosition</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</Type>
				<Comment><![CDATA[Modulo set position within one modulo period.]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>64</BitOffs>
			</SubItem>
			<SubItem>
				<Name>SetTurns</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000C}">LINT</Type>
				<Comment><![CDATA[Number of complete modulo turns for the set position.]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>128</BitOffs>
			</SubItem>
			<SubItem>
				<Name>ActPosition</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</Type>
				<Comment><![CDATA[Modulo actual position within one modulo period.]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>192</BitOffs>
			</SubItem>
			<SubItem>
				<Name>ActTurns</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000C}">LINT</Type>
				<Comment><![CDATA[Number of complete modulo turns for the actual position.]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>256</BitOffs>
			</SubItem>
			<Hides>
				<Hide GUID="{D0D202B0-695B-4EBE-A25A-AE633C79AA06}"/>
				<Hide GUID="{026571D6-A448-4788-8757-4CF182F433BA}"/>
			</Hides>
			<Relations>
				<Relation>
					<Type GUID="{D0D202B0-695B-4EBE-A25A-AE633C79AA06}">DeprecatedName</Type>
				</Relation>
				<Relation>
					<Type GUID="{94C5E2EE-D9E5-47CE-9992-C7194EF71430}">DeprecatedName</Type>
				</Relation>
			</Relations>
		</DataType>
		<DataType>
			<Name GUID="{49CA3172-48CF-4AF2-88AD-7F479944AB64}" Namespace="MC" TcBaseType="true">LoadData</Name>
			<BitSize>192</BitSize>
			<SubItem>
				<Name>Value</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</Type>
				<Comment><![CDATA[Current load value in the configured load unit.]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>0</BitOffs>
				<Unit><![CDATA[[Unit]]]></Unit>
			</SubItem>
			<SubItem>
				<Name>Derivative</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</Type>
				<Comment><![CDATA[First time derivative of the load value.]]></Comment>
				<BitSize>64</BitSize>
				<BitOffs>64</BitOffs>
				<Unit><![CDATA[[Unit]/s]]></Unit>
			</SubItem>
			<SubItem>
				<Name HideItem="true">SecondDerivative</Name>
				<Type GUID="{18071995-0000-0000-0000-00000000000E}">LREAL</Type>
