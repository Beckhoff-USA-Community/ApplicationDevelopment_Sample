    <Method Name="Resetting" Id="{50b5bfae-604c-4ee6-a5c3-01ae227e0fa8}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Resetting : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE Statemachine.Mode.CurrentMode OF
	E_PMLProtectedUnitMode.Production:
		Sealer.Recipe	  := Recipe.Sealer;
		Unwind.Recipe	  := Recipe.Unwind;
		PullWheels.Recipe := Recipe.PullWheels;

	E_PMLProtectedUnitMode.Maintenance, E_PMLProtectedUnitMode.Manual:
		;
END_CASE

IF ChangeStateOnAllSubModules.ChangeState(E_PMLCommand.Reset, THIS^) THEN
	Resetting := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
