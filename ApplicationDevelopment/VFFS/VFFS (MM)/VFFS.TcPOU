    <Method Name="Starting" Id="{5a271cdf-6204-4c6f-b12c-34efa89d538d}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Starting : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE Statemachine.Mode.CurrentMode OF
	E_PMLProtectedUnitMode.Production:
		Sealer.SealBar.Heat := TRUE;
		Starting			:= TRUE;

	E_PMLProtectedUnitMode.Maintenance, E_PMLProtectedUnitMode.Manual:
		IF ChangeStateOnAllSubModules.ChangeState(E_PMLCommand.Start, THIS^) THEN
			Starting := TRUE;
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stopping" Id="{0edcaa05-9eaa-4bdb-9cb8-ab7cd26bf4ab}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Stopping : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ChangeStateOnAllSubModules.ChangeState(E_PMLCommand.Stop, THIS^) THEN
	Stopping := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Suspended" Id="{9111e456-d45f-4a0e-b49f-e398905c589c}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Suspended : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Sealer.SealBar.InTempRange THEN
	Statemachine.ChangeState(E_PMLCommand.Unsuspend);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Suspending" Id="{14e1196d-8a20-49d0-8352-5fa264937fd4}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Suspending : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE Statemachine.Mode.CurrentMode OF
	E_PMLProtectedUnitMode.Production:
		IF (Sealer.Statemachine.CurrentState = E_PMLState.Completed OR Sealer.Statemachine.CurrentState = E_PMLState.Idle) AND (PullWheels.Statemachine.CurrentState = E_PMLState.Completed OR PullWheels.Statemachine.CurrentState = E_PMLState.Idle) THEN
			Suspending := TRUE;
		END_IF

	E_PMLProtectedUnitMode.Maintenance, E_PMLProtectedUnitMode.Manual:
		IF ChangeStateOnAllSubModules.ChangeState(E_PMLCommand.Suspend, THIS^) THEN
			Suspending := TRUE;
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Unholding" Id="{c8a1a088-ecf5-441e-9877-1dfd3ca0919e}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Unholding : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE Statemachine.Mode.CurrentMode OF
	E_PMLProtectedUnitMode.Production:
		Unholding := TRUE;

	E_PMLProtectedUnitMode.Maintenance, E_PMLProtectedUnitMode.Manual:
		IF ChangeStateOnAllSubModules.ChangeState(E_PMLCommand.Unhold, THIS^) THEN
			Unholding := TRUE;
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
