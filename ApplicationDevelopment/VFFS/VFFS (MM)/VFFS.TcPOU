<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="VFFS" Id="{9da83f2c-1519-41d0-a4b0-5202777e3e35}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK VFFS EXTENDS PackMLModule IMPLEMENTS I_VFFS
VAR
	Events			  : TcEventClass('VFFS Events');
	EventReactor	  : EventReactorPackMLVisitor('VFFS Event Reaction', THIS^);
	SyncedSquareWaves : SyncedSquareWaves('Waves');

	//
	EStop1_Pressed : BOOL := FALSE;
	EStop2_Pressed : BOOL := FALSE;

	//
	_Unwind		  : Unwind('Unwind EM');
	_Sealer		  : Sealer('Sealer EM');
	Sealer_Events : Sealer_TcEvents('Sealer EM Events', _Sealer);
	_PullWheels	  : PullWheels('Pull Wheels EM');

	// Recipe
	_Recipe : ST_Recipe;
	{ attribute 'TcHmiSymbol.AddSymbol' }
	{ attribute 'TcHmiSymbol.AddSymbol.UserGroups' := '__SystemAdministrators, Admin' }
	Recipe_HMI		: ST_Recipe;
	RecipeManagment : RecipeManagment('VFFS Recipe', nRecipe := SIZEOF(ST_Recipe), pActiveRecipeData := ADR(_Recipe), pUpdateRecipeData := ADR(Recipe_HMI));
END_VAR

VAR
	VFFS_HMI   : VFFS_HMI('VFFS', _Statemachine, THIS^);
	Custom_HMI : Custom_HMI('Custom');
END_VAR

VAR
	_Override : LREAL := 100.0;
	{attribute 'hide'}
	_Busy : BOOL;
	{attribute 'hide'}
	_Error : BOOL;
	{attribute 'hide'}
	_ErrorId	   : UDINT;
	_PartsProduced : ULINT;
	_SealingTime   : LREAL;
	_PullingTime   : LREAL;
	_PartTime	   : LREAL;
	{attribute 'OPC.UA.DA' := '1'}
	_PackTags : ST_PMLV2022;
END_VAR

VAR
	ChangeStateOnAllSubModules : ChangePackMLStateOnAllSubModulesVisitor;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Constructor" Id="{7cbdf2ce-4d6a-487e-9d75-9adc8307e536}" />
