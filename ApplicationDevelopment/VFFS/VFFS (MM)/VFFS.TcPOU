    <Property Name="ErrorId" Id="{5738b251-3e71-4c0d-aeaa-aa112ecda93d}" FolderPath="Status\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ErrorId : UDINT]]></Declaration>
