    <Method Name="Clearing" Id="{046e3c42-e409-4d4e-a160-7d027c74c2e5}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Clearing : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE SequenceState OF
	0:
		Reset();
		IF ResetComponents() AND ResetModules() AND NOT Busy AND NOT Error THEN
			SequenceState := SequenceState + 10;
		END_IF

	10:
		IF ChangeStateOnAllSubModules.ChangeState(E_PMLCommand.Clear, THIS^) THEN
			Clearing := TRUE;
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Completing" Id="{5b5aa576-f457-4203-94e4-180ae820393c}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Completing : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE Statemachine.Mode.CurrentMode OF
	E_PMLProtectedUnitMode.Production:
		Completing := TRUE;

	E_PMLProtectedUnitMode.Maintenance, E_PMLProtectedUnitMode.Manual:
		IF ChangeStateOnAllSubModules.ChangeState(E_PMLCommand.Complete, THIS^) THEN
			Completing := TRUE;
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
