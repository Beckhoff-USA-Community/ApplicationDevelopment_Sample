    <Method Name="Aborting" Id="{95217094-6cfb-4676-9b2e-e833f143644d}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Aborting : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF ChangeStateOnAllSubModules.ChangeState(E_PMLCommand.Abort, THIS^) THEN
	Aborting := TRUE;
END_IF]]></ST>
      </Implementation>
    </Method>
