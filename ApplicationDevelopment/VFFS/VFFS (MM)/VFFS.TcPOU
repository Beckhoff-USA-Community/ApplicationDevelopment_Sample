    <Method Name="Execute" Id="{b869e0ce-de3d-4b70-bfa0-95f218146fa2}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Execute : BOOL
VAR_INST
	SealTime : Stopwatch;
	SealTrig : R_TRIG;
	PullTime : Stopwatch;
	Pulltrig : R_TRIG;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE Statemachine.Mode.CurrentMode OF
	E_PMLProtectedUnitMode.Production:
		(* Run the sequence to make products 
		 Unwind Runs Slowly 
		 Pull Wheels Run 
		 Jaws Seal, and Repeat until production reached*)
		SealTrig(CLK := SequenceState = 10);
		IF SealTrig.Q THEN
			SealTime.Start();
		END_IF

		Pulltrig(CLK := SequenceState = 20);
		IF Pulltrig.Q THEN
			PullTime.Start();
		END_IF

		IF Sealer.SealBar.InTempRange THEN
			CASE SequenceState OF
				0:
					Unwind.Statemachine.ChangeState(E_PMLCommand.Start);
					IF Unwind.Statemachine.CurrentState = E_PMLState.Execute THEN
						NextStep(SequenceState);
					END_IF

				10:
					Sealer.Statemachine.ChangeState(E_PMLCommand.Start);
					NextMinorStep(SequenceState);

				11:
					IF Sealer.Statemachine.CurrentState = E_PMLState.Completed THEN
						Sealer.Statemachine.ChangeState(E_PMLCommand.Reset);
						SealTime.Stop();
						SealingTime := SealTime.Elapsed;
						NextStep(SequenceState);
					END_IF

				20:
					PullWheels.Statemachine.ChangeState(E_PMLCommand.Start);
					NextMinorStep(SequenceState);

				21:
					IF PullWheels.Statemachine.CurrentState = E_PMLState.Completed THEN
						PullWheels.Statemachine.ChangeState(E_PMLCommand.Reset);
						PartsProduced := PartsProduced + 1;
						PullTime.Stop();
						PullingTime	  := PullTime.Elapsed;
						PartTime	  := PullTime.Elapsed + SealTime.Elapsed;
						SequenceState := 10;
					END_IF
			END_CASE
		ELSE
			Statemachine.ChangeState(E_PMLCommand.Suspend);
		END_IF

	E_PMLProtectedUnitMode.Maintenance, E_PMLProtectedUnitMode.Manual:
		Execute := TRUE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{ebfe6509-bc9a-4e77-b2d3-d43fe25436a3}" FolderPath="Constructor\">
      <Declaration><![CDATA[(*FB_Init is always available implicitly and it is used primarily for initialization.
The return value is not evaluated. For a specific influence, you can also declare the
methods explicitly and provide additional code there with the standard initialization
code. You can evaluate the return value.*)
METHOD FB_Init : BOOL
VAR_INPUT
	(* TRUE: the retain variables are initialized (reset warm / reset cold)*)
	bInitRetains : BOOL;

	(* TRUE: the instance will be copied to the copy code afterward (online change)   *)
	bInCopyCode : BOOL;
	Name		: T_MaxString;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Events.GenerateTcEvents('VFFS', ADR(TC_Events.VFFS), SIZEOF(ST_VFFS));
Events.RegisterWithParent(THIS^);
Events.SetEvent(E_Vffs.EstopOK_1, ADR(EStop1_Pressed), FALSE);
Events.SetEvent(E_Vffs.EstopOK_2, ADR(EStop2_Pressed), TRUE);

//
EventReactor.RegisterWithParent(THIS^);
VFFS_HMI.RegisterWithParent(THIS^);
SyncedSquareWaves.RegisterWithParent(THIS^);

//
_Unwind.RegisterWithParent(THIS^);
_Sealer.RegisterWithParent(THIS^);
Sealer_Events.RegisterWithParent(THIS^);
_PullWheels.RegisterWithParent(THIS^);

//
RecipeManagment.RegisterWithParent(THIS^);
RecipeManagment.AutoLoadChangesToActive := TRUE;

//
Custom_HMI.RegisterWithParent(THIS^);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Holding" Id="{e05bb9be-3963-4eca-a642-518ab96e54c7}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Holding : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE Statemachine.Mode.CurrentMode OF
	E_PMLProtectedUnitMode.Production:
		IF (Sealer.Statemachine.CurrentState = E_PMLState.Completed OR Sealer.Statemachine.CurrentState = E_PMLState.Idle) AND (PullWheels.Statemachine.CurrentState = E_PMLState.Completed OR PullWheels.Statemachine.CurrentState = E_PMLState.Idle) THEN
			Holding := TRUE;
		END_IF

	E_PMLProtectedUnitMode.Maintenance, E_PMLProtectedUnitMode.Manual:
		IF ChangeStateOnAllSubModules.ChangeState(E_PMLCommand.Hold, THIS^) THEN
			Holding := TRUE;
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initializing" Id="{098ab474-7a33-4155-9772-c57a22f3038a}" FolderPath="Initialize\">
      <Declaration><![CDATA[(* This Module will be done initializeing when ModuleInitialized := TRUE;, subequently all subitems will be called to be initialized*)
METHOD Initializing
VAR_INST
	UnitModeConfig : FB_PMLUnitModeConfig;
	SequenceState  : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE SequenceState OF
	0:
		UnitModeConfig(eMode						  := E_PMLProtectedUnitMode.Production,
					   sName						  := 'Mode Production',
					   bDisableClearing				  := FALSE,
					   bDisableStarting				  := FALSE,
					   bDisableSuspended			  := FALSE,
					   bDisableStopping				  := FALSE,
					   bDisableAborting				  := FALSE,
					   bDisableHolding				  := FALSE,
					   bDisableHeld					  := FALSE,
					   bDisableUnholding			  := FALSE,
					   bDisableSuspending			  := FALSE,
					   bDisableUnsuspending			  := FALSE,
					   bDisableResetting			  := FALSE,
					   bDisableIdle					  := FALSE,
					   bDisableCompleting			  := FALSE,
					   bDisableComplete				  := FALSE,
					   bEnableUnitModeChangeStopped	  := TRUE,
					   bEnableUnitModeChangeIdle	  := FALSE,
					   bEnableUnitModeChangeSuspended := FALSE,
					   bEnableUnitModeChangeExecute	  := FALSE,
					   bEnableUnitModeChangeAborted	  := TRUE,
					   bEnableUnitModeChangeHeld	  := FALSE,
					   bEnableUnitModeChangeComplete  := FALSE,
					   bError						  =>,
					   nErrorId						  =>);

		UnitModeConfig(eMode						  := E_PMLProtectedUnitMode.Maintenance,
					   sName						  := 'Mode Maintenance',
					   bDisableClearing				  := FALSE,
					   bDisableStarting				  := FALSE,
					   bDisableSuspended			  := FALSE,
					   bDisableStopping				  := FALSE,
					   bDisableAborting				  := FALSE,
					   bDisableHolding				  := FALSE,
					   bDisableHeld					  := FALSE,
					   bDisableUnholding			  := FALSE,
					   bDisableSuspending			  := FALSE,
					   bDisableUnsuspending			  := FALSE,
					   bDisableResetting			  := FALSE,
					   bDisableIdle					  := FALSE,
					   bDisableCompleting			  := FALSE,
					   bDisableComplete				  := FALSE,
					   bEnableUnitModeChangeStopped	  := TRUE,
					   bEnableUnitModeChangeIdle	  := FALSE,
					   bEnableUnitModeChangeSuspended := FALSE,
					   bEnableUnitModeChangeExecute	  := FALSE,
					   bEnableUnitModeChangeAborted	  := TRUE,
					   bEnableUnitModeChangeHeld	  := FALSE,
					   bEnableUnitModeChangeComplete  := FALSE,
					   bError						  =>,
					   nErrorId						  =>);

		UnitModeConfig(eMode						  := E_PMLProtectedUnitMode.Manual,
					   sName						  := 'Mode Manual',
					   bDisableClearing				  := FALSE,
					   bDisableStarting				  := FALSE,
					   bDisableSuspended			  := FALSE,
					   bDisableStopping				  := FALSE,
					   bDisableAborting				  := FALSE,
					   bDisableHolding				  := FALSE,
					   bDisableHeld					  := FALSE,
					   bDisableUnholding			  := FALSE,
					   bDisableSuspending			  := FALSE,
					   bDisableUnsuspending			  := FALSE,
					   bDisableResetting			  := FALSE,
					   bDisableIdle					  := FALSE,
					   bDisableCompleting			  := FALSE,
					   bDisableComplete				  := FALSE,
					   bEnableUnitModeChangeStopped	  := TRUE,
					   bEnableUnitModeChangeIdle	  := FALSE,
					   bEnableUnitModeChangeSuspended := FALSE,
					   bEnableUnitModeChangeExecute	  := FALSE,
					   bEnableUnitModeChangeAborted	  := TRUE,
					   bEnableUnitModeChangeHeld	  := FALSE,
					   bEnableUnitModeChangeComplete  := FALSE,
					   bError						  =>,
					   nErrorId						  =>);

		SequenceState := SequenceState + 10;

	10:
		Statemachine.Name := 'VFFS';
		ModuleInitialized := TRUE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCyclicCall" Id="{476d3cf0-745a-4ea7-af37-cf8d6f697512}">
      <Declaration><![CDATA[METHOD OnCyclicCall
VAR_INST
	LastMode				  : DINT;
	ChangeModeOnAllSubModules : ChangeModeOnAllSubModulesVisitor;
	HmiEnableDisable		  : HmiEnableDisableAllVisitor;
	SetOverride				  : SetAllOverrideVisitor;
	ForceVisitor			  : ForceVisitor;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Mode Propagation 
IF _Statemachine.Mode.CurrentMode <> LastMode THEN
	ChangeModeOnAllSubModules.ChangeMode(_Statemachine.Mode.CurrentMode, THIS^);
	LastMode := _Statemachine.Mode.CurrentMode;
	// Enable HMI only in Manual Mode
	IF _Statemachine.Mode.CurrentMode = E_PMLProtectedUnitMode.Manual THEN
		HmiEnableDisable.EnableHmi(THIS^);
	ELSE
		HmiEnableDisable.DisableHmi(THIS^);
		VFFS_HMI.Enable();

		// Disable All Forced Variables if applicable 
		ForceVisitor.Force := E_ForceState.Unforced;
		Components.Accept(ForceVisitor);
	END_IF
END_IF

//
SetOverride.Set(THIS^, _Override);
UpdateModeTimers();
IF Events.GetHighestActiveEventSeverity() >= TcEventSeverity.Error THEN
	_Error	 := TRUE;
	_ErrorId := Events.GetHighestActiveEventReaction();
END_IF]]></ST>
      </Implementation>
    </Method>
