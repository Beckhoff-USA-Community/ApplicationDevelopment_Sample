      </Get>
    </Property>
    <Method Name="Reset" Id="{daa0d3a9-953d-44ce-ad3e-70b7bc3d9227}" FolderPath="Sealer\">
      <Declaration><![CDATA[METHOD Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Error	 := FALSE;
_ErrorId := 0;]]></ST>
      </Implementation>
    </Method>
