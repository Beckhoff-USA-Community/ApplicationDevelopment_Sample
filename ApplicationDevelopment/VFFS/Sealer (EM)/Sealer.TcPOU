<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="Sealer" Id="{56dd06c2-e02b-41a1-be93-e878ac17c4d3}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Sealer EXTENDS PackMLModule IMPLEMENTS I_Sealer
VAR
	// Components
	SealerAxisRef	  : AXIS_REF;
	_SealerAxis		  : AxisPTP('Sealer Axis', SealerAxisRef);
	SealerAxis_HMI	  : AxisPTP_HMI('Sealer Axis HMI', _SealerAxis, '°');
	SealerAxis_Events : Axis_TcEvents('Sealer Axis Events', _SealerAxis);
	_SealBar		  : SealBar('Heat Bar');

	// 
	_Recipe			 : ST_SealerRecipe;
	Statemachine_HMI : PackMLStatemachine_HMI('Sealer Statemachine HMI', _Statemachine);
END_VAR

VAR
	_Override : LREAL := 100.0;
	{attribute 'hide'}
	_Busy : BOOL;
	{attribute 'hide'}
	_Error : BOOL;
	{attribute 'hide'}
	_ErrorId : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Constructor" Id="{c1f21874-4936-4f65-90fe-0e80fad0498b}" />
    <Folder Name="Initialize" Id="{ae80e6b9-7c09-4030-98bd-c186c1ef23c3}" />
    <Folder Name="Sealer" Id="{c036ad7a-c81e-4dcf-a3ab-7fca83a4990d}" />
    <Folder Name="States" Id="{bad66d79-9d75-4a14-91d7-619da312714f}" />
    <Folder Name="Status" Id="{94c12d78-47de-40c0-bb4c-f61e8a8d825f}" />
    <Method Name="Aborting" Id="{49c9c87b-6b39-4546-9400-0b40c50c6deb}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Aborting : BOOL
VAR_INST
	DisableAll : DisableAllComponentsVisitor;
	StopAll	   : StopAllComponentsVisitor;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE SequenceState OF
	0:
		SealBar.Heat := FALSE;
		StopAll.Stop(Components);
		IF StopAll.Stopped THEN
			NextStep(SequenceState);
		END_IF

	10:
		DisableAll.Disable(Components);
		IF NOT DisableAll.Enabled THEN
			Aborting := TRUE;
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="Busy" Id="{3c1a731c-e3df-479b-8667-38a2c767a5b0}" FolderPath="Status\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Busy : BOOL
]]></Declaration>
      <Get Name="Get" Id="{c22ea46d-7aa7-423b-a827-57bd5e9e497a}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Busy := _Busy;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clearing" Id="{8a10436e-98cb-4de5-86a7-ccb1fbb95da7}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Clearing : BOOL
VAR_INST
    EnableAll: EnableAllComponentsVisitor;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE SequenceState OF
	0:
		IF ResetComponents() THEN
			NextStep(SequenceState);
		END_IF

	10:
		EnableAll.Enable(Components);
		IF EnableAll.Enabled THEN
			Clearing := TRUE;
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
