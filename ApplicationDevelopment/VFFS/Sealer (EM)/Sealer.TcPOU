      <Declaration><![CDATA[PROPERTY Recipe : REFERENCE TO ST_SealerRecipe]]></Declaration>
      <Get Name="Get" Id="{e7f6dd9b-30d1-4708-9d16-ea5acabac1d0}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
