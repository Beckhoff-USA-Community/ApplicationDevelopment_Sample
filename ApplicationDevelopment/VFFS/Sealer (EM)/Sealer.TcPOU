      </Get>
    </Property>
    <Method Name="Execute" Id="{81c14ead-2140-498a-8b9e-dfaafa056d78}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Execute : BOOL
VAR_INST
	DwellTime : TON;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE Statemachine.Mode.CurrentMode OF
	E_PMLProtectedUnitMode.Production:
		CASE SequenceState OF
			0:
				IF SealerAxis.Axis.Status.InTargetPosition AND NOT SealerAxis.Busy THEN
					DwellTime.IN  := TRUE;
					NextStep(SequenceState);
				END_IF

			10:
				IF DwellTime.Q THEN
					DwellTime.IN			:= FALSE;
					SealerAxis.Velocity		:= Recipe.Axis.Velocity;
					SealerAxis.Acceleration := Recipe.Axis.Acceleration;
					SealerAxis.MoveAbsolute(Recipe.OpenPosition);
					NextStep(SequenceState);
				END_IF

			20:
				IF SealerAxis.Axis.Status.InTargetPosition AND NOT SealerAxis.Busy THEN
					Statemachine.ChangeState(E_PmlCommand.Complete);
					Execute := TRUE;
				END_IF
		END_CASE

		DwellTime(PT := LREAL_TO_TIME(Recipe.SealTime));

	E_PMLProtectedUnitMode.Maintenance, E_PMLProtectedUnitMode.Manual:
		Execute := TRUE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{6d4e63ed-7ba1-41c9-99b5-8a09cdc02fdb}" FolderPath="Constructor\">
      <Declaration><![CDATA[(*FB_Init is always available implicitly and it is used primarily for initialization.
The return value is not evaluated. For a specific influence, you can also declare the
methods explicitly and provide additional code there with the standard initialization
code. You can evaluate the return value.*)
METHOD FB_Init : BOOL
VAR_INPUT
	(* TRUE: the retain variables are initialized (reset warm / reset cold)*)
	bInitRetains	: BOOL;
	(* TRUE: the instance will be copied to the copy code afterward (online change)   *)
	bInCopyCode	: BOOL;
	Name	: T_MaxString;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Statemachine.Name := _Name;
Statemachine_HMI.RegisterWithParent(THIS^);
_SealerAxis.RegisterWithParent(THIS^);
SealerAxis_HMI.RegisterWithParent(THIS^);
SealerAxis_Events.RegisterWithParent(THIS^);
_SealBar.RegisterWithParent(THIS^);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initializing" Id="{0b766ed1-019e-46cc-8363-be8fc556a047}" FolderPath="Initialize\">
      <Declaration><![CDATA[(* This Module will be done initialize when ModuleInitialized := TRUE;, subequently all subitems will be called to be initialized *)
METHOD Initializing
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ModuleInitialized := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCyclicCall" Id="{415f9472-40f0-4fcd-9993-be952d0f2f73}">
      <Declaration><![CDATA[METHOD OnCyclicCall
VAR_INST
	//Simulation variables for messaging
	ErrorInput		: BOOL;
	WarnInput		: BOOL;
	InfoInput		: BOOL;
	TempFeedbackBad : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_SealBar.SetTemperature := _Recipe.Temp;
//
IF ErrorInput THEN
	_Error	 := TRUE;
	_ErrorId := E_Sealer.AlarmMessage;
ELSIF TempFeedbackBad THEN
	_Error	 := TRUE;
	_ErrorId := E_Sealer.FeedbackError;
ELSIF WarnInput THEN
	_ErrorId := E_Sealer.WarningMessage;
ELSIF InfoInput THEN
	_ErrorId := E_Sealer.InfoMessage;
END_IF]]></ST>
      </Implementation>
    </Method>
