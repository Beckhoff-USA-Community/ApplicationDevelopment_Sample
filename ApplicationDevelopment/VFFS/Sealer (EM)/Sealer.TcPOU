]]></Declaration>
      <Get Name="Get" Id="{79bee0fc-836e-4520-9118-260b86870135}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Error := _Error;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ErrorId" Id="{e35b3e24-b07b-42d3-80b1-f968ed940ccf}" FolderPath="Status\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ErrorId : UDINT
]]></Declaration>
      <Get Name="Get" Id="{2a0fb664-2797-457a-86de-d6116f0c4750}">
