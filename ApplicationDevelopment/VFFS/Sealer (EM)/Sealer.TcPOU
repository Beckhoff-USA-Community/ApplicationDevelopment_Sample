      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Override : LREAL]]></Declaration>
      <Set Name="Set" Id="{afa17cd3-cd27-4727-80bc-afcea38b00ac}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[_Override := Override;]]></ST>
        </Implementation>
      </Set>
    </Property>
