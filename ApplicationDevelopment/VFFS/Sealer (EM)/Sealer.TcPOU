    <Method Name="Starting" Id="{ab2b4ed4-ff8a-487e-8ad0-3a85271ded8a}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Starting : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE Statemachine.Mode.CurrentMode OF
	E_PMLProtectedUnitMode.Production:
		CASE SequenceState OF
			0:
				SealerAxis.Velocity		:= Recipe.Axis.Velocity;
				SealerAxis.Acceleration := Recipe.Axis.Acceleration;
				SealerAxis.MoveAbsolute(Recipe.ClosedPosition);
				NextStep(SequenceState);

			10:
				IF SealerAxis.Busy THEN
					Starting := TRUE;
				END_IF
		END_CASE

	E_PMLProtectedUnitMode.Maintenance, E_PMLProtectedUnitMode.Manual:
		Starting := TRUE;
END_CASE]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>