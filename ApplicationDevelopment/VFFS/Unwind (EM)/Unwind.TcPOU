    <Property Name="Recipe" Id="{da227c78-9e49-456a-9687-2febc225f809}" FolderPath="Unwind\">
      <Declaration><![CDATA[PROPERTY Recipe : REFERENCE TO ST_UnwindRecipe]]></Declaration>
      <Get Name="Get" Id="{2bca4098-2380-47d1-a909-f5a92383cdb2}">
        <Declaration><![CDATA[VAR
END_VAR
