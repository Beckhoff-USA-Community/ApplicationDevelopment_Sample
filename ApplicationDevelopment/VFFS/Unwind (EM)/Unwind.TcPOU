    <Method Name="Reset" Id="{b449d751-1805-43b3-82e0-b0dc93fc0f73}" FolderPath="Unwind\">
      <Declaration><![CDATA[METHOD Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Error	 := FALSE;
_ErrorId := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Starting" Id="{da1b5c33-569f-40aa-bf27-341564a3563d}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Starting : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE Statemachine.Mode.CurrentMode OF
	E_PMLProtectedUnitMode.Production:
		CASE SequenceState OF
			0:
				UnwindAxis.Velocity		:= Recipe.Axis.Velocity;
				UnwindAxis.Acceleration := Recipe.Axis.Acceleration;
				UnwindAxis.MoveVelocity(Recipe.Axis.Velocity);
				NextStep(SequenceState);

			10:
				IF UnwindAxis.Busy THEN
					Starting := TRUE;
				END_IF
		END_CASE

	E_PMLProtectedUnitMode.Maintenance, E_PMLProtectedUnitMode.Manual:
		Starting := TRUE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="UnwindAxis" Id="{27f93244-a72b-479c-a51b-439cc466c480}" FolderPath="Unwind\">
      <Declaration><![CDATA[PROPERTY UnwindAxis : I_Mc2Axis_PTP]]></Declaration>
      <Get Name="Get" Id="{5fa37d27-cf5e-4ffe-9741-3949f9b76339}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[UnwindAxis := _UnwindAxis;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
