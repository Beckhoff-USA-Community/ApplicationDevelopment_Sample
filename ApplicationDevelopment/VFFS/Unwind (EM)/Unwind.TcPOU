<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="Unwind" Id="{a0d8249b-183d-4a71-8f74-6eae7ceacca1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Unwind EXTENDS PackMLModule IMPLEMENTS I_Unwind
VAR
	// Components
	UnwindAxisRef	  : AXIS_REF;
	_UnwindAxis		  : Mc2AxisPTP('Unwind Axis', UnwindAxisRef);
	UnwindAxis_HMI	  : Mc2AxisPTP_HMI('Unwind Axis HMI', _UnwindAxis, '°');
	UnwindAxis_Events : Mc2Axis_TcEvents('Unwind Axis Events', _UnwindAxis);

	//
	_Recipe			 : ST_UnwindRecipe;
	Statemachine_HMI : PackMLStatemachine_HMI('Unwind Statemachine HMI', _Statemachine);
END_VAR

VAR
	_Override : LREAL := 100.0;
	{attribute 'hide'}
	_Busy : BOOL;
	{attribute 'hide'}
	_Error : BOOL;
	{attribute 'hide'}
	_ErrorId : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Constructor" Id="{ef067788-9f42-40e5-a0ed-d748036149a6}" />
    <Folder Name="Initialize" Id="{2cf96b83-e842-4620-b70b-ce9b4467b27b}" />
    <Folder Name="States" Id="{bc9c822f-69b5-4ad6-9e46-44a6dcb68335}" />
    <Folder Name="Status" Id="{3500ee70-c428-4108-9590-f3d15ea2d8ca}" />
