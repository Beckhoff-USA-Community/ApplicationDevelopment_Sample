    <Method Name="Aborting" Id="{4b141fa4-5813-446e-a3c1-816365e238c9}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Aborting : BOOL
VAR_INST
	DisableAll : DisableAllComponentsVisitor;
	StopAll	   : StopAllComponentsVisitor;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE SequenceState OF
	0:
		StopAll.Stop(Components);
		IF StopAll.Stopped THEN
			NextStep(SequenceState);
		END_IF

	10:
		DisableAll.Disable(Components);
		IF NOT DisableAll.Enabled THEN
			Aborting := TRUE;
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="Busy" Id="{14ed4370-7a91-4679-ab55-2d2d2348bb71}" FolderPath="Status\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Busy : BOOL
]]></Declaration>
      <Get Name="Get" Id="{d8694be6-22ea-4cbc-9d35-3b8730a7bac5}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Busy := _Busy;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clearing" Id="{b3ce10c4-be8d-44a7-b500-bb0294e8006d}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Clearing : BOOL
VAR_INST
    EnableAll: EnableAllComponentsVisitor;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE SequenceState OF
	0:
		IF ResetComponents() THEN
			NextStep(SequenceState);
		END_IF

	10:
		EnableAll.Enable(Components);
		IF EnableAll.Enabled THEN
			Clearing := TRUE;
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
