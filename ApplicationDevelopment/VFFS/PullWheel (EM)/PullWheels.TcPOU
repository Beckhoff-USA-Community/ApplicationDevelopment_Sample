    <Method Name="Reset" Id="{33adabb5-7fb8-48fb-9637-024d18a93086}" FolderPath="PullWheel\">
      <Declaration><![CDATA[METHOD Reset
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Error	 := FALSE;
_ErrorId := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Resetting" Id="{51897ad0-d8ac-4ccc-b501-12a355474f7c}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Resetting : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE Statemachine.Mode.CurrentMode OF
	E_PMLProtectedUnitMode.Production:
		PullWheelRightAxis.Master			:= PullWheelLeftAxis;
		PullWheelRightAxis.RatioDenominator := 1.0;
		PullWheelRightAxis.RatioNumerator	:= 1.0;
		PullWheelRightAxis.GearIn();
		Resetting := PullWheelRightAxis.InGear;

	E_PMLProtectedUnitMode.Maintenance, E_PMLProtectedUnitMode.Manual:
		Resetting := TRUE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Starting" Id="{08b7192f-6d97-4960-9f94-708bb678333e}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Starting : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE Statemachine.Mode.CurrentMode OF
	E_PMLProtectedUnitMode.Production:
		CASE SequenceState OF
			0:
				PullWheelCylinder.Extend();
				IF PullWheelCylinder.Extended THEN
					PullWheelLeftAxis.Velocity	   := Recipe.LeftAxis.Velocity;
					PullWheelLeftAxis.Acceleration := Recipe.LeftAxis.Acceleration;
					PullWheelLeftAxis.MoveRelative(Distance := Recipe.Length, FALSE);
					NextStep(SequenceState);
				END_IF

			10:
				IF PullWheelLeftAxis.Busy THEN
					Starting := TRUE;
				END_IF
		END_CASE

	E_PMLProtectedUnitMode.Maintenance, E_PMLProtectedUnitMode.Manual:
		Starting := TRUE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="Stopping" Id="{0408b633-0bbd-4a0c-8391-9059215b3c81}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Stopping : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE Statemachine.Mode.CurrentMode OF
	E_PMLProtectedUnitMode.Production:
		CASE SequenceState OF
			0:
				PullWheelCylinder.Retract();
				NextStep(SequenceState);

			10:
				IF PullWheelCylinder.Retracted THEN
					Stopping := TRUE;
				END_IF
		END_CASE

	E_PMLProtectedUnitMode.Maintenance, E_PMLProtectedUnitMode.Manual:
		Stopping := TRUE;
END_CASE]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>