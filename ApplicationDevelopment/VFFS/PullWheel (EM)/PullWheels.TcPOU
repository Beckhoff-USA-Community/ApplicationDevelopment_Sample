      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY ErrorId : UDINT
]]></Declaration>
      <Get Name="Get" Id="{348c602e-303f-4ad8-a1ce-0a78abe916bb}">
