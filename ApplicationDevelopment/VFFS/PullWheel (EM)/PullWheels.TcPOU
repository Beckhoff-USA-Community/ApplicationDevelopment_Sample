<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="PullWheels" Id="{7754a789-a66d-4052-b729-ff13827ef1ae}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK PullWheels EXTENDS PackMLModule IMPLEMENTS I_PullWheels
VAR
	// Components
	PullWheelLeftAxisRef	  : AXIS_REF;
	_PullWheelLeftAxis		  : Mc3AxisPTP('Pull Wheel Left Axis', PullWheelLeftAxisRef);
	PullWheelLeftAxis_HMI	  : AxisPTP_HMI('Pull Wheel Left Axis HMI', _PullWheelLeftAxis, '°');
	PullWheelLeftAxis_Events  : Axis_TcEvents('Pul lWheel Left Axis Events', _PullWheelLeftAxis);
	PullWheelRightAxisRef	  : AXIS_REF;
	_PullWheelRightAxis		  : Mc3SlaveAxisPTP('Pull Wheel Right Axis', PullWheelRightAxisRef);
	PullWheelRightAxis_HMI	  : AxisPTP_HMI('Pull Wheel Right Axis HMI', _PullWheelRightAxis, '°');
	PullWheelRightAxis_Events : Axis_TcEvents('Pull Wheel Right Axis Events', _PullWheelRightAxis);
	_PullWheelCylinder		  : Cylinder('Cylinder', 0, 0, 0, 0);
	PullWheelCylinder_HMI	  : Cylinder_HMI('Cylinder HMI', _PullWheelCylinder) := (ExtendedName := 'Extended', RetractedName := 'Retracted', ExtendCommandName := 'Extend', RetractCommandName := 'Retract');
	PullWheelCylinder_Events  : Cylinder_TcEvents('Cylinder Events', _PullWheelCylinder);

	// 
	_Recipe			 : ST_PullWheelsRecipe;
	Statemachine_HMI : PackMLStatemachine_HMI('Pull Wheels Statemachine HMI', _Statemachine);
END_VAR

VAR
	_Override : LREAL := 100.0;
	{attribute 'hide'}
	_Busy : BOOL;
	{attribute 'hide'}
	_Error : BOOL;
	{attribute 'hide'}
	_ErrorId : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Constructor" Id="{c03725ab-43ea-4dc4-b9e5-86673b36978d}" />
    <Folder Name="Initialize" Id="{45593c16-c85b-4b29-9248-e4a4eec256e8}" />
    <Folder Name="PullWheel" Id="{e633557b-aeea-4871-ae50-0d78b8c1faef}" />
    <Folder Name="States" Id="{92dff042-6767-475b-bcb8-df619fcace0b}" />
    <Folder Name="Status" Id="{9d61e470-a4a7-46ab-9360-4fc130577f60}" />
    <Method Name="Aborting" Id="{dfa95981-c309-4b01-bac2-b069da141bfc}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Aborting : BOOL
VAR_INST
	DisableAll : DisableAllComponentsVisitor;
	StopAll	   : StopAllComponentsVisitor;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE SequenceState OF
	0:
		StopAll.Stop(Components);
		IF StopAll.Stopped THEN
			NextStep(SequenceState);
		END_IF

	10:
		DisableAll.Disable(Components);
		IF NOT DisableAll.Enabled THEN
			Aborting := TRUE;
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="Busy" Id="{4757de2c-806c-4f73-aa20-dbfeb27905ca}" FolderPath="Status\">
      <Declaration><![CDATA[{attribute 'monitoring' := 'call'}
PROPERTY Busy : BOOL
]]></Declaration>
      <Get Name="Get" Id="{7268afbc-2990-43e4-adb3-e711dd21d870}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Busy := _Busy;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Clearing" Id="{5a48a9ad-a2b6-4466-a282-f899c0f7470f}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Clearing : BOOL
VAR_INST
    EnableAll: EnableAllComponentsVisitor;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE SequenceState OF
	0:
		IF ResetComponents() THEN
			NextStep(SequenceState);
		END_IF

	10:
		EnableAll.Enable(Components);
		IF EnableAll.Enabled THEN
			Clearing := TRUE;
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
