    <Method Name="Execute" Id="{abd97491-0f39-44fa-9587-20035a55c042}" FolderPath="States\">
      <Declaration><![CDATA[METHOD Execute : BOOL
VAR_INST
    WaitForStableActualPosition : MC_WaitForStableActualPosition;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE Statemachine.Mode.CurrentMode OF
	E_PMLProtectedUnitMode.Production:
		IF NOT PullWheelLeftAxis.Busy THEN
			PullWheelCylinder.Retract();
			IF PullWheelCylinder.Retracted THEN
				Statemachine.ChangeState(E_PmlCommand.Complete);
				Execute := TRUE;
			END_IF
		END_IF

	E_PMLProtectedUnitMode.Maintenance, E_PMLProtectedUnitMode.Manual:
		Execute := TRUE;
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_Init" Id="{3035fcf4-bd13-4a9e-9efa-0e716f795de8}" FolderPath="Constructor\">
      <Declaration><![CDATA[(*FB_Init is always available implicitly and it is used primarily for initialization.
The return value is not evaluated. For a specific influence, you can also declare the
methods explicitly and provide additional code there with the standard initialization
code. You can evaluate the return value.*)
METHOD FB_Init : BOOL
VAR_INPUT
	(* TRUE: the retain variables are initialized (reset warm / reset cold)*)
	bInitRetains	: BOOL;
	(* TRUE: the instance will be copied to the copy code afterward (online change)   *)
	bInCopyCode	: BOOL;
	Name	: T_MaxString;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Statemachine.Name := _Name;
Statemachine_HMI.RegisterWithParent(THIS^);
_PullWheelLeftAxis.RegisterWithParent(THIS^);
PullWheelLeftAxis_HMI.RegisterWithParent(THIS^);
PullWheelLeftAxis_Events.RegisterWithParent(THIS^);
_PullWheelRightAxis.RegisterWithParent(THIS^);
PullWheelRightAxis_HMI.RegisterWithParent(THIS^);
PullWheelRightAxis_Events.RegisterWithParent(THIS^);
_PullWheelCylinder.RegisterWithParent(THIS^);
PullWheelCylinder_HMI.RegisterWithParent(THIS^);
PullWheelCylinder_Events.RegisterWithParent(THIS^);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initializing" Id="{23c90ba9-8b37-43d5-86e3-995a92e47f76}" FolderPath="Initialize\">
      <Declaration><![CDATA[(* This Module will be done initialize when ModuleInitialized := TRUE;, subequently all subitems will be called to be initialized *)
METHOD Initializing
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ModuleInitialized := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="OnCyclicCall" Id="{075ffe24-3c09-427f-904c-80728b5ea9ce}">
      <Declaration><![CDATA[METHOD OnCyclicCall
VAR
	i		   : UDINT;
	iComponent : I_Component;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Option to iterate through Components
FOR i := 0 TO (Components.Count - 1) DO
	iComponent := Components.GetAtIndex(i);
END_FOR]]></ST>
      </Implementation>
    </Method>
