<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="TEST_AnyBuffer_PushLeft" Id="{d4e5f6a7-8901-23bc-def4-567890abcdef}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM TEST_AnyBuffer_PushLeft

]]></Declaration>
    <Implementation>
      <ST><![CDATA[PushToEmptyBuffer();
PushToNonEmptyBuffer();
IncrementsElementCount();
ShiftsExistingElements();
ReturnsTrueOnSuccess();
ReturnsFalseOnFullBuffer();
ReturnsFalseOnWrongSize();
PreservesExistingData();
PushMultipleElements();
PushToFullBufferMinus1();
PushWhenFullCapacity();
PushZeroSizedElement();
PushWithDifferentDataTypes();
ConsecutivePushAndPopLeft();
ConsecutivePushAndPopRight();
ElementOrderAfterMultiplePushes();
FillBufferCompletely();
]]></ST>
    </Implementation>
    <Method Name="ConsecutivePushAndPopLeft" Id="{11223344-5566-7788-99aa-bbccddee1111}">
      <Declaration><![CDATA[// LIFO behavior with alternating AppendLeft and PopLeft calls
METHOD ConsecutivePushAndPopLeft
VAR
	poppedValue : DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange
	fbAnyBuffer.Clear();

	// Act - Append then Pop (LIFO: Last In First Out)
	AppendedElement := DINT#100;
	fbAnyBuffer.PushLeft(element := AppendedElement);  // [100]
	AppendedElement := DINT#200;
	fbAnyBuffer.PushLeft(element := AppendedElement);  // [200, 100]
	AppendedElement := DINT#300;
	fbAnyBuffer.PushLeft(element := AppendedElement);  // [300, 200, 100]
	fbAnyBuffer.PopLeft(element := poppedValue);  // Pop 300

	// Assert - Should pop the last appended value (300)
	TEST_DINT := 300;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, poppedValue);

	// Buffer should now be [200, 100]
	TEST_DINT := 200;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+0]);
	TEST_DINT := 100;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+1]);
	TEST_DINT := 2;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, fbAnyBuffer.Metadata.elementCount);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ConsecutivePushAndPopRight" Id="{22334455-6677-8899-aabb-ccddeeaa2222}">
      <Declaration><![CDATA[// FIFO behavior with alternating AppendLeft and PopRight calls
METHOD ConsecutivePushAndPopRight
VAR
	poppedValue : DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange
	fbAnyBuffer.Clear();

	// Act - Append Left and Pop Right (FIFO from right)
	AppendedElement := DINT#100;
	fbAnyBuffer.PushLeft(element := AppendedElement);  // [100]
	AppendedElement := DINT#200;
	fbAnyBuffer.PushLeft(element := AppendedElement);  // [200, 100]
	AppendedElement := DINT#300;
	fbAnyBuffer.PushLeft(element := AppendedElement);  // [300, 200, 100]
	fbAnyBuffer.PopRight(element := poppedValue);  // Pop 100 (first appended)

	// Assert - Should pop the first appended value (100)
	TEST_DINT := 100;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, poppedValue);

	// Buffer should now be [300, 200]
	TEST_DINT := 300;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+0]);
	TEST_DINT := 200;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+1]);
	TEST_DINT := 2;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, fbAnyBuffer.Metadata.elementCount);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ElementOrderAfterMultiplePushes" Id="{c1d2e3f4-5678-90a1-4901-234567012456}">
      <Declaration><![CDATA[// AppendLeft maintains correct element order after multiple appends
METHOD ElementOrderAfterMultiplePushes
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange
	fbAnyBuffer.Clear();

	// Act - Append 5 different values
	AppendedElement := DINT#1;
	fbAnyBuffer.PushLeft(element := AppendedElement);    // [1]
	AppendedElement := DINT#2;
	fbAnyBuffer.PushLeft(element := AppendedElement);    // [2, 1]
	AppendedElement := DINT#3;
	fbAnyBuffer.PushLeft(element := AppendedElement);    // [3, 2, 1]
	AppendedElement := DINT#4;
	fbAnyBuffer.PushLeft(element := AppendedElement);    // [4, 3, 2, 1]
	AppendedElement := DINT#5;
	fbAnyBuffer.PushLeft(element := AppendedElement);    // [5, 4, 3, 2, 1]

	// Assert - Verify complete LIFO order
	TEST_DINT := 5;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+0]);
	TEST_DINT := 4;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+1]);
	TEST_DINT := 3;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+2]);
	TEST_DINT := 2;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+3]);
	TEST_DINT := 1;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+4]);
	TEST_DINT := 5;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, fbAnyBuffer.Metadata.elementCount);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FillBufferCompletely" Id="{33445566-7788-99aa-bbcc-ddeeff333333}">
      <Declaration><![CDATA[// Filling buffer to full capacity works correctly
METHOD FillBufferCompletely
VAR
	i : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange
	fbAnyBuffer.Clear();

	// Act - Fill buffer completely
	FOR i := 1 TO 5 DO
		AppendedElement := TO_DINT(i * 100);
		Success := fbAnyBuffer.PushLeft(element := AppendedElement);
		TestSuite.Test(__POUNAME()).AssertEqual(TEST_BOOL_TRUE, Success);
	END_FOR

	// Assert - All elements in correct positions (reverse order due to left append)
	TEST_DINT := 500;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+0]);
	TEST_DINT := 400;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+1]);
	TEST_DINT := 300;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+2]);
	TEST_DINT := 200;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+3]);
	TEST_DINT := 100;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+4]);
	TEST_DINT := 5;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, fbAnyBuffer.Metadata.elementCount);

	// Assert - Cannot append when full
	AppendedElement := DINT#600;
	Success := fbAnyBuffer.PushLeft(element := AppendedElement);
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_BOOL_FALSE, Success);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IncrementsElementCount" Id="{a7b8c9d0-1234-56ef-0567-890123def012}">
      <Declaration><![CDATA[// AppendLeft increases elementCount by 1 after append
METHOD IncrementsElementCount
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange
	fbAnyBuffer.Clear();
	RawBuffer[TEST_LL+0] := 100;
	RawBuffer[TEST_LL+1] := 200;
	fbAnyBuffer.Metadata.elementCount := 2;
	AppendedElement := 300;

	// Act
	Success := fbAnyBuffer.PushLeft(element := AppendedElement);

	// Assert - elementCount should be incremented from 2 to 3
	TEST_DINT := 3;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, fbAnyBuffer.Metadata.elementCount);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="PreservesExistingData" Id="{a3b4c5d6-7890-12e3-6123-456789234678}">
      <Declaration><![CDATA[// AppendLeft preserves existing element values after shift
METHOD PreservesExistingData
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange
	fbAnyBuffer.Clear();
	RawBuffer[TEST_LL+0] := 111;
	RawBuffer[TEST_LL+1] := 222;
	RawBuffer[TEST_LL+2] := 333;
	fbAnyBuffer.Metadata.elementCount := 3;
	AppendedElement := 999;

	// Act
	Success := fbAnyBuffer.PushLeft(element := AppendedElement);

	// Assert - All original values preserved (just shifted)
	TEST_DINT := 999;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+0]);
	TEST_DINT := 111;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+1]);
	TEST_DINT := 222;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+2]);
	TEST_DINT := 333;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+3]);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="PushMultipleElements" Id="{b4c5d6e7-8901-23f4-7234-567890345789}">
      <Declaration><![CDATA[// AppendLeft consecutive appends work correctly (LIFO order)
METHOD PushMultipleElements
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange
	fbAnyBuffer.Clear();

	// Act - Append multiple elements to the left (stack behavior)
	AppendedElement := DINT#10;
	fbAnyBuffer.PushLeft(element := AppendedElement);
	AppendedElement := DINT#20;
	fbAnyBuffer.PushLeft(element := AppendedElement);
	AppendedElement := DINT#30;
	fbAnyBuffer.PushLeft(element := AppendedElement);

	// Assert - LIFO order: last appended (30) should be at position 0
	TEST_DINT := 30;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+0]);
	TEST_DINT := 20;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+1]);
	TEST_DINT := 10;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+2]);
	TEST_DINT := 3;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, fbAnyBuffer.Metadata.elementCount);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="PushToEmptyBuffer" Id="{e5f6a7b8-9012-34cd-ef45-678901bcdef0}">
      <Declaration><![CDATA[// AppendLeft inserts element at position 0 in empty buffer
METHOD PushToEmptyBuffer
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange
	fbAnyBuffer.Clear();
	AppendedElement := 100;

	// Act
	Success := fbAnyBuffer.PushLeft(element := AppendedElement);

	// Assert
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_BOOL_TRUE, Success);
	TEST_DINT := 100;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+0]);
	TEST_DINT := 1;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, fbAnyBuffer.Metadata.elementCount);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="PushToFullBufferMinus1" Id="{c5d6e7f8-9012-34a5-8345-678901456890}">
      <Declaration><![CDATA[// AppendLeft succeeds when buffer has exactly 1 space remaining
METHOD PushToFullBufferMinus1
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange - Fill buffer with 4 elements (capacity is 5)
	fbAnyBuffer.Clear();
	RawBuffer[TEST_LL+0] := 100;
	RawBuffer[TEST_LL+1] := 200;
	RawBuffer[TEST_LL+2] := 300;
	RawBuffer[TEST_LL+3] := 400;
	fbAnyBuffer.Metadata.elementCount := 4;
	AppendedElement := 50;

	// Act - Append to buffer with exactly 1 space left
	Success := fbAnyBuffer.PushLeft(element := AppendedElement);

	// Assert
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_BOOL_TRUE, Success);
	TEST_DINT := 5;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, fbAnyBuffer.Metadata.elementCount);
	TEST_DINT := 50;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+0]);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="PushToNonEmptyBuffer" Id="{f6a7b8c9-0123-45de-f456-789012cdef01}">
      <Declaration><![CDATA[// AppendLeft inserts element at position 0 and shifts existing elements right
METHOD PushToNonEmptyBuffer
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange
	fbAnyBuffer.Clear();
	RawBuffer[TEST_LL+0] := 200;
	RawBuffer[TEST_LL+1] := 300;
	fbAnyBuffer.Metadata.capacity := 3;
	fbAnyBuffer.Metadata.elementCount := 2;
	AppendedElement := 100;

	// Act
	Success := fbAnyBuffer.PushLeft(element := AppendedElement);

	// Assert
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_BOOL_TRUE, Success);
	TEST_DINT := 100;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+0]);
	TEST_DINT := 200;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+1]);
	TEST_DINT := 300;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+2]);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="PushWhenFullCapacity" Id="{d6e7f8a9-0123-45b6-9456-789012567901}">
      <Declaration><![CDATA[// AppendLeft fails when elementCount equals capacity
METHOD PushWhenFullCapacity
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange - Set elementCount to capacity
	// Arrange - Fill buffer to capacity (5 elements)
	fbAnyBuffer.Clear();
	RawBuffer[TEST_LL+0] := 100;
	RawBuffer[TEST_LL+1] := 200;
	RawBuffer[TEST_LL+2] := 300;
	RawBuffer[TEST_LL+3] := 400;
	RawBuffer[TEST_LL+4] := 500;
	fbAnyBuffer.Metadata.elementCount := TEST_UL-TEST_LL+1;
	fbAnyBuffer.Metadata.capacity := 0;
	AppendedElement := 999;

	// Act
	Success := fbAnyBuffer.PushLeft(element := AppendedElement);

	// Assert
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_BOOL_FALSE, Success);
	TEST_DINT := 5;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, fbAnyBuffer.Metadata.elementCount);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="PushWithDifferentDataTypes" Id="{f8a9b0c1-2345-67d8-1678-901234789123}">
      <Declaration><![CDATA[// AppendLeft works with various data types (DINT, REAL, struct)
METHOD PushWithDifferentDataTypes
VAR
	realBuffer : ARRAY[0..4] OF REAL;
	fbRealBuffer : AnyBuffer(pBuffer := realBuffer,
								bufferBoundLower := 0,
								bufferBoundUpper := 4,
								isBufferPersistent := FALSE);
	realValue : REAL := 3.14159;
	retrievedReal : REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange
	fbRealBuffer.Clear();
	realValue := 3.14159;

	// Act - Append REAL type
	Success := fbRealBuffer.PushLeft(element := realValue);

	// Assert
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_BOOL_TRUE, Success);
	TEST_REAL := 3.14159;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_REAL, realBuffer[0]);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="PushZeroSizedElement" Id="{e7f8a9b0-1234-56c7-0567-890123678012}">
      <Declaration><![CDATA[// AppendLeft with zero-sized element
METHOD PushZeroSizedElement
VAR
	EmptyAny				: __SYSTEM.AnyType;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange
	fbAnyBuffer.Clear();

	// Initialize empty AnyType (size = 0)
	EmptyAny.pValue := 0;
	EmptyAny.diSize := 0;

	// Act - Call with zero-sized element
	Success := fbAnyBuffer.PushLeft(element := EmptyAny);

	// Assert - Should fail because element size doesn't match
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_BOOL_FALSE, Success);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReturnsFalseOnFullBuffer" Id="{d0e1f2a3-4567-89b0-3890-123456f12345}">
      <Declaration><![CDATA[// AppendLeft returns FALSE when buffer is at capacity
METHOD ReturnsFalseOnFullBuffer
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange - Fill buffer to capacity (5 elements)
	fbAnyBuffer.Clear();
	RawBuffer[TEST_LL+0] := 100;
	RawBuffer[TEST_LL+1] := 200;
	RawBuffer[TEST_LL+2] := 300;
	RawBuffer[TEST_LL+3] := 400;
	RawBuffer[TEST_LL+4] := 500;
	fbAnyBuffer.Metadata.elementCount := TEST_UL+1;
	fbAnyBuffer.Metadata.capacity := 0;
	AppendedElement := 600;

	// Act - Try to append to full buffer
	Success := fbAnyBuffer.PushLeft(element := AppendedElement);

	// Assert
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_BOOL_FALSE, Success);
	// Verify buffer unchanged
	TEST_DINT := 100;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+0]);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReturnsFalseOnWrongSize" Id="{e1f2a3b4-5678-90c1-4901-234567012456}">
      <Declaration><![CDATA[// AppendLeft returns FALSE when element size doesn't match buffer element size
METHOD ReturnsFalseOnWrongSize
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange
	fbAnyBuffer.Clear();
	WrongSizeElement := 100;  // INT is 2 bytes, buffer expects DINT (4 bytes)

	// Act - Pass an INT to a DINT buffer
	Success := fbAnyBuffer.PushLeft(element := WrongSizeElement);

	// Assert
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_BOOL_FALSE, Success);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReturnsTrueOnSuccess" Id="{c9d0e1f2-3456-78a0-2789-012345f01234}">
      <Declaration><![CDATA[// AppendLeft returns TRUE when append succeeds
METHOD ReturnsTrueOnSuccess
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange
	fbAnyBuffer.Clear();
	AppendedElement := 42;

	// Act
	Success := fbAnyBuffer.PushLeft(element := AppendedElement);

	// Assert
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_BOOL_TRUE, Success);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ShiftsExistingElements" Id="{b8c9d0e1-2345-67f0-1678-901234ef0123}">
      <Declaration><![CDATA[// AppendLeft shifts all existing elements right by one position
METHOD ShiftsExistingElements
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange
	fbAnyBuffer.Clear();
	RawBuffer[TEST_LL+0] := 100;
	RawBuffer[TEST_LL+1] := 200;
	RawBuffer[TEST_LL+2] := 300;
	fbAnyBuffer.Metadata.elementCount := 3;
	AppendedElement := 50;

	// Act
	Success := fbAnyBuffer.PushLeft(element := AppendedElement);

	// Assert - all elements shifted right
	TEST_DINT := 50;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+0]);
	TEST_DINT := 100;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+1]);
	TEST_DINT := 200;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+2]);
	TEST_DINT := 300;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+3]);
END_IF
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>