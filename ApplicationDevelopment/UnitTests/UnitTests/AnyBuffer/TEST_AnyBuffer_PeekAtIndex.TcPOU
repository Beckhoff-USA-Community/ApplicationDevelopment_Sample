	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, fbAnyBuffer.Metadata.elementCount);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="PeekFromMiddle" Id="{aabbccdd-eeff-0011-2233-4455667788aa}">
      <Declaration><![CDATA[// Peeking from middle index retrieves correct element
METHOD PeekFromMiddle
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange
	fbAnyBuffer.Clear();
	testElement := DINT#100;
	fbAnyBuffer.PushRight(element := testElement);
	testElement := DINT#200;
	fbAnyBuffer.PushRight(element := testElement);
	testElement := DINT#300;
	fbAnyBuffer.PushRight(element := testElement);
	testElement := DINT#400;
	fbAnyBuffer.PushRight(element := testElement);

	// Act - Peek middle element (index 1)
	Success := fbAnyBuffer.PeekAtIndex(index := TEST_LL+1, element := ReturnedElement);

	// Assert
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_BOOL_TRUE, Success);
	TEST_DINT := 200;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, ReturnedElement);

	// Verify buffer unchanged
	TEST_DINT := 100;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL]);
	TEST_DINT := 200;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+1]);
	TEST_DINT := 300;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+2]);
	TEST_DINT := 400;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL+3]);
	TEST_DINT := 4;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, fbAnyBuffer.Metadata.elementCount);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReturnsFalseOnEmptyBuffer" Id="{bbccddee-ff00-1122-3344-556677889abb}">
      <Declaration><![CDATA[// FALSE returned when buffer is empty (elementCount = 0)
METHOD ReturnsFalseOnEmptyBuffer
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange
	fbAnyBuffer.Clear();

	// Act
	Success := fbAnyBuffer.PeekAtIndex(index := TEST_LL, element := ReturnedElement);

	// Assert
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_BOOL_FALSE, Success);
	TEST_DINT := 0;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, fbAnyBuffer.Metadata.elementCount);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReturnsFalseOnIndexOutOfBounds" Id="{ccddeeff-0011-2233-4455-66778899aacc}">
      <Declaration><![CDATA[// FALSE returned when index >= elementCount
METHOD ReturnsFalseOnIndexOutOfBounds
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange
	fbAnyBuffer.Clear();
	testElement := DINT#100;
	fbAnyBuffer.PushRight(element := testElement);
	testElement := DINT#200;
	fbAnyBuffer.PushRight(element := testElement);

	// Act - Try to peek beyond element count
	Success := fbAnyBuffer.PeekAtIndex(index := TEST_UL+1, element := ReturnedElement);

	// Assert
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_BOOL_FALSE, Success);
	TEST_DINT := 2;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, fbAnyBuffer.Metadata.elementCount);

	// Try index much larger than element count
	Success := fbAnyBuffer.PeekAtIndex(index := TEST_UL+100, element := ReturnedElement);
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_BOOL_FALSE, Success);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReturnsFalseOnNegativeIndex" Id="{ddeeff00-1122-3344-5566-778899aabbdd}">
      <Declaration><![CDATA[// FALSE returned for negative index
METHOD ReturnsFalseOnNegativeIndex
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange
	fbAnyBuffer.Clear();
	testElement := DINT#100;
	fbAnyBuffer.PushRight(element := testElement);

	// Act
	Success := fbAnyBuffer.PeekAtIndex(index := TEST_LL-1, element := ReturnedElement);

	// Assert
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_BOOL_FALSE, Success);
	TEST_DINT := 1;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, fbAnyBuffer.Metadata.elementCount);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReturnsTrueOnSuccess" Id="{eeff0011-2233-4455-6677-8899aabbccee}">
      <Declaration><![CDATA[// Method returns TRUE when peek succeeds
METHOD ReturnsTrueOnSuccess
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange
	fbAnyBuffer.Clear();
	testElement := DINT#100;
	fbAnyBuffer.PushRight(element := testElement);
	testElement := DINT#200;
	fbAnyBuffer.PushRight(element := testElement);

	// Act
	Success := fbAnyBuffer.PeekAtIndex(index := TEST_LL, element := ReturnedElement);

	// Assert
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_BOOL_TRUE, Success);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="WrongElementSize" Id="{ff001122-3344-5566-7788-99aabbccdeff}">
      <Declaration><![CDATA[// FALSE returned when element size doesn't match
METHOD WrongElementSize
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange
	fbAnyBuffer.Clear();
	testElement := DINT#100;
	fbAnyBuffer.PushRight(element := testElement);

	// Act - Try to peek with wrong element size
	Success := fbAnyBuffer.PeekAtIndex(index := TEST_LL, element := WrongSizeElement);

	// Assert - Should fail because of size difference
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_BOOL_FALSE, Success);

	// Verify buffer unchanged
	TEST_DINT := 1;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, fbAnyBuffer.Metadata.elementCount);
	TEST_DINT := 100;
	TestSuite.Test(__POUNAME()).AssertEqual(TEST_DINT, RawBuffer[TEST_LL]);
END_IF
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>