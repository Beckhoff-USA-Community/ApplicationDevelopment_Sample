END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="PeekFromEnd" Id="{99aabbcc-ddee-ff00-1122-334455667799}">
      <Declaration><![CDATA[// Peeking at last index retrieves last element
METHOD PeekFromEnd
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	// Arrange
