<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="CollectionPeeker_Test" Id="{f047f35c-9391-403b-9213-2618be153bc1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK CollectionPeeker_Test
VAR
	ComponentArray : ARRAY[0..9] OF Component_Mockup[(Name := '1'), (Name := '2'), (Name := '3'), (Name := '4'), (Name := '5'), (Name := '6'), (Name := '7'), (Name := '8'), (Name := '9'), (Name := '10')];
	AllComponents  : Collection<20>;
	i			   : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF AllComponents.Count <> (SIZEOF(ComponentArray) / SIZEOF(ComponentArray[0])) THEN
	FOR i := 0 TO (SIZEOF(ComponentArray) / SIZEOF(ComponentArray[0])) - 1 DO
		AllComponents.AddItem(ComponentArray[i]);
	END_FOR
END_IF

SetCollectionCheck();
SetFirstItem();
MoveDownOne();
MoveUpOne();
PageDownOne();
PageUpOne();
MoveUpOneRollOver();
MoveDownOneRollOver();
PageUpRollOver();
PageDownRollOver();
NoCollection();
CollectionSmallerThanPeekSize();]]></ST>
    </Implementation>
    <Method Name="CollectionSmallerThanPeekSize" Id="{71f0ba78-5061-417b-813d-6b37854ee24d}">
      <Declaration><![CDATA[METHOD CollectionSmallerThanPeekSize
VAR
	Expected		 : BOOL;
	Actual			 : BOOL;
	NamesEqual		 : BOOL;
	ExpectedNames	 : ARRAY[1..10] OF STRING[5];
	ActualNames		 : ARRAY[1..10] OF STRING[5];
	CurrentComponent : I_Component;

	//
	Peeker		   : CollectionPeeker_Mock<12>;
	CollectionName : T_MaxString;
	i			   : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected			  := TRUE;
	CollectionName		  := 'Test Collection';
	ExpectedNames[1]	  := ComponentArray[0].Name;
	ExpectedNames[2]	  := ComponentArray[1].Name;
	ExpectedNames[3]	  := ComponentArray[2].Name;
	ExpectedNames[4]	  := ComponentArray[3].Name;
	ExpectedNames[5]	  := ComponentArray[4].Name;
	ExpectedNames[6]	  := ComponentArray[5].Name;
	ExpectedNames[7]	  := ComponentArray[6].Name;
	ExpectedNames[8]	  := ComponentArray[7].Name;
	ExpectedNames[9]	  := ComponentArray[8].Name;
	ExpectedNames[10]	  := ComponentArray[9].Name;
	Peeker.CollectionName := CollectionName;
	Peeker.PeekCollection(AllComponents);
	Peeker.MoveDownOne := TRUE;
	Peeker.MoveDownOne := TRUE;
	Peeker.MoveUpOne   := TRUE;
	Peeker.PageDown	   := TRUE;
	Peeker.PageUp	   := TRUE;
	NamesEqual		   := TRUE;
	FOR i := 1 TO 10 DO
		__QUERYINTERFACE(Peeker.Items[i], CurrentComponent);
		ActualNames[i] := CurrentComponent.Name;
		NamesEqual	   := NamesEqual AND ActualNames[i] = ExpectedNames[i];
	END_FOR

	Actual := Peeker.FirstItem = 1 AND Peeker.LastItem = 12 AND NamesEqual;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveDownOne" Id="{945fa6b2-372f-45df-a23d-0b2741f1de79}">
      <Declaration><![CDATA[METHOD MoveDownOne
VAR
	Expected		 : BOOL;
	Actual			 : BOOL;
	NamesEqual		 : BOOL;
	ExpectedNames	 : ARRAY[1..5] OF STRING[5];
	ActualNames		 : ARRAY[1..5] OF STRING[5];
	CurrentComponent : I_Component;

	//
	Peeker		   : CollectionPeeker_Mock<5>;
	CollectionName : T_MaxString;
	i			   : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected			  := TRUE;
	CollectionName		  := 'Test Collection';
	ExpectedNames[1]	  := ComponentArray[1].Name;
	ExpectedNames[2]	  := ComponentArray[2].Name;
	ExpectedNames[3]	  := ComponentArray[3].Name;
	ExpectedNames[4]	  := ComponentArray[4].Name;
	ExpectedNames[5]	  := ComponentArray[5].Name;
	Peeker.CollectionName := CollectionName;
	Peeker.PeekCollection(AllComponents);
	Peeker.MoveDownOne := TRUE;
	NamesEqual		   := TRUE;
	FOR i := 1 TO 5 DO
		__QUERYINTERFACE(Peeker.Items[i], CurrentComponent);
		ActualNames[i] := CurrentComponent.Name;
		NamesEqual	   := NamesEqual AND ActualNames[i] = ExpectedNames[i];
	END_FOR

	Actual := Peeker.FirstItem = 2 AND Peeker.LastItem = 6 AND NamesEqual;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="MoveDownOneRollOver" Id="{39c4e23e-4fe7-4afa-a46e-6967eb4b168b}">
      <Declaration><![CDATA[METHOD MoveDownOneRollOver
VAR
	Expected		 : BOOL;
	Actual			 : BOOL;
	NamesEqual		 : BOOL;
	ExpectedNames	 : ARRAY[1..5] OF STRING[5];
	ActualNames		 : ARRAY[1..5] OF STRING[5];
	CurrentComponent : I_Component;

	//
	Peeker		   : CollectionPeeker_Mock<5>;
	CollectionName : T_MaxString;
	i			   : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected			  := TRUE;
	CollectionName		  := 'Test Collection';
	ExpectedNames[1]	  := ComponentArray[6].Name;
	ExpectedNames[2]	  := ComponentArray[7].Name;
	ExpectedNames[3]	  := ComponentArray[8].Name;
	ExpectedNames[4]	  := ComponentArray[9].Name;
	ExpectedNames[5]	  := ComponentArray[0].Name;
	Peeker.CollectionName := CollectionName;
	Peeker.PeekCollection(AllComponents);
	Peeker.FirstItem   := 6;
	Peeker.MoveDownOne := TRUE;
	NamesEqual		   := TRUE;
	FOR i := 1 TO 5 DO
		__QUERYINTERFACE(Peeker.Items[i], CurrentComponent);
		ActualNames[i] := CurrentComponent.Name;
		NamesEqual	   := NamesEqual AND ActualNames[i] = ExpectedNames[i];
	END_FOR

	Actual := Peeker.FirstItem = 7 AND Peeker.LastItem = 1 AND NamesEqual;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
