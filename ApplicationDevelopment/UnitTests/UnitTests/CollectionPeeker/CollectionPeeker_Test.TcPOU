    <Method Name="NoCollection" Id="{66630e67-bf44-45d7-8293-f439eb6addfa}">
      <Declaration><![CDATA[METHOD NoCollection
VAR
	Expected : BOOL;
	Actual	 : BOOL;

	//
	Peeker		   : CollectionPeeker_Mock<5>;
	CollectionName : T_MaxString;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected		   := TRUE;
	CollectionName	   := '';
	Peeker.MoveDownOne := TRUE;
	Peeker.MoveUpOne   := TRUE;
	Peeker.PageDown	   := TRUE;
	Peeker.PageUp	   := TRUE;
	Actual			   := Peeker.CollectionName = CollectionName;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
