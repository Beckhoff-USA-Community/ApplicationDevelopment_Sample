    <Method Name="PageUpRollOver" Id="{fbb7b8bd-4d65-4d13-b0a5-a8a48e6012b9}">
      <Declaration><![CDATA[METHOD PageUpRollOver
VAR
	Expected		 : BOOL;
	Actual			 : BOOL;
	NamesEqual		 : BOOL;
	ExpectedNames	 : ARRAY[1..5] OF STRING[5];
	ActualNames		 : ARRAY[1..5] OF STRING[5];
	CurrentComponent : I_Component;

	//
	Peeker		   : CollectionPeeker_Mock<5>;
	CollectionName : T_MaxString;
	i			   : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected			  := TRUE;
	CollectionName		  := 'Test Collection';
	ExpectedNames[1]	  := ComponentArray[6].Name;
	ExpectedNames[2]	  := ComponentArray[7].Name;
	ExpectedNames[3]	  := ComponentArray[8].Name;
	ExpectedNames[4]	  := ComponentArray[9].Name;
	ExpectedNames[5]	  := ComponentArray[0].Name;
	Peeker.CollectionName := CollectionName;
	Peeker.PeekCollection(AllComponents);
	Peeker.FirstItem := 2;
	Peeker.PageUp	 := TRUE;
	NamesEqual		 := TRUE;
	FOR i := 1 TO 5 DO
		__QUERYINTERFACE(Peeker.Items[i], CurrentComponent);
		ActualNames[i] := CurrentComponent.Name;
		NamesEqual	   := NamesEqual AND ActualNames[i] = ExpectedNames[i];
