	Expected := 1;
	List.RemoveAtIndex(1);
	Actual := List.Count;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RemoveLastItem" Id="{22bd23f1-8a23-4f8d-a592-21bf3e4ff4f1}">
      <Declaration><![CDATA[METHOD RemoveLastItem
VAR_INST
	Expected   : BOOL;
	Actual	   : BOOL;
	TargetItem : I_Base;
	ActualItem : I_Base;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected   := TRUE;
	TargetItem := 0;
	List.RemoveItem(Item3);
	ActualItem := List.GetAtIndex(2);
	Actual	   := (TargetItem = ActualItem) AND (List.Count = 1);
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RemoveToEmpty" Id="{75a8aa59-d684-4ca1-a48d-66ef396bdc81}">
      <Declaration><![CDATA[METHOD RemoveToEmpty
VAR_INST
	Expected : UDINT;
	Actual	 : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected := 0;
	List.RemoveItem(Item2);
	Actual := List.Count;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test" Id="{0d174a6b-9247-4470-8884-0326d34f7a4a}">
      <Declaration><![CDATA[METHOD Test
VAR
	Expected	 : BOOL;
	Actual		 : BOOL;
	ExpectedItem : I_Base;
	ActualItem	 : I_Base;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected	 := TRUE;
	ExpectedItem := Item2;
	List.Clear();
	List.AddItem(Item1);
	List.AddItem(Item2);
	List.RemoveAtIndex(0);
	ActualItem := List.GetAtIndex(0);
	Actual	   := ActualItem = ExpectedItem;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);

	//cleanup
	List.Clear();
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>