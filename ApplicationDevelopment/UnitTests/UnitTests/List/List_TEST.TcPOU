END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected := FALSE;
	Actual	 := List.InsertAtIndex(Item2, 2);
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="InsertByIndexShift" Id="{d05a2f82-0fbd-4668-954f-a7a6551b722f}">
      <Declaration><![CDATA[METHOD InsertByIndexShift
VAR
	Expected   : UDINT;
	Actual	   : UDINT;
	TargetItem : I_Base;
	ActualItem : I_Base;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected := 2;
	List.InsertAtIndex(Item1, 0);
	Actual := List.Count;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="InsertIndex0Shift" Id="{f7906ceb-2488-4ada-927d-cf7e357086ea}">
      <Declaration><![CDATA[METHOD InsertIndex0Shift
VAR
	Expected	  : BOOL;
	Actual		  : BOOL;
	ExpectedItems : ARRAY[0..4] OF I_Base;
	ActualItems	  : ARRAY[0..4] OF I_Base;
	Item4		  : Item_Mockup;
	Item5		  : Item_Mockup;
	i			  : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected		 := TRUE;
	ExpectedItems[0] := Item5;
	ExpectedItems[1] := Item1;
	ExpectedItems[2] := Item2;
	ExpectedItems[3] := Item3;
	ExpectedItems[4] := Item4;
	List.Clear();
	FOR i := 1 TO 4 DO
		List.AddItem(ExpectedItems[i]);
	END_FOR

	List.InsertAtIndex(Item5, 0);
	Actual := TRUE;
	FOR i := 0 TO 4 DO
		ActualItems[i] := List.GetAtIndex(i);
		Actual		   := Actual AND ExpectedItems[i] = ActualItems[i];
	END_FOR

	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);

	//cleanup
	List.Clear();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RemoveDuplicateItems" Id="{a123a4c7-ff61-43a7-a23a-86ec6413621f}">
      <Declaration><![CDATA[METHOD RemoveDuplicateItems
VAR
	Expected   : UDINT;
	Actual	   : UDINT;
	TargetItem : I_Base;
	ActualItem : I_Base;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected   := 1;
	TargetItem := Item2;
	List.Clear();
	List.AddItem(Item1);
	List.AddItem(Item1);
	List.AddItem(Item2);
	List.RemoveItem(Item1);
	Actual := List.Count;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);

	//cleanup
	List.Clear();
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RemoveFirstItem" Id="{d7314714-9304-44df-b9d3-4b51cffff581}">
      <Declaration><![CDATA[METHOD RemoveFirstItem
VAR_INST
	Expected   : BOOL;
	Actual	   : BOOL;
	TargetItem : I_Base;
	ActualItem : I_Base;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected   := TRUE;
	TargetItem := Item2;
	List.RemoveItem(Item1);
	ActualItem := List.GetAtIndex(0);
	Actual	   := (TargetItem = ActualItem) AND (List.Count = 2);
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
