    <Method Name="Reset" Id="{82ec40d6-f9d7-48e5-ac8f-5ec23c9504ef}">
      <Declaration><![CDATA[METHOD Reset
VAR
	Expected : DINT;
	Actual	 : DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
