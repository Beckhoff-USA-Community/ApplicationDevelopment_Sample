    <Method Name="SetEventAndRaise" Id="{c15ea134-b14b-44e4-b548-7b0dcbcbdf6d}">
      <Declaration><![CDATA[METHOD SetEventAndRaise
VAR_INST
	Expected : DINT;
	Actual	 : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected := 40;
	MockupComponentTcEvent.Events.SetEvent(E_TestComponent.SetEvent, ADR(Trigger), FALSE);
	Trigger := TRUE;
	MockupComponentTcEvent.Events.CyclicLogic();
	Actual := MockupComponentTcEvent.GetHighestActiveEventReaction();
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>