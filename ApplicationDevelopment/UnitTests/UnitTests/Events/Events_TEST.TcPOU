<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="Events_TEST" Id="{f8edee66-00b8-4c98-8cf2-362c013d99e2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Events_TEST
VAR
	CyclicComponent_Mockup : CyclicComponent_Mockup('UnitTest Component');
	MockupComponentTcEvent : MockupComponentTcEvent('UnitTest Component Events', CyclicComponent_Mockup);
	Trigger				   : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[MockupComponentTcEvent.SetEventReactions(10,
										 20,
										 30,
										 40,
										 50);

RaiseVerboseEventAndCheckReaction();
RaiseInfoEventAndCheckReaction();
RaiseWarningEventAndCheckReaction();
RaiseErrorEventAndCheckReaction();
RaiseCriticalEventAndCheckReaction();
ClearEvents();
SetEventAndRaise();
CheckIsResettable();
Reset();]]></ST>
    </Implementation>
    <Method Name="CheckIsResettable" Id="{f26b6b2d-26b1-45f3-9100-72231c18fec1}">
      <Declaration><![CDATA[METHOD CheckIsResettable
VAR_INST
	Expected : BOOL;
	Actual	 : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected := TRUE;
	Trigger := FALSE;
	MockupComponentTcEvent.Events.CyclicLogic();
	Actual := MockupComponentTcEvent.Events.IsResettable;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClearEvents" Id="{06240b37-aaab-4284-8b4e-34d450b8f712}">
      <Declaration><![CDATA[METHOD ClearEvents
VAR
	Expected : DINT;
	Actual	 : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected := 10;
	MockupComponentTcEvent.Reset();
	Actual := MockupComponentTcEvent.GetHighestActiveEventReaction();
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RaiseCriticalEventAndCheckReaction" Id="{78a88491-f562-44c7-a49c-d5ffc6669318}">
      <Declaration><![CDATA[METHOD RaiseCriticalEventAndCheckReaction
VAR
	Expected : DINT;
	Actual	 : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected := 50;
	MockupComponentTcEvent.RaiseTestEvent(TcEventSeverity.Critical);
	Actual := MockupComponentTcEvent.GetHighestActiveEventReaction();
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
