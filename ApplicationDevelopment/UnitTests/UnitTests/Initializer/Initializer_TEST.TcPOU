END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="CollectionRejectsRemoveWhenNotFound" Id="{82de7a12-e380-4f7f-b0f9-9985eb956640}">
      <Declaration><![CDATA[METHOD CollectionRejectsRemoveWhenNotFound
VAR
	Expected : BOOL := TRUE;
	Actual	 : BOOL;
	Initializer : Initializer<ApplicationBaseParameter.MaxCountInCollections>;
