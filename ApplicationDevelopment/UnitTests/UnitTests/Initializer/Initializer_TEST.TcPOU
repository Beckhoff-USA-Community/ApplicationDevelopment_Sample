END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Actual := Initializer.AddInitialize(16#0) = RegistrationResult.NullReference;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="CollectionRejectsAddingTooManyInits" Id="{2a55466b-d5e5-4d34-96a4-dffa630a70db}">
      <Declaration><![CDATA[METHOD CollectionRejectsAddingTooManyInits
VAR
	Expected : BOOL := TRUE;
	Actual	 : BOOL;
	Initializer : Initializer<1>;
	Init1	: InitializableComponent_Mockup(Name := 'Component 1');
	Init2	: InitializableComponent_Mockup(Name := 'Component 1');
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Initializer.AddInitialize(Init1);
	Actual := Initializer.AddInitialize(Init2) = RegistrationResult.TooManyComponents;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
