<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="Initializer_TEST" Id="{bcfb7350-00b9-40d8-88cb-39a7f2fd97a3}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Initializer_TEST
VAR
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CollectionAddsInitSucessfully();
CollectionRejectsAddingInitDuplicate();
CollectionRejectsAddingNullInit();
CollectionRejectsAddingTooManyInits();
CollectionRejectsRemoveWhenEmpty();
CollectionRejectsRemoveWhenNotFound();
CollectionRejectsRemovingNullInit();
CollectionRemovesInitSuccessfully();
FeedbackAllSubItemsInitializedFalse();
FeedbackAllSubItemsInitializedTrue();]]></ST>
    </Implementation>
    <Method Name="CollectionAddsInitSucessfully" Id="{97a68ef1-f4b7-4bd5-af79-b65d6765a214}">
      <Declaration><![CDATA[METHOD CollectionAddsInitSucessfully
VAR
	Expected	   : BOOL := TRUE;
	Actual		   : BOOL;
	CyclicRunner : CyclicRunner<ApplicationBaseParameter.MaxCountInCollections>;
	Cyclic	 : CyclicComponent_Mockup(Name := 'Cyclic 1');
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Actual := CyclicRunner.AddCallee(Cyclic) = RegistrationResult.Succeeded;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="CollectionRejectsAddingInitDuplicate" Id="{0486c3d6-f23d-48c3-ad65-520ba30ae566}">
      <Declaration><![CDATA[METHOD CollectionRejectsAddingInitDuplicate
VAR
	Expected : BOOL := TRUE;
	Actual	 : BOOL;
	Initializer : Initializer<ApplicationBaseParameter.MaxCountInCollections>;
	Init	: InitializableComponent_Mockup(Name := 'Component 1');
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Initializer.AddInitialize(Init);
	Actual := Initializer.AddInitialize(Init) = RegistrationResult.AlreadyAdded;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="CollectionRejectsAddingNullInit" Id="{9387e619-bd83-474a-9e0d-919fbec39a0d}">
      <Declaration><![CDATA[METHOD CollectionRejectsAddingNullInit
VAR
	Expected : BOOL := TRUE;
