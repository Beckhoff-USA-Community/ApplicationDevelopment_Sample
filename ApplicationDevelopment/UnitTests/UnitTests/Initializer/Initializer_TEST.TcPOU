    </Method>
    <Method Name="CollectionRemovesInitSuccessfully" Id="{426ee53c-1a02-4333-b8c8-d70e4d40d469}">
      <Declaration><![CDATA[METHOD CollectionRemovesInitSuccessfully
VAR
	Expected : BOOL := TRUE;
	Actual	 : BOOL;
	Initializer : Initializer<ApplicationBaseParameter.MaxCountInCollections>;
	Init	: InitializableComponent_Mockup(Name := 'Component 1');
	AddedCyclic : I_Initializable := Init;
	CollectionInit : I_Initializable;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Initializer.AddInitialize(Init);
	Actual := Initializer.RemoveInitialize(Init) = RegistrationResult.Succeeded;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FeedbackAllSubItemsInitializedFalse" Id="{d16733bb-4444-4e05-8113-aa0b3de4e340}">
      <Declaration><![CDATA[METHOD FeedbackAllSubItemsInitializedFalse
VAR_INST
	Expected : BOOL;
	Actual	 : BOOL;
END_VAR
VAR
	Initializer : Initializer<ApplicationBaseParameter.MaxCountInCollections>;
	Component1	: InitializableComponent_Mockup(Name := 'Component 1');
	Component2	: InitializableComponent_Mockup(Name := 'Component 1');
	Component3	: InitializableComponent_Mockup(Name := 'Component 1');
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected := TRUE;
	Initializer.AddInitialize(Component1);
	Initializer.AddInitialize(Component2);
	Initializer.AddInitialize(Component3);
	Initializer.Initializing();
	Actual := Component1.InitializeWasCalled AND Component2.InitializeWasCalled AND Component3.InitializeWasCalled AND NOT Initializer.Initialized;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="FeedbackAllSubItemsInitializedTrue" Id="{d1fefb95-ee37-4014-a523-ff9b40ccb173}">
      <Declaration><![CDATA[METHOD FeedbackAllSubItemsInitializedTrue
VAR_INST
	Expected : BOOL;
	Actual	 : BOOL;
END_VAR
VAR
	Initializer : Initializer<ApplicationBaseParameter.MaxCountInCollections>;
	Component1	: InitializableComponent_Mockup(Name := 'Component 1');
	Component2	: InitializableComponent_Mockup(Name := 'Component 1');
	Component3	: InitializableComponent_Mockup(Name := 'Component 1');
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected			   := TRUE;
	Initializer.AddInitialize(Component1);
	Initializer.AddInitialize(Component2);
	Initializer.AddInitialize(Component3);
	Component1.Initialized := TRUE;
	Component2.Initialized := TRUE;
	Component3.Initialized := TRUE;
	Initializer.Initializing();
	Actual := Component1.InitializeWasCalled AND Component2.InitializeWasCalled AND Component3.InitializeWasCalled AND Initializer.Initialized;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>