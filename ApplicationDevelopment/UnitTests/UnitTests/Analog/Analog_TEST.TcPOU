<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="Analog_TEST" Id="{5f77a4f3-171c-4fa8-ae40-6fe0c5502db9}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK Analog_TEST
VAR
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[AnalogInputReturnsCorrectValue();
AnalogInputReturnsRawValueCorrectly();
AnalogOutputGenericCheckValue();
AnalogOutputGenericCheckRawValue();
AnalogAcceptsForceOff();
AnalogAcceptsForceOn();
AnalogAcceptsForceValue();
AnalogGenericPassesDataInValidCorrectly();
AnalogGenericPassesDataValidCorrectly();
AnalogGenericPassesErrorCorrectly();
AnalogGenericPassesOverrangeCorrectly();
AnalogGenericPassesUnderrangeCorrectly();]]></ST>
    </Implementation>
    <Method Name="AnalogAcceptsForceOff" Id="{fa6591cc-dbbf-45e6-b271-6360f8ffb641}">
      <Declaration><![CDATA[METHOD AnalogAcceptsForceOff
VAR
	InputGeneric		 : INT;
	AnalogInput_Generic	 : AnalogInput('Input Generic', InputGeneric);
	Expected : INT;
	Actual	 : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected								   := 0;
	InputGeneric := 750;
	AnalogInput_Generic.ForceValue := 300;
	AnalogInput_Generic.Force := E_ForceState.ForceOff;
	Actual							:= AnalogInput_Generic.RawValue;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AnalogAcceptsForceOn" Id="{181b91c2-c25c-4c5f-ad49-4b1ad2d0f983}">
      <Declaration><![CDATA[METHOD AnalogAcceptsForceOn
VAR
	InputGeneric		 : INT;
	AnalogInput_Generic	 : AnalogInput('Input Generic', InputGeneric);
	Expected : INT;
	Actual	 : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected								   := 425;
	InputGeneric := 750;
	AnalogInput_Generic.ForceValue := Expected;
	AnalogInput_Generic.Force := E_ForceState.ForceOn;
	Actual							:= AnalogInput_Generic.RawValue;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AnalogAcceptsForceValue" Id="{ba787b26-9739-4654-a55a-28e43ff73736}">
      <Declaration><![CDATA[METHOD AnalogAcceptsForceValue
VAR
	InputGeneric		 : INT;
	AnalogInput_Generic	 : AnalogInput('Input Generic', InputGeneric);
	Expected : INT;
	Actual	 : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected								   := 750;
	AnalogInput_Generic.ForceValue := Expected;
	Actual							:= AnalogInput_Generic.ForceValue;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AnalogGenericPassesDataInValidCorrectly" Id="{7117b63b-b743-4bd9-ac8f-57ad179f73e5}">
      <Declaration><![CDATA[METHOD AnalogGenericPassesDataInValidCorrectly
VAR
	InputGeneric		 : INT;
	AnalogStatus : ST_AnalogInputStatus_Generic;
	AnalogInput_Generic	 : AnalogInput_Generic('Input Generic', InputGeneric, AnalogStatus );

	Expected : BOOL := TRUE;
	Actual	 : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	AnalogStatus.WcState := 0;
	Actual									   := AnalogInput_Generic.DataValid	;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AnalogGenericPassesDataValidCorrectly" Id="{ffd88dba-6109-4889-acf2-a0c2fcb55cf3}">
      <Declaration><![CDATA[METHOD AnalogGenericPassesDataValidCorrectly
VAR
	InputGeneric		 : INT;
	AnalogStatus : ST_AnalogInputStatus_Generic;
	AnalogInput_Generic	 : AnalogInput_Generic('Input Generic', InputGeneric, AnalogStatus );

	Expected : BOOL := FALSE;
	Actual	 : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	AnalogStatus.WcState := 1;
	Actual									   := AnalogInput_Generic.DataValid	;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AnalogGenericPassesErrorCorrectly" Id="{57946d52-ee5a-44aa-8d99-61f2a5c5eba2}">
      <Declaration><![CDATA[METHOD AnalogGenericPassesErrorCorrectly
VAR
	InputGeneric		 : INT;
	AnalogStatus : ST_AnalogInputStatus_Generic;
	AnalogInput_Generic	 : AnalogInput_Generic('Input Generic', InputGeneric, AnalogStatus );

	Expected : BOOL := TRUE;
	Actual	 : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	AnalogStatus.Error := 1;
	Actual									   := AnalogInput_Generic.Error	;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AnalogGenericPassesOverrangeCorrectly" Id="{ea55ab4a-3d82-401c-95d0-b5aee126b11f}">
      <Declaration><![CDATA[METHOD AnalogGenericPassesOverrangeCorrectly
VAR
	InputGeneric		 : INT;
	AnalogStatus : ST_AnalogInputStatus_Generic;
