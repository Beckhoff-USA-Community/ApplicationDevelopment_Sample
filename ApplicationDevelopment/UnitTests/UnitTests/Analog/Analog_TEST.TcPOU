      </Implementation>
    </Method>
    <Method Name="AnalogInputReturnsCorrectValue" Id="{3f16d67a-c36a-49a7-93d0-e31413d02005}">
      <Declaration><![CDATA[METHOD AnalogInputReturnsCorrectValue
VAR
	InputGeneric		 : INT;
	AnalogInput_Generic	 : AnalogInput('Input Generic', InputGeneric);

	Expected : LREAL;
	Actual	 : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	InputGeneric							   := 8192;
	Expected								   := 6.00015;
	AnalogInput_Generic.Scale.InputMaximum	   := 32767;
	AnalogInput_Generic.Scale.InputMinimum	   := 0.0;
	AnalogInput_Generic.Scale.OutputMaximum	   := 10;
	AnalogInput_Generic.Scale.OutputMinimum	   := 0.0;
	AnalogInput_Generic.CalibrateLinear.Gain   := 2;
	AnalogInput_Generic.CalibrateLinear.Offset := 1;
	Actual									   := floor(AnalogInput_Generic.Value * 100000) / 100000;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AnalogInputReturnsRawValueCorrectly" Id="{6939e3ef-e744-40bd-a80f-fc7d0491b60f}">
      <Declaration><![CDATA[METHOD AnalogInputReturnsRawValueCorrectly
VAR
	InputGeneric		 : INT;
	AnalogInput_Generic	 : AnalogInput('Input', InputGeneric);

	Expected : LREAL;
	Actual	 : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	InputGeneric							   := 750;
	Expected								   := 750;

	Actual									   := AnalogInput_Generic.RawValue;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AnalogOutputGenericCheckRawValue" Id="{ef6d5722-074d-488a-be3e-279c6473546a}">
      <Declaration><![CDATA[METHOD AnalogOutputGenericCheckRawValue
VAR
	Expected : LREAL;
	Actual	 : LREAL;
	OutputGeneric		 : INT;
	AnalogOutput_Generic : AnalogOutput('Output Generic', OutputGeneric);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	AnalogOutput_Generic.RawValue				:= 750;
	Expected									:= 750;
	AnalogOutput_Generic.Scale.InputMaximum		:= 10; // Process Value from plc e.g. liters
	AnalogOutput_Generic.Scale.InputMinimum		:= -10;
	AnalogOutput_Generic.Scale.OutputMaximum	:= 1000; // Output to terminal
	AnalogOutput_Generic.Scale.OutputMinimum	:= -1000;
	AnalogOutput_Generic.CalibrateLinear.Gain	:= 2;
	AnalogOutput_Generic.CalibrateLinear.Offset := 1;
	Actual										:= AnalogOutput_Generic.RawValue;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AnalogOutputGenericCheckValue" Id="{bcbdd86d-b9d5-4f63-a850-25ea80143a18}">
      <Declaration><![CDATA[METHOD AnalogOutputGenericCheckValue
VAR
	Expected : LREAL;
	Actual	 : LREAL;
	OutputGeneric		 : INT;
	AnalogOutput_Generic : AnalogOutput('Output Generic', OutputGeneric);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected									:= 750;
	AnalogOutput_Generic.Scale.InputMaximum		:= 10; // Process Value from plc e.g. liters
	AnalogOutput_Generic.Scale.InputMinimum		:= -10;
	AnalogOutput_Generic.Scale.OutputMaximum	:= 1000; // Output to terminal
	AnalogOutput_Generic.Scale.OutputMinimum	:= -1000;
	AnalogOutput_Generic.CalibrateLinear.Gain	:= 1;
	AnalogOutput_Generic.CalibrateLinear.Offset := 0;
	AnalogOutput_Generic.Value					:= 7.5;
	Actual										:= AnalogOutput_Generic.RawValue;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>