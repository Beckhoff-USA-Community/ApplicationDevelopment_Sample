END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	AnalogStatus.Overrange := 1;
	Actual									   := AnalogInput_Generic.Overrange	;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="AnalogGenericPassesUnderrangeCorrectly" Id="{ed99f059-37a2-4f4e-8229-7ea122bcd6c2}">
      <Declaration><![CDATA[METHOD AnalogGenericPassesUnderrangeCorrectly
VAR
	InputGeneric		 : INT;
	AnalogStatus : ST_AnalogInputStatus_Generic;
	AnalogInput_Generic	 : AnalogInput_Generic('Input Generic', InputGeneric, AnalogStatus );

	Expected : BOOL := TRUE;
	Actual	 : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	AnalogStatus.Underrrange := 1;
	Actual									   := AnalogInput_Generic.Underrange	;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
