    </Method>
    <Method Name="ByteConnectionResetsRxCommBuffer_Test" Id="{16a53eca-1d7a-4151-8014-7faa9b256ca6}">
      <Declaration><![CDATA[METHOD ByteConnectionResetsRxCommBuffer_Test : BOOL
VAR
	Expected : BOOL := TRUE;
	Actual	 : BOOL;
	seriallineCtrl : MockSerialLineCtrl;
	serialConnection : SerialByteConnection(Name := 'Channel 1',SerialLineController := seriallineCtrl);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	seriallineCtrl.SetComBufferByte(4);
	serialConnection.CyclicLogic();
	serialConnection.CyclicLogic();
	serialConnection.Reset();
	Actual := seriallineCtrl.rxBuffer.RdIdx = 0;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="StringConnectionAcceptsSendString_Test" Id="{9c1d98df-8ed7-4758-be86-e31811c326ff}">
      <Declaration><![CDATA[METHOD StringConnectionAcceptsSendString_Test : BOOL
VAR
	Expected : BOOL := TRUE;
	Actual	 : BOOL;
	seriallineCtrl : SerialLineControl_ADS;
	serialConnection : SerialStringConnection(Name := 'Channel 1',SerialLineController := seriallineCtrl);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Actual := SUCCEEDED(serialConnection.SendAString('Bob'));
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="StringConnectionAcceptsSerialLineSet_Test" Id="{580490a8-66e1-48e2-9d9a-c737a78bfb64}">
