      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Actual := serialConnection.SetDependencies(0);
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ByteConnectionRejectsResetWithNoLineCtrl_Test" Id="{b17f7843-41dc-4306-82c9-864be40fd714}">
      <Declaration><![CDATA[METHOD ByteConnectionRejectsResetWithNoLineCtrl_Test : BOOL
VAR
	Expected : BOOL := TRUE;
