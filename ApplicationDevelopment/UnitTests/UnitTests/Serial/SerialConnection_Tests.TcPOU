<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="SerialConnection_Tests" Id="{5fd39f02-9604-4c1d-ba31-123b8ae2764b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK SerialConnection_Tests
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[ByteConnectionAcceptsSendByte_Test();
StringConnectionAcceptsSendString_Test();
ByteConnectionRejectsSendByteWithNoLineCtrl_Test();
StringConnectionRejectsSendStringWithNoLineCtrl_Test();
ByteConnectionAcceptsSerialLineSet_Test();
ByteConnectionRejectsNulSerialLineSet_Test();
StringConnectionAcceptsSerialLineSet_Test();
StringConnectionRejectsNulSerialLineSet_Test();
ByteConnectionFlagsRecievedByte_Test();
ByteConnectionRecievesByteCorrectly_Test();
StringConnectionFlagsRecievedString_Test();
StringConnectionRecievesStringCorrectly_Test();
ByteConnectionRejectsResetWithNoLineCtrl_Test();
ByteConnectionResetsRxCommBuffer_Test();
StringConnectionRejectsResetWithNoLineCtrl_Test();
StringConnectionResetsRxCommBuffer_Test();]]></ST>
    </Implementation>
    <Method Name="ByteConnectionAcceptsSendByte_Test" Id="{72c9300e-9212-4ed2-84a6-6866b6333beb}">
      <Declaration><![CDATA[METHOD ByteConnectionAcceptsSendByte_Test : BOOL
VAR
	Expected : BOOL := TRUE;
	Actual	 : BOOL;
	seriallineCtrl : SerialLineControl_ADS;
	serialConnection : SerialByteConnection(Name := 'Channel 1',SerialLineController := seriallineCtrl);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Actual := SUCCEEDED(serialConnection.SendAByte(1));
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ByteConnectionAcceptsSerialLineSet_Test" Id="{d43c4ae1-4bfb-43ea-a3b9-7acc1215265b}">
      <Declaration><![CDATA[METHOD ByteConnectionAcceptsSerialLineSet_Test : BOOL
VAR
	Expected : BOOL := TRUE;
	Actual	 : BOOL;
	seriallineCtrl : SerialLineControl_ADS;
	serialConnection : SerialByteConnection(Name := 'Channel 1',SerialLineController := 0);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Actual := serialConnection.SetDependencies(seriallineCtrl);
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ByteConnectionFlagsRecievedByte_Test" Id="{bb04914d-f46b-4668-8a0a-f3913b782ea9}">
      <Declaration><![CDATA[METHOD ByteConnectionFlagsRecievedByte_Test : BOOL
VAR
	Expected : BOOL := TRUE;
	Actual	 : BOOL;
	seriallineCtrl : MockSerialLineCtrl;
	serialConnection : SerialByteConnection(Name := 'Channel 1',SerialLineController := seriallineCtrl);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	seriallineCtrl.SetComBufferByte(4);
	serialConnection.CyclicLogic();
	serialConnection.CyclicLogic();
	Actual := serialConnection.ByteDataRecieved;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ByteConnectionRecievesByteCorrectly_Test" Id="{c7081a92-504f-4749-887e-46b0ec6809af}">
      <Declaration><![CDATA[METHOD ByteConnectionRecievesByteCorrectly_Test : BOOL
VAR
	Expected : BOOL := TRUE;
	Actual	 : BOOL;
	seriallineCtrl : MockSerialLineCtrl;
	serialConnection : SerialByteConnection(Name := 'Channel 1',SerialLineController := seriallineCtrl);
	TestByte : BYTE := 4;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	seriallineCtrl.SetComBufferByte(TestByte);
	serialConnection.CyclicLogic();
	serialConnection.CyclicLogic();
	IF serialConnection.ByteDataRecieved THEN
		Actual := serialConnection.ByteData = TestByte;
	END_IF
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
