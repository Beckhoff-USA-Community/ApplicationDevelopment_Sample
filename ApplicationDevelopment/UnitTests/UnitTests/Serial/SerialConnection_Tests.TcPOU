    <Method Name="StringConnectionFlagsRecievedString_Test" Id="{3d21da3d-ec7d-457d-a621-49c592c5292d}">
      <Declaration><![CDATA[METHOD StringConnectionFlagsRecievedString_Test : BOOL
VAR
	Expected : BOOL := TRUE;
	Actual	 : BOOL;
	seriallineCtrl : MockSerialLineCtrl;
	serialConnection : SerialStringConnection(Name := 'Channel 1',SerialLineController := seriallineCtrl);
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	seriallineCtrl.SetComBufferString('$02 I Love Chips $03',20);
	serialConnection.SetSerialConfiguration('$02','$03');
	serialConnection.CyclicLogic();
	serialConnection.CyclicLogic();
	serialConnection.CyclicLogic();
	Actual := serialConnection.StringRecieved;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="StringConnectionRecievesStringCorrectly_Test" Id="{95ea016e-ca98-4353-b969-0cccdfcd63f0}">
      <Declaration><![CDATA[METHOD StringConnectionRecievesStringCorrectly_Test : BOOL
VAR
	Expected : BOOL := TRUE;
	Actual	 : BOOL;
	seriallineCtrl : MockSerialLineCtrl;
	serialConnection : SerialStringConnection(Name := 'Channel 1',SerialLineController := seriallineCtrl);
	testString : T_MaxString := '$02 I Love Chips $03';
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	seriallineCtrl.SetComBufferString('$02 I Love Chips $03',20);
	serialConnection.SetSerialConfiguration('$02','$03');
	serialConnection.CyclicLogic();
	serialConnection.CyclicLogic();
	serialConnection.CyclicLogic();
	IF serialConnection.StringRecieved THEN
		Actual := serialConnection.StringData = testString;
	END_IF
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
