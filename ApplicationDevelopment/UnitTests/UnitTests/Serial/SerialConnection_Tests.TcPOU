END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="ByteConnectionRejectsSendByteWithNoLineCtrl_Test" Id="{7c8edc6b-b442-42ac-b718-f47eff76c854}">
      <Declaration><![CDATA[METHOD ByteConnectionRejectsSendByteWithNoLineCtrl_Test : BOOL
VAR
	Expected : BOOL := TRUE;
	Actual	 : BOOL;
	serialConnection : SerialByteConnection(Name := 'Channel 1',SerialLineController := 0);
END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
