    </Method>
    <Method Name="EnumeratorReset" Id="{fc619f8f-10a0-4c59-9904-b8e774c745cf}">
      <Declaration><![CDATA[METHOD EnumeratorReset
VAR
	Expected   : BOOL;
	Actual	   : BOOL;
	Response   : BOOL;
	TargetItem : I_Base;
	ActualItem : I_Base;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected   := TRUE;
	TargetItem := Item1;
	Collection.ResetIterator();
	Response   := Collection.MoveToNext;
	ActualItem := Collection.Current;
	Actual	   := (ActualItem = TargetItem) AND Response;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetFirstItemById" Id="{2e97e8d9-60c6-4662-8b14-4ea202e64cdd}">
      <Declaration><![CDATA[METHOD GetFirstItemById
VAR_INST
	Expected   : BOOL;
	Actual	   : BOOL;
	TargetItem : I_Base;
	ActualItem : I_Base;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected   := TRUE;
	TargetItem := Item1;
	ActualItem := Collection.GetItemByIndex(0);
	Actual	   := (TargetItem = ActualItem);
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetSecondItemById" Id="{3a003730-da3a-48d6-8420-78c72cade715}">
      <Declaration><![CDATA[METHOD GetSecondItemById
VAR_INST
	Expected   : BOOL;
	Actual	   : BOOL;
	TargetItem : I_Base;
	ActualItem : I_Base;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected   := TRUE;
	TargetItem := Item2;
	ActualItem := Collection.GetItemByIndex(1);
	Actual	   := (TargetItem = ActualItem);
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RemoveFirstItem" Id="{27a3c331-1beb-4f23-9e74-fee80f2fd072}">
      <Declaration><![CDATA[METHOD RemoveFirstItem
VAR_INST
	Expected   : BOOL;
	Actual	   : BOOL;
	TargetItem : I_Base;
	ActualItem : I_Base;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected   := TRUE;
	TargetItem := Item2;
	Collection.RemoveItem(Item1);
	ActualItem := Collection.GetItemByIndex(0);
	Actual	   := (TargetItem = ActualItem) AND (Collection.Count = 1);
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RemoveLastItem" Id="{7ba4a2b0-3623-4b6e-8afa-5bf0d7cd476c}">
      <Declaration><![CDATA[METHOD RemoveLastItem
VAR_INST
	Expected   : BOOL;
	Actual	   : BOOL;
	TargetItem : I_Base;
	ActualItem : I_Base;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected   := TRUE;
	TargetItem := 0;
	Collection.RemoveItem(Item3);
	ActualItem := Collection.GetItemByIndex(2);
	Actual	   := (TargetItem = ActualItem) AND (Collection.Count = 2);
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RemoveToEmpty" Id="{88d5c6b5-2a50-4a6d-a786-ec13b5e40973}">
      <Declaration><![CDATA[METHOD RemoveToEmpty
VAR_INST
	Expected : UDINT;
	Actual	 : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF TestSuite.Test(__POUNAME()).ExecuteTest() THEN
	Expected := 0;
	Collection.RemoveItem(Item2);
	Actual := Collection.Count;
	TestSuite.Test(__POUNAME()).AssertEqual(Expected, Actual);
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>